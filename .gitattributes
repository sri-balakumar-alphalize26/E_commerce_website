# Normalise line endings in the repository.
#
# Without this, checking out on Windows converts LF to CRLF and every file
# reads as modified on the next machine that touches it -- which matters more
# than usual here, because this repo has two remotes on two accounts and the
# diffs need to stay comparable between them.
#
# `text=auto` stores LF in git and leaves the working copy to the platform.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.woff2 binary
*.ico binary
