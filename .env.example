# Copy to .env.local (not committed) and restart the site after changing it.
# The Odoo that has the mart369_* modules installed. Server-side only.
ODOO_URL=http://localhost:8069
# Database on that Odoo to show in the shop. Leave empty to let Odoo pick (single-DB or --db-filter).
ODOO_DB=sparenix_test
# Google Maps for the live tracking map - not wired yet. The map is
# OpenStreetMap until this exists; components/home/mapProvider.js is the one
# place to switch. Public (it reaches the browser), so restrict it by referrer.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
