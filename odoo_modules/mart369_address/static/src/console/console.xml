<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mart369_address.Console">
    <Layout className="'o_mart_console'" display="{ controlPanel: {} }">
        <t t-set-slot="layout-buttons">
            <button class="btn btn-secondary" t-on-click="() => this.exportCsv()">
                <i class="fa fa-download me-1"/>Export
            </button>
        </t>

        <div class="o_mart_wrap">
            <div class="o_mart_bar">
                <div class="o_mart_search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Search name, email, mobile or city…"
                           t-model="state.search"/>
                </div>
                <div class="o_mart_chips">
                    <button t-foreach="filters" t-as="f" t-key="f.key"
                            class="o_mart_chip"
                            t-att-class="{ 'o_mart_on': state.filter === f.key }"
                            t-on-click="() => this.setFilter(f.key)">
                        <t t-esc="f.label"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="o_mart_empty">Loading…</div>

            <div t-elif="!rows.length" class="o_mart_empty">
                <h3>Nothing to show</h3>
                <p t-if="state.search or state.filter !== 'all'">
                    No customer matches that search or filter.
                </p>
                <p t-else="">
                    No one has signed up in the app yet. Customers appear here as soon
                    as they create an account.
                </p>
            </div>

            <table t-else="" class="o_mart_table">
                <thead>
                    <tr>
                        <th class="o_mart_caret"/>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th class="text-center">Addresses</th>
                        <th>Default address</th>
                        <th>Signed up</th>
                        <th>Last seen</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="rows" t-as="c" t-key="c.id">
                        <tr class="o_mart_row" t-on-click="() => this.toggle(c.id)">
                            <td class="o_mart_caret">
                                <i class="fa" t-att-class="state.open[c.id] ? 'fa-caret-down' : 'fa-caret-right'"
                                   t-if="c.count"/>
                            </td>
                            <td>
                                <span class="o_mart_avatar"><t t-esc="c.initials"/></span>
                                <a class="o_mart_name" t-on-click.stop="() => this.openCustomer(c)">
                                    <t t-esc="c.name"/>
                                </a>
                            </td>
                            <td class="text-muted"><t t-esc="c.login"/></td>
                            <td class="o_mart_mono">
                                <t t-if="c.phone"><t t-esc="c.phone"/></t>
                                <span t-else="" class="o_mart_warn" title="This customer has no mobile number">
                                    <i class="fa fa-circle"/> missing
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="o_mart_pill" t-att-class="c.count ? 'o_mart_pill_on' : ''">
                                    <t t-esc="c.count"/>
                                </span>
                            </td>
                            <td>
                                <t t-if="c.default">
                                    <i class="fa fa-check o_mart_tick"/>
                                    <t t-esc="c.default.street"/>,
                                    <t t-esc="c.default.cityLine"/>
                                </t>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-muted"><t t-esc="c.joined"/></td>
                            <td class="text-muted"><t t-esc="c.seen"/></td>
                            <td>
                                <span class="o_mart_status" t-att-class="c.active ? 'o_mart_active' : ''">
                                    <t t-esc="c.active ? 'Active' : 'Archived'"/>
                                </span>
                            </td>
                        </tr>

                        <tr t-if="state.open[c.id]" class="o_mart_sub">
                            <td/>
                            <td colspan="8">
                                <div t-foreach="c.addresses" t-as="a" t-key="a.id" class="o_mart_addr">
                                    <div class="o_mart_addr_head">
                                        <span class="o_mart_chip_label" t-att-class="labelClass(a)">
                                            <t t-esc="a.mart369_label or 'Home'"/>
                                        </span>
                                        <a class="o_mart_addr_name" t-on-click="() => this.openAddress(a)">
                                            <t t-esc="a.name"/>
                                        </a>
                                        <span class="o_mart_mono text-muted" t-if="a.phone">
                                            · <t t-esc="a.phone"/>
                                        </span>
                                        <span class="o_mart_mono text-muted" t-if="a.mart369_alt_phone">
                                            / <t t-esc="a.mart369_alt_phone"/>
                                        </span>
                                        <span t-if="a.mart369_default" class="o_mart_default">
                                            <i class="fa fa-check"/> Default
                                        </span>
                                        <button t-else="" class="o_mart_make btn btn-sm"
                                                t-on-click.stop="() => this.makeDefault(a)">
                                            Make default
                                        </button>
                                    </div>
                                    <div class="o_mart_addr_body">
                                        <t t-esc="a.street"/>
                                        <span t-if="a.street2">, <t t-esc="a.street2"/></span>
                                        <span t-if="a.cityLine"> · <t t-esc="a.cityLine"/></span>
                                        <span t-if="a.state_id"> , <t t-esc="a.state_id[1]"/></span>
                                    </div>
                                    <div t-if="a.gaps.length" class="o_mart_gaps"
                                         t-att-title="'Incomplete: ' + a.gaps.join(', ')">
                                        <i class="fa fa-circle"/>
                                        <t t-esc="a.gaps.join(', ')"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </Layout>
</t>

</templates>
