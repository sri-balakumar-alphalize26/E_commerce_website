<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Support sits next to Orders and Returns, because it is the third thing
        somebody works through during a day rather than sets up once.
    -->

    <!--
        Support opens the desk; the kanban keeps what the desk does not try to
        do - grouping, the form and the chatter. Same split as Orders, Returns
        and Reviews.
    -->
    <menuitem id="menu_mart369_support"
              name="Support"
              parent="mart369.menu_mart369_root"
              action="action_mart369_support_desk"
              groups="sales_team.group_sale_salesman"
              sequence="7"/>

    <menuitem id="menu_mart369_support_all"
              name="Support (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_tickets"
              groups="sales_team.group_sale_salesman"
              sequence="7"/>

    <!--
        Bot answers opens the desk; the editable list keeps bulk work and
        exporting.

        `sales_team.group_sale_salesman`, not `base.group_system`: the ACL has
        always granted salesmen read, write and create on a bot answer, so the
        menu was stricter than the rule behind it - somebody allowed to change
        what the shop says could not find the screen.
    -->
    <menuitem id="menu_mart369_bot_rules"
              name="Bot answers"
              parent="mart369.menu_mart369_root"
              action="action_mart369_bot_desk"
              groups="sales_team.group_sale_salesman"
              sequence="29"/>

    <menuitem id="menu_mart369_bot_rules_all"
              name="Bot answers (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_rules"
              groups="sales_team.group_sale_salesman"
              sequence="29"/>

</odoo>
