<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_support.BotDesk">
        <Layout display="{ controlPanel: {} }" className="'o_mart369_desk h-100'">
            <div class="mart-builder pe bt">

                <header class="pe-head">
                    <div>
                        <h1>Bot answers</h1>
                        <p>What the shop says before a person sees them, in the order it tries them.</p>
                    </div>
                    <div class="bt-head-act">
                        <button class="mart-btn mart-btn-primary"
                                t-on-click="() => this.write(false)">
                            <Icon n="'plus'" size="14"/>
                            New answer
                        </button>
                        <button class="mart-btn" t-on-click="() => this.moreViews()">
                            <Icon n="'menu'" size="14"/>
                            All views
                        </button>
                    </div>
                </header>

                <div class="bt-tiles">
                    <t t-foreach="TILES" t-as="tile" t-key="tile.key">
                        <div t-if="tile.flat"
                             t-attf-class="bt-tile bt-tile-flat {{ tile.bad and tileValue(tile) ? 'bt-tile-bad' : '' }}">
                            <span class="bt-tile-top">
                                <Icon n="tile.icon" size="15"/>
                                <t t-esc="tile.label"/>
                            </span>
                            <b t-esc="tileValue(tile)"/>
                            <small>Pattern will not compile</small>
                        </div>
                        <button t-else=""
                                type="button"
                                t-attf-class="bt-tile {{ state.tab === tile.tab ? 'bt-tile-on' : '' }}"
                                t-att-aria-pressed="state.tab === tile.tab ? 'true' : 'false'"
                                t-on-click="() => this.pick(tile.tab)">
                            <span class="bt-tile-top">
                                <Icon n="tile.icon" size="15"/>
                                <t t-esc="tile.label"/>
                            </span>
                            <b t-esc="tileValue(tile)"/>
                            <small>Show these</small>
                        </button>
                    </t>
                </div>

                <div class="pe-toolbar bt-toolbar">
                    <Tabs tabs="tabItems" value="state.tab"
                          onChange="(k) => this.pick(k)"/>
                    <div class="pe-toolbar-gap"/>
                    <Search value="state.q" placeholder="'Name, pattern or words'" label="'Search answers'"
                            onChange="(v) => this.onSearch(v)"/>
                </div>

                <p t-if="state.error" class="pe-error" role="alert">
                    We could not reach the shop. <t t-esc="state.error"/>
                    <button class="mart-link" t-on-click="() => this.load()">Try again</button>
                </p>

                <div class="bt-queue-wrap">
                    <div class="bt-queue">

                        <p t-if="state.loading and !state.rows.length" class="pe-loading">
                            Loading answers...
                        </p>

                        <p t-elif="!state.rows.length" class="pe-loading">
                            No answer here. Try another tile, or a different search.
                        </p>

                        <t t-else="">
                            <p class="bt-count">
                                <t t-esc="state.total"/> answer<t t-if="state.total !== 1">s</t>
                                <span t-if="!canReorder" class="bt-note">
                                    Open All with the search cleared to change which one is tried first.
                                </span>
                            </p>
                            <ul class="bt-rows">
                                <li t-foreach="state.rows" t-as="row" t-key="row.id"
                                    t-attf-class="bt-row {{ row.active ? '' : 'bt-row-off' }}">
                                    <span class="bt-line1">
                                        <b class="bt-title" t-esc="row.title"/>
                                        <Pill s="row.active ? 'on' : 'off'" map="TONES"/>
                                        <span class="bt-kind" t-esc="row.kindLabel"/>
                                    </span>
                                    <code class="bt-pattern" t-esc="row.pattern"/>
                                    <p class="bt-reply" t-if="row.reply" t-esc="row.reply"/>
                                    <p class="bt-reply bt-computed" t-else="">
                                        Worked out from their own orders.
                                    </p>
                                    <span class="bt-line2">
                                        <span class="bt-act">
                                            <t t-if="canReorder">
                                                <button class="mart-btn mart-btn-sm"
                                                        t-att-disabled="state.busy or row_index === 0"
                                                        aria-label="Try this earlier"
                                                        t-on-click="() => this.move(row_index, -1)">
                                                    <Icon n="'up'" size="14"/>
                                                </button>
                                                <button class="mart-btn mart-btn-sm"
                                                        t-att-disabled="state.busy or row_index === state.rows.length - 1"
                                                        aria-label="Try this later"
                                                        t-on-click="() => this.move(row_index, 1)">
                                                    <Icon n="'down'" size="14"/>
                                                </button>
                                            </t>
                                            <button class="mart-btn mart-btn-sm"
                                                    t-att-disabled="state.busy"
                                                    t-on-click="() => this.write(row)">Edit</button>
                                            <button t-if="row.active"
                                                    class="mart-btn mart-btn-sm"
                                                    t-att-disabled="state.busy"
                                                    t-on-click="() => this.askSwitchOff(row)">Switch off</button>
                                            <button t-else=""
                                                    class="mart-btn mart-btn-sm"
                                                    t-att-disabled="state.busy"
                                                    t-on-click="() => this.putBack(row)">Put back</button>
                                        </span>
                                    </span>
                                </li>
                            </ul>

                            <div t-if="state.rows.length &lt; state.total" class="bt-more">
                                <button class="mart-btn" t-on-click="() => this.showMore()">
                                    Show more (<t t-esc="state.total - state.rows.length"/> left)
                                </button>
                            </div>
                        </t>

                    </div>
                </div>

            </div>
        </Layout>
    </t>

    <t t-name="mart369_support.AnswerDialog">
        <!-- `contentClass`, because a Dialog renders in a portal outside the
             desk wrapper: styles scoped under `.o_mart369_desk` never reach in
             here, and the footer slot is outside this div as well. -->
        <Dialog size="'lg'" title="title" contentClass="'o_mart369_dialog bt'">
            <div class="mart-builder bt bt-dialog">

                <p t-if="state.error" class="pe-error" role="alert" t-esc="state.error"/>

                <label class="bt-field">
                    <span>What it covers</span>
                    <input type="text" t-model="state.form.title"
                           placeholder="Opening hours"/>
                </label>

                <label class="bt-field">
                    <span>Matches</span>
                    <input type="text" t-model="state.form.pattern"
                           placeholder="\b(open|hours|timing)\b"/>
                </label>
                <p class="mart-hint">
                    A pattern, not a phrase. The bot tries these in order and
                    stops at the first one that matches.
                </p>

                <label class="bt-field">
                    <span>Kind</span>
                    <Pick label="'Kind'" value="state.form.kind" options="kindOptions"
                          onChange="(v) => this.setKind(v)"/>
                </label>

                <label class="bt-field">
                    <span t-if="saysTheWords">Says</span>
                    <span t-else="">Says if the shop has nothing to tell them</span>
                    <textarea rows="3" t-model="state.form.reply"
                              placeholder="We are open 7am to 11pm, every day."/>
                </label>
                <p t-if="!saysTheWords" class="mart-hint">
                    This kind works the answer out from the customer own orders,
                    wallet or coupons. The words above are only used when there
                    is nothing to tell them.
                </p>

                <label class="bt-field">
                    <span>Suggestions under it</span>
                    <input type="text" t-model="state.form.chips"
                           placeholder="Talk to an agent, See offers"/>
                </label>

                <div class="bt-two">
                    <label class="bt-field">
                        <span>Button says</span>
                        <input type="text" t-model="state.form.action_label"
                               placeholder="Open 369 Wallet"/>
                    </label>
                    <label class="bt-field">
                        <span>Opens</span>
                        <input type="text" t-model="state.form.action_view"
                               placeholder="account"/>
                    </label>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy"
                        t-on-click="() => this.save()">Save</button>
                <button class="mart-btn" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
