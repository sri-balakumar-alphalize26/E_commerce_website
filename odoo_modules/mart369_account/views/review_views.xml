<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Reviews are read, not worked: an operator scans them for the unhappy
        ones. So the list is the default here, unlike Orders where the board is.
    -->
    <record id="view_mart369_review_list" model="ir.ui.view">
        <field name="name">mart369.review.list</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <list js_class="mart369_reviews_list" class="o_mart369_list" create="false"
                  default_order="create_date desc"
                  decoration-danger="rating &lt;= 2" decoration-muted="not consumed">
                <field name="create_date" string="Written"/>
                <field name="partner_id" string="Customer"/>
                <field name="res_name" string="Product"/>
                <field name="rating" string="Stars" digits="[2,0]"/>
                <field name="mart369_title" string="Headline" optional="show"/>
                <field name="feedback" string="Review"/>
                <field name="mart369_tags" string="Tags" optional="hide"/>
                <field name="mart369_photos" string="Photos" optional="hide"/>
                <field name="mart369_verified" string="Verified" optional="show" widget="boolean_toggle" readonly="1"/>
                <field name="mart369_state" string="Shown" widget="badge"
                       decoration-success="mart369_state == 'published'"
                       decoration-warning="mart369_state == 'pending'"
                       decoration-danger="mart369_state == 'hidden'"/>
                <field name="consumed" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_mart369_review_form" model="ir.ui.view">
        <field name="name">mart369.review.form</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <form class="o_mart369_form" create="false">
                <sheet>
                    <div class="o_mart369_hero">
                        <div class="o_mart369_hero_txt">
                            <h1><field name="mart369_title" readonly="1" placeholder="No headline"/></h1>
                            <div class="o_mart369_hero_meta">
                                <field name="partner_id" readonly="1"/>
                                <span class="o_mart369_hero_badge" invisible="not mart369_verified">Verified purchase</span>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="res_name" string="Product" readonly="1"/>
                            <field name="rating" string="Stars" digits="[2,0]" readonly="1"/>
                            <field name="create_date" string="Written" readonly="1"/>
                        </group>
                        <group>
                            <field name="mart369_tags" string="Tags" readonly="1"/>
                            <field name="mart369_photos" string="Photos" readonly="1"/>
                            <field name="mart369_helpful" string="Found helpful"/>
                            <!-- The one field on this form staff may change.
                                 Everything else is the customer's. -->
                            <field name="mart369_state" string="Shown"/>
                        </group>
                    </group>
                    <group string="What they said">
                        <field name="feedback" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mart369_review_search" model="ir.ui.view">
        <field name="name">mart369.review.search</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="res_name" string="Product"/>
                <field name="feedback"/>
                <!-- Named filters, because the KPI tiles switch them on by name. -->
                <filter name="unhappy" string="Unhappy" domain="[('rating', '&lt;=', 2)]"/>
                <filter name="happy" string="Happy" domain="[('rating', '&gt;=', 4)]"/>
                <separator/>
                <filter name="pending" string="Waiting" domain="[('mart369_state', '=', 'pending')]"/>
                <filter name="published" string="Published" domain="[('mart369_state', '=', 'published')]"/>
                <filter name="hidden" string="Hidden" domain="[('mart369_state', '=', 'hidden')]"/>
                <separator/>
                <filter name="verified" string="Verified purchase" domain="[('mart369_verified', '=', True)]"/>
                <filter name="with_photos" string="With photos" domain="[('mart369_photos', '&gt;', 0)]"/>
                <separator/>
                <filter name="recent" string="Last 30 days"
                        domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'res_name'}"/>
                    <filter name="group_stars" string="Stars" context="{'group_by': 'rating'}"/>
                    <filter name="group_state" string="Shown" context="{'group_by': 'mart369_state'}"/>
                    <filter name="group_day" string="Written on" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mart369_reviews" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mart369_review_search"/>
        <field name="domain">[('res_model', '=', 'product.template'), ('consumed', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reviews yet</p>
            <p>When a customer reviews something they bought, it appears here.</p>
        </field>
    </record>

    <!--
        Without these, an act_window on rating.rating silently uses Odoo's own
        views instead of the ones above.
    -->
    <record id="action_mart369_reviews_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_mart369_review_list"/>
        <field name="act_window_id" ref="action_mart369_reviews"/>
    </record>

    <record id="action_mart369_reviews_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mart369_review_form"/>
        <field name="act_window_id" ref="action_mart369_reviews"/>
    </record>

</odoo>
