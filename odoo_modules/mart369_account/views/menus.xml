<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Orders 5, Returns 6, Home Page 10, Product Page 15, Customers 20,
        Addresses 30, Payments 40. These three sit after Customers, because they
        are all about one customer rather than about a day's work.
    -->

    <!--
        Reviews opens the desk, and the list keeps what the desk does not try
        to do - grouping, the form, the sparkline strip and exporting. Same
        split as Orders and Returns in mart369_order.
    -->
    <menuitem id="menu_mart369_reviews"
              name="Reviews"
              parent="mart369.menu_mart369_sales"
              action="action_mart369_review_desk"
              groups="sales_team.group_sale_salesman"
              sequence="50"/>

    <menuitem id="menu_mart369_reviews_all"
              name="Reviews (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_reviews"
              groups="sales_team.group_sale_salesman"
              sequence="22"/>

    <!--
        Referrals opens the desk, and the kanban and list keep what the desk
        does not try to do - grouping, the form and exporting. Same split as
        Reviews above.
    -->
    <menuitem id="menu_mart369_referrals"
              name="Referrals"
              parent="mart369.menu_mart369_sales"
              action="action_mart369_referral_desk"
              groups="sales_team.group_sale_salesman"
              sequence="60"/>

    <menuitem id="menu_mart369_referrals_all"
              name="Referrals (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_referrals"
              groups="sales_team.group_sale_salesman"
              sequence="24"/>

    <!--
        Rewards opens the desk; the list keeps what the desk does not do -
        grouping, the form, the sparkline strip and exporting. Same split as
        Orders, Returns, Reviews and Support.
    -->
    <menuitem id="menu_mart369_rewards"
              name="Rewards"
              parent="mart369.menu_mart369_sales"
              action="action_mart369_reward_desk"
              groups="sales_team.group_sale_salesman"
              sequence="70"/>

    <menuitem id="menu_mart369_rewards_all"
              name="Rewards (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_rewards"
              groups="sales_team.group_sale_salesman"
              sequence="26"/>

    <!--
        Notifications opens the desk; the list keeps what the desk does not do.

        `sales_team.group_sale_salesman`, not `base.group_system`: the ACL has
        always granted salesmen read, write and create on a notice, so the
        menu was stricter than the rule behind it and the people who write the
        words could not reach the screen.
    -->
    <menuitem id="menu_mart369_notices"
              name="Notifications"
              parent="mart369.menu_mart369_store"
              action="action_mart369_notice_desk"
              groups="sales_team.group_sale_salesman"
              sequence="30"/>

    <menuitem id="menu_mart369_notices_all"
              name="Notifications (all views)"
              parent="mart369.menu_mart369_advanced"
              action="action_mart369_notices"
              groups="sales_team.group_sale_salesman"
              sequence="28"/>

</odoo>
