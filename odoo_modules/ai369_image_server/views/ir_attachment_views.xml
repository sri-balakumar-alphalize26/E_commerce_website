<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_attachment_imgsrv_list" model="ir.ui.view">
        <field name="name">ir.attachment.imgsrv.list</field>
        <field name="model">ir.attachment</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="imgsrv_state == 'remote'"
                  decoration-warning="imgsrv_state == 'pending'" decoration-danger="imgsrv_state == 'error'">
                <field name="res_model" string="Model"/>
                <field name="res_id" string="Record ID" optional="hide"/>
                <field name="res_field" string="Field"/>
                <field name="file_size"/>
                <field name="imgsrv_state"/>
                <field name="imgsrv_url" widget="url"/>
                <field name="imgsrv_error" optional="show"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ir_attachment_imgsrv_search" model="ir.ui.view">
        <field name="name">ir.attachment.imgsrv.search</field>
        <field name="model">ir.attachment</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_model" string="Model"/>
                <field name="res_field" string="Field"/>
                <field name="imgsrv_url"/>
                <filter name="remote" string="On image server" domain="[('imgsrv_state', '=', 'remote')]"/>
                <filter name="pending" string="Waiting to upload" domain="[('imgsrv_state', '=', 'pending')]"/>
                <filter name="error" string="Failed" domain="[('imgsrv_state', '=', 'error')]"/>
                <filter name="local" string="Still in ERP" domain="[('imgsrv_state', '!=', 'remote')]"/>
                <group>
                    <filter name="by_model" string="Model" context="{'group_by': 'res_model'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'imgsrv_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_imgsrv_files" model="ir.actions.act_window">
        <field name="name">Image Files</field>
        <field name="path">image-server-files</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="ir_attachment_imgsrv_list"/>
        <field name="search_view_id" ref="ir_attachment_imgsrv_search"/>
        <field name="domain">[('res_field', '!=', False), ('imgsrv_state', '!=', False)]</field>
        <field name="context">{'search_default_by_model': 1}</field>
    </record>
</odoo>
