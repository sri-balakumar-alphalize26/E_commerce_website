<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_imgsrv" model="ir.ui.view">
        <field name="name">product.template.form.imgsrv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Image Server" name="imgsrv" groups="base.group_user">
                    <group>
                        <group>
                            <field name="imgsrv_status" widget="badge" decoration-success="imgsrv_status == 'remote'"
                                   decoration-warning="imgsrv_status in ('pending', 'local')" decoration-danger="imgsrv_status == 'error'"/>
                            <field name="imgsrv_folder" invisible="not imgsrv_folder"/>
                            <field name="imgsrv_error" invisible="not imgsrv_error"/>
                        </group>
                        <group>
                            <field name="imgsrv_image_url" widget="CopyClipboardChar" invisible="not imgsrv_image_url"/>
                            <field name="imgsrv_thumb_url" widget="CopyClipboardChar" invisible="not imgsrv_thumb_url"/>
                        </group>
                    </group>
                    <group invisible="not imgsrv_gallery_urls">
                        <field name="imgsrv_gallery_urls" string="Extra images" readonly="1"/>
                    </group>
                    <div class="mt-2">
                        <button name="action_imgsrv_send" type="object" string="Send to image server" icon="fa-cloud-upload"
                                class="btn-secondary" invisible="imgsrv_status in ('none', 'remote')"/>
                        <button name="action_imgsrv_pull" type="object" string="Load image from server" icon="fa-cloud-download"
                                class="btn-secondary ms-2"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_server_imgsrv_send" model="ir.actions.server">
        <field name="name">Image Server: send images</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">action = records.action_imgsrv_send()</field>
    </record>
    <record id="action_server_imgsrv_pull" model="ir.actions.server">
        <field name="name">Image Server: load images from server</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="code">action = records.action_imgsrv_pull()</field>
    </record>
</odoo>
