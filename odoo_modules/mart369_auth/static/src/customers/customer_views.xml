<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_auth.CustomerListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <Mart369CustomerDashboard list="props.list"/>
        </xpath>
    </t>

    <t t-name="mart369_auth.CustomerKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <Mart369CustomerDashboard list="props.list"/>
        </xpath>
    </t>

    <t t-name="mart369_auth.CustomerDashboard">
        <div class="o_mart369_dash" t-if="state.data">
            <t t-set="d" t-value="state.data"/>
            <button type="button" class="o_mart369_kpi" t-on-click="() => this.applyFilter('status_new,status_active,status_dormant')"
                    title="Show every live customer">
                <span class="o_mart369_tile o_mart369_tile_blue"><Icon n="'users'" size="14"/></span>
                <span class="o_mart369_kpi_txt">
                    <small>Customers</small>
                    <strong t-out="d.total"/>
                    <span><t t-out="d.archived"/> archived</span>
                </span>
            </button>
            <button type="button" class="o_mart369_kpi" t-on-click="() => this.applyFilter('status_new')"
                    title="Show customers who signed up this week">
                <span class="o_mart369_tile o_mart369_tile_orange"><Icon n="'star'" size="14"/></span>
                <span class="o_mart369_kpi_txt">
                    <small>New this week</small>
                    <strong t-out="d.new_week"/>
                    <span class="o_mart369_bars" aria-label="Sign-ups over the last 14 days">
                        <t t-foreach="bars" t-as="b" t-key="b.day">
                            <i t-att-style="'height:' + b.h + '%'" t-att-class="{'o_last': b.last, 'o_zero': !b.count}"
                               t-att-title="b.day + ': ' + b.count"/>
                        </t>
                    </span>
                </span>
            </button>
            <button type="button" class="o_mart369_kpi" t-on-click="() => this.applyFilter('status_active')"
                    title="Show active customers">
                <span class="o_mart369_tile o_mart369_tile_green"><Icon n="'bag'" size="14"/></span>
                <span class="o_mart369_kpi_txt">
                    <small>Ordered in 30 days</small>
                    <strong t-out="d.ordered_30"/>
                    <span><t t-out="d.ordered_pct"/>% of customers</span>
                </span>
            </button>
            <button type="button" class="o_mart369_kpi" t-on-click="() => this.applyFilter('no_mobile')"
                    title="Show customers without a mobile">
                <span class="o_mart369_tile"><Icon n="'phone'" size="14"/></span>
                <span class="o_mart369_kpi_txt">
                    <small>Mobile on file</small>
                    <strong><t t-out="d.with_mobile"/> <em>of <t t-out="d.total"/></em></strong>
                    <span class="o_mart369_meter"><i t-att-style="'width:' + d.mobile_pct + '%'"/></span>
                </span>
            </button>
            <button type="button" class="o_mart369_kpi" t-on-click="() => this.applyFilter('status_dormant')"
                    title="Show dormant customers">
                <span class="o_mart369_tile o_mart369_tile_red"><Icon n="'moon'" size="14"/></span>
                <span class="o_mart369_kpi_txt">
                    <small>Dormant</small>
                    <strong t-out="d.dormant"/>
                    <span>no sign-in for 60 days</span>
                </span>
            </button>
        </div>
    </t>

</templates>
