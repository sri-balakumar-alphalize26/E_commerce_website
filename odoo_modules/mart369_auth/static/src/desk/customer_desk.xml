<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_auth.CustomerDesk">
        <Layout display="{ controlPanel: {} }" className="'o_mart369_desk h-100'">
            <div class="mart-builder pe cu">

                <header class="pe-head">
                    <div>
                        <h1>Customers</h1>
                        <p>Everyone with a storefront account - what they have ordered, spent and hold in their wallet.</p>
                    </div>
                </header>

                <!-- The same four as the console. Each sets the tab. -->
                <div class="cu-tiles">
                    <button t-foreach="TILES" t-as="tile" t-key="tile.key" type="button"
                            t-attf-class="cu-tile {{ state.tab === tile.tab ? 'cu-tile-on' : '' }} {{ tile.warn ? 'cu-tile-warn' : '' }}"
                            t-att-aria-pressed="state.tab === tile.tab ? 'true' : 'false'"
                            t-on-click="() => this.set('tab', tile.tab)">
                        <span class="cu-tile-top">
                            <Icon n="tile.icon" size="15"/>
                            <t t-esc="tile.label"/>
                        </span>
                        <b t-esc="state.counts[tile.key] or 0"/>
                    </button>
                </div>

                <div class="pe-toolbar cu-toolbar">
                    <Tabs tabs="tabItems" value="state.tab" onChange="(k) => this.set('tab', k)"/>
                    <div class="pe-toolbar-gap"/>
                    <Search value="state.q" placeholder="'Name, email, phone or area'" label="'Search customers'"
                            onChange="(v) => this.onSearch(v)"/>
                    <Pick value="state.area" options="areaOptions" label="'Area'"
                          onChange="(v) => this.set('area', v)"/>
                    <Pick value="state.joined" options="JOINED" label="'Joined'"
                          onChange="(v) => this.set('joined', v)"/>
                    <Pick value="state.wallet" options="WALLET" label="'Wallet'"
                          onChange="(v) => this.set('wallet', v)"/>
                    <Pick t-if="state.allTags.length" value="state.tag" options="tagOptions" label="'Tag'"
                          onChange="(v) => this.set('tag', v)"/>
                    <Pick value="state.sort" options="SORTS" label="'Sort'" icon="'sort'"
                          onChange="(v) => this.set('sort', v)"/>
                </div>

                <p t-if="state.error" class="pe-error" role="alert">
                    We could not reach the shop. <t t-esc="state.error"/>
                    <button class="mart-link" t-on-click="() => this.load()">Try again</button>
                </p>

                <div class="cu-queue">
                    <p t-if="state.loading and !state.rows.length" class="pe-loading">Loading customers...</p>
                    <p t-elif="!state.rows.length and filtered" class="pe-loading">
                        Nobody matches. Clear the search, the area, the joined date or the wallet filter to see more.
                    </p>
                    <p t-elif="!state.rows.length and state.tab !== 'all'" class="pe-loading">
                        No <t t-esc="state.tab"/> customers right now.
                    </p>
                    <p t-elif="!state.rows.length" class="pe-loading">Nobody has signed up yet.</p>

                    <t t-else="">
                        <p class="cu-count">
                            <t t-if="filtered">Showing <t t-esc="state.rows.length"/> of <t t-esc="state.total"/> that match - the tiles count the whole shop.</t>
                            <t t-else=""><t t-esc="state.total"/> customers</t>
                        </p>
                        <table class="cu-table">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Contact</th>
                                    <th>Area</th>
                                    <th class="cu-num" t-if="hasBooks()">Addresses</th>
                                    <th class="cu-num">Orders</th>
                                    <th class="cu-num">Spent</th>
                                    <th class="cu-num">Wallet</th>
                                    <th>Last order</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.rows" t-as="row" t-key="row.id"
                                    t-attf-class="cu-row {{ state.open and state.open.id === row.id ? 'cu-row-on' : '' }}"
                                    t-on-click="() => this.openRow(row)">
                                    <td>
                                        <span class="cu-person">
                                            <span class="cu-avatar" t-esc="(row.name or '?').slice(0, 1).toUpperCase()"/>
                                            <span>
                                                <b t-esc="row.name"/>
                                                <small t-if="row.joined">Joined <t t-esc="day(row.joined)"/></small>
                                                <span t-if="row.tags and row.tags.length" class="cu-tags">
                                                    <span t-foreach="row.tags" t-as="tag" t-key="tag.id"
                                                          t-attf-class="mart-pill mart-t-{{ tone(tag) }}" t-esc="tag.name"/>
                                                </span>
                                            </span>
                                        </span>
                                    </td>
                                    <td><small><t t-esc="row.email"/><br/><t t-esc="row.phone"/></small></td>
                                    <td><small t-esc="row.area or '-'"/></td>
                                    <td class="cu-num" t-if="hasBooks()" t-esc="row.addressCount"/>
                                    <td class="cu-num" t-esc="row.orders"/>
                                    <td class="cu-num cu-strong" t-esc="money(row.spent)"/>
                                    <td class="cu-num" t-esc="money(row.wallet)"/>
                                    <td><small t-esc="ago(row.lastPlaced or row.last)"/></td>
                                    <td>
                                        <span class="cu-pills">
                                            <span t-foreach="badges(row)" t-as="badge" t-key="badge[0]"
                                                  t-attf-class="mart-pill mart-t-{{ badge[1] }}" t-esc="badge[0]"/>
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="state.rows.length &lt; state.total" class="cu-more">
                            <button class="mart-btn" t-on-click="() => this.more()">
                                Show more (<t t-esc="state.total - state.rows.length"/> left)
                            </button>
                        </div>
                    </t>
                </div>

                <!-- One customer, the same panel as the console's drawer. -->
                <t t-if="state.open">
                    <div class="cu-scrim" t-on-click="() => this.close()"/>
                    <aside class="cu-panel" role="dialog" aria-label="Customer">
                        <header class="cu-panel-head">
                            <span class="cu-avatar cu-avatar-lg" t-esc="(state.open.name or '?').slice(0, 1).toUpperCase()"/>
                            <div>
                                <h2 t-esc="state.open.name"/>
                                <small>
                                    <t t-esc="state.open.email"/>
                                    <t t-if="state.open.phone"> · <t t-esc="state.open.phone"/></t>
                                </small>
                                <small>
                                    <t t-esc="state.open.area or 'No area'"/> · <t t-esc="badgeLine(state.open)"/>
                                </small>
                            </div>
                            <button class="cu-x" aria-label="Close" t-on-click="() => this.close()">
                                <Icon n="'x'" size="16"/>
                            </button>
                        </header>

                        <!-- Reach them without copying the number. -->
                        <div class="cu-reach">
                            <a t-if="callHref" class="mart-btn" t-att-href="callHref">
                                <Icon n="'phone'" size="14"/> Call
                            </a>
                            <span t-else="" class="mart-btn cu-off"><Icon n="'phone'" size="14"/> Call</span>
                            <a t-if="waHref" class="mart-btn" t-att-href="waHref" target="_blank" rel="noopener">
                                <Icon n="'chat'" size="14"/> WhatsApp
                            </a>
                            <span t-else="" class="mart-btn cu-off"><Icon n="'chat'" size="14"/> WhatsApp</span>
                        </div>

                        <!-- What support reads before picking up the phone. -->
                        <p t-if="state.detail and state.detail.risk and (riskLine(state.detail.risk) or state.detail.risk.codOff)" class="cu-risk">
                            <Icon n="'warn'" size="14"/>
                            <span t-esc="riskLine(state.detail.risk)"/>
                            <span t-if="state.detail.risk.codOff" class="mart-pill mart-t-red">COD off</span>
                        </p>
                        <div t-if="state.detail and state.detail.risk" class="cu-cod">
                            <span><b>Cash on delivery</b><small>Off: this customer pays online only.</small></span>
                            <Switch on="!state.detail.risk.codOff" label="'Cash on delivery for this customer'"
                                    onChange="() => this.setCod(!state.detail.risk.codOff)"/>
                        </div>

                        <!-- Staff-only labels. Saved at once; Odoo's own contact tags. -->
                        <h4>Tags</h4>
                        <div class="cu-tagrow">
                            <span t-foreach="currentTags()" t-as="tag" t-key="tag.id"
                                  t-attf-class="mart-pill mart-t-{{ tone(tag) }} cu-tag">
                                <t t-esc="tag.name"/>
                                <button type="button" t-att-aria-label="'Remove ' + tag.name"
                                        t-att-disabled="state.busy" t-on-click="() => this.removeTag(tag)">×</button>
                            </span>
                            <button t-if="!state.tagging" type="button" class="cu-tag-add"
                                    t-on-click="() => { state.tagging = true; }">+ Add tag</button>
                        </div>
                        <div t-if="state.tagging" class="cu-tagpick">
                            <input type="text" placeholder="Type a tag…" t-att-value="state.tagText"
                                   t-on-input="(ev) => { state.tagText = ev.target.value; }"
                                   t-on-keydown="onTagKey" autofocus="autofocus"/>
                            <ul>
                                <li t-foreach="tagChoices" t-as="tag" t-key="tag.id">
                                    <button type="button" t-on-click="() => this.addTag(tag.name)" t-esc="tag.name"/>
                                </li>
                                <li t-if="tagIsNew">
                                    <button type="button" class="cu-tag-new" t-on-click="() => this.addTag(state.tagText)">
                                        + Create "<t t-esc="state.tagText.trim()"/>"
                                    </button>
                                </li>
                                <li t-if="!tagChoices.length and !tagIsNew" class="cu-dim">Type a name to make a new tag.</li>
                            </ul>
                        </div>

                        <div class="cu-figs">
                            <span><small>Orders</small><b t-esc="state.open.orders"/></span>
                            <span><small>Spent</small><b t-esc="money(state.open.spent)"/></span>
                            <span><small>Wallet</small><b t-esc="money(state.open.wallet)"/></span>
                            <span><small>Last order</small><b t-esc="ago(state.open.lastPlaced or state.open.last)"/></span>
                        </div>

                        <!-- Every address the customer keeps, the default first - what
                             Amazon's support sees. Filled in by mart369_address; without
                             it the block simply is not there. Editing is on the full
                             profile, in the Delivery addresses tab. -->
                        <t t-if="state.detail and state.detail.addresses">
                            <h4>Addresses (<t t-esc="state.detail.addresses.length"/>)</h4>
                            <p t-if="!state.detail.addresses.length" class="cu-dim">No saved addresses yet.</p>
                            <ul t-else="" class="cu-addrs">
                                <li t-foreach="state.detail.addresses" t-as="a" t-key="a.id"
                                    t-attf-class="{{ a.default ? 'cu-addr-on' : '' }}">
                                    <span class="cu-addr-head">
                                        <b t-esc="a.label"/>
                                        <span t-if="a.default" class="mart-pill mart-t-green">Ships here</span>
                                        <span t-if="a.gaps and a.gaps.length" class="mart-pill mart-t-orange">
                                            Missing <t t-esc="a.gaps.join(', ')"/>
                                        </span>
                                    </span>
                                    <small><t t-esc="a.name"/><t t-if="a.phone"> · <t t-esc="a.phone"/></t></small>
                                    <small t-foreach="addressLines(a)" t-as="line" t-key="line_index" t-esc="line"/>
                                </li>
                            </ul>
                            <p t-if="state.detail.removedAddresses" class="cu-dim">
                                + <t t-esc="state.detail.removedAddresses"/> removed by the customer
                            </p>
                            <button t-if="hasBooks()" type="button" class="cu-tag-add cu-addr-add"
                                    t-on-click="() => this.addAddress()">+ Add address</button>
                        </t>

                        <!-- Money into the wallet with a reason, as a reward. -->
                        <div t-if="state.detail and state.detail.risk" class="cu-goodwill">
                            <button t-if="!state.giving" type="button" class="cu-tag-add"
                                    t-on-click="() => { state.giving = true; }">+ Goodwill credit</button>
                            <t t-else="">
                                <h4>Goodwill credit</h4>
                                <div class="cu-goodwill-row">
                                    <input type="text" inputmode="decimal" placeholder="Amount" t-att-value="state.giveAmount"
                                           t-on-input="(ev) => this.setGiveAmount(ev.target.value)"/>
                                    <input type="text" maxlength="120" placeholder="Reason, e.g. late delivery" t-att-value="state.giveReason"
                                           t-on-input="(ev) => { state.giveReason = ev.target.value; }"/>
                                </div>
                                <span class="cu-note-edit-act">
                                    <button class="mart-btn" t-on-click="() => { state.giving = false; }">Cancel</button>
                                    <button class="mart-btn mart-btn-primary"
                                            t-att-disabled="!canGive"
                                            t-on-click="() => this.giveGoodwill()">Add to wallet</button>
                                </span>
                                <small class="cu-dim">The customer sees it in their wallet as "Goodwill credit", with your reason and name.</small>
                            </t>
                        </div>

                        <!-- Only staff read these - never the customer. -->
                        <h4>Staff notes</h4>
                        <div class="cu-note-new">
                            <textarea rows="2" maxlength="1000" placeholder="Write a note for the team…"
                                      t-att-value="state.note"
                                      t-on-input="(ev) => { state.note = ev.target.value; }"/>
                            <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy or !state.note.trim() or !state.detail"
                                    t-on-click="() => this.addNote()">Add</button>
                        </div>
                        <p t-if="state.detail and state.detail.notes and !state.detail.notes.length" class="cu-dim">No notes yet.</p>
                        <ul t-if="state.detail and state.detail.notes and state.detail.notes.length" class="cu-notes">
                            <li t-foreach="state.detail.notes" t-as="n" t-key="n.id">
                                <t t-if="state.editing === n.id">
                                    <textarea class="cu-note-edit" rows="2" maxlength="1000" t-att-value="state.editText"
                                              t-on-input="(ev) => { state.editText = ev.target.value; }"/>
                                    <span class="cu-note-edit-act">
                                        <button class="mart-btn" t-on-click="() => { state.editing = null; }">Cancel</button>
                                        <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy or !state.editText.trim()"
                                                t-on-click="() => this.saveEdit(n)">Save</button>
                                    </span>
                                </t>
                                <p t-else="" t-esc="n.text"/>
                                <small>
                                    <t t-esc="n.author"/> · <t t-esc="ago(n.at)"/>
                                    <button t-if="n.mine and state.editing !== n.id" type="button" class="cu-note-del cu-note-pen" aria-label="Edit note"
                                            t-att-disabled="state.busy" t-on-click="() => this.startEdit(n)">
                                        <Icon n="'pen'" size="13"/>
                                    </button>
                                    <button t-if="n.mine" type="button" class="cu-note-del" aria-label="Delete note"
                                            t-att-disabled="state.busy" t-on-click="() => this.deleteNote(n)">
                                        <Icon n="'trash'" size="13"/>
                                    </button>
                                </small>
                            </li>
                        </ul>

                        <h4>Recent orders</h4>
                        <p t-if="!state.detail" class="pe-loading">Loading...</p>
                        <p t-elif="state.detail.error" class="pe-error" t-esc="state.detail.error"/>
                        <p t-elif="!state.detail.recent or !state.detail.recent.length" class="cu-dim">No orders yet.</p>
                        <ul t-else="" class="cu-orders">
                            <li t-foreach="state.detail.recent" t-as="o" t-key="o.ref">
                                <span class="cu-chip" t-esc="o.items"/>
                                <span>
                                    <b>#<t t-esc="o.ref"/></b>
                                    <small><t t-esc="day(o.at)"/><t t-if="o.method"> · <t t-esc="o.method"/></t><t t-if="o.addressLabel"> · to <t t-esc="o.addressLabel"/></t></small>
                                </span>
                                <b t-esc="money(o.total)"/>
                            </li>
                        </ul>

                        <footer class="cu-panel-foot">
                            <button class="mart-btn" t-on-click="() => this.close()">Close</button>
                            <button class="mart-btn mart-btn-primary" t-on-click="() => this.openForm()">
                                Open full profile
                            </button>
                        </footer>
                    </aside>
                </t>

            </div>
        </Layout>
    </t>

</templates>
