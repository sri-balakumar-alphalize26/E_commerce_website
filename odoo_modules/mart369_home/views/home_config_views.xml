<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mart369_home_config_view_form" model="ir.ui.view">
        <field name="name">mart369.config.form.home</field>
        <field name="model">mart369.config</field>
        <field name="arch" type="xml">
            <form string="Home Page Settings" create="false" delete="false">
                <header>
                    <button name="action_open_api" type="object"
                            string="See what the app receives"
                            class="btn-secondary" icon="fa-external-link"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" nolabel="1"/></h1>
                    </div>
                    <group string="The two app modes">
                        <div colspan="2" class="text-muted small mb-2">
                            Open a mode to build its home page - the banners,
                            the tiles, the rows and their order.
                        </div>
                        <field name="mode_ids" nolabel="1" colspan="2"
                               context="{'active_test': False}">
                            <list default_order="sequence">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="key"/>
                                <field name="free_delivery_at"/>
                                <field name="active" string="Show" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group string="Products">
                            <field name="default_rail_limit"/>
                            <field name="hide_out_of_stock"/>
                        </group>
                        <group string="Speed">
                            <field name="cache_seconds"/>
                        </group>
                    </group>
                    <group string="For whoever sets up the app">
                        <field name="api_url_preview" readonly="1"/>
                        <field name="image_base_url" placeholder="Usually leave empty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens the one settings record straight away, rather than a list
         holding a single row. -->
    <record id="action_mart369_home_config" model="ir.actions.server">
        <field name="name">Home Page Settings</field>
        <field name="model_id" ref="mart369.model_mart369_config"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Home Page Settings',
    'res_model': 'mart369.config',
    'view_mode': 'form',
    'res_id': model._get().id,
    'target': 'current',
    'context': {'active_test': False},
}</field>
    </record>

</odoo>
