<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mart369_home_banner_view_kanban" model="ir.ui.view">
        <field name="name">mart369.home.banner.kanban</field>
        <field name="model">mart369.home.banner</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence">
                <t t-name="card">
                    <field name="active" invisible="1"/>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <div class="d-flex align-items-center mt-2">
                        <span class="fw-bold me-2"><field name="name"/></span>
                        <span class="text-muted small"><field name="key"/></span>
                    </div>
                    <div class="text-muted small">
                        Used in <field name="usage_count"/> banner strip(s)
                    </div>
                    <div class="mt-2">
                        <button name="action_toggle_active" type="object"
                                class="btn btn-sm btn-primary" invisible="active"
                                confirm="Show this banner in the app?">Turn on</button>
                        <button name="action_toggle_active" type="object"
                                class="btn btn-sm btn-secondary" invisible="not active"
                                confirm="Hide this banner from the app?">Turn off</button>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="mart369_home_banner_view_list" model="ir.ui.view">
        <field name="name">mart369.home.banner.list</field>
        <field name="model">mart369.home.banner</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [70, 36]}" string="Picture"/>
                <field name="key"/>
                <field name="kicker" optional="show"/>
                <field name="name"/>
                <field name="note" optional="show"/>
                <field name="tone"/>
                <field name="mode_id" optional="show"/>
                <field name="usage_count" optional="hide"/>
                <field name="active" string="Show" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mart369_home_banner_view_form" model="ir.ui.view">
        <field name="name">mart369.home.banner.form</field>
        <field name="model">mart369.home.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <header>
                    <button name="action_restore" type="object" string="Put back"
                            class="btn-primary" icon="fa-undo" invisible="not deleted_at"/>
                    <button name="action_toggle_active" type="object"
                            string="Turn on (show in the app)" class="btn-primary"
                            icon="fa-toggle-off" invisible="active"
                            confirm="Show this banner in the app?"/>
                    <button name="action_toggle_active" type="object"
                            string="Turn off (hide from the app)" class="btn-secondary"
                            icon="fa-toggle-on" invisible="not active"
                            confirm="Hide this banner from the app? Nothing is deleted."/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not deleted_at">
                        This is in the Trash. It is not shown in the app.
                        <field name="trash_days_left" readonly="1" class="oe_inline"/> day(s) left before it is deleted for good.
                        <field name="deleted_at" invisible="1"/>
                    </div>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="text-muted small mb-1">
                        This is how the banner looks in the app. It updates as you type.
                    </div>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <group>
                        <group string="What it says">
                            <field name="kicker" placeholder="e.g. Fresh fruit week"/>
                            <field name="name" placeholder="e.g. Fruits picked this morning"/>
                            <field name="note" placeholder="e.g. Up to 30% off"/>
                            <field name="href" placeholder="e.g. /category/fruits-vegetables"/>
                        </group>
                        <group string="Where it belongs">
                            <field name="mode_id"/>
                            <field name="key" placeholder="e.g. b1"/>
                            <field name="tone"/>
                            <field name="usage_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Picture (recommended 1200 x 480)">
                        <field name="image_1920" widget="image" nolabel="1" colspan="2"
                               options="{'size': [0, 220]}"/>
                    </group>
                    <group string="No picture? The app draws these instead"
                           invisible="image_1920">
                        <field name="art_lines" nolabel="1" colspan="2"
                               placeholder="One name per line, e.g.&#10;Apple&#10;Orange&#10;Banana"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mart369_home_banner_view_search" model="ir.ui.view">
        <field name="name">mart369.home.banner.search</field>
        <field name="model">mart369.home.banner</field>
        <field name="arch" type="xml">
            <search>
                <filter string="In the Trash" name="trashed" domain="[('deleted_at', '!=', False)]"/>
                <filter string="Not in the Trash" name="kept" domain="[('deleted_at', '=', False)]"/>
                <field name="name"/>
                <field name="key"/>
                <filter string="Hidden" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="App mode" name="group_mode" context="{'group_by': 'mode_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mart369_home_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">mart369.home.banner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'active_test': False, 'search_default_kept': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first banner</p>
            <p>
                Banners are the promo cards that slide past at the top of the app.
                The same banner can also be dropped into a banner strip further
                down the home page - edit it once here and every place it appears
                updates.
            </p>
            <p>Drag the rows in the list to change the order they slide past in.</p>
        </field>
    </record>

</odoo>
