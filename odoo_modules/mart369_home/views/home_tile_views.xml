<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mart369_home_tile_view_kanban" model="ir.ui.view">
        <field name="name">mart369.home.tile.kanban</field>
        <field name="model">mart369.home.tile</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence">
                <t t-name="card">
                    <field name="active" invisible="1"/>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <div class="text-muted small mt-1"><field name="key"/></div>
                    <div class="mt-2">
                        <button name="action_toggle_active" type="object"
                                class="btn btn-sm btn-primary" invisible="active"
                                confirm="Show this tile in the app?">Turn on</button>
                        <button name="action_toggle_active" type="object"
                                class="btn btn-sm btn-secondary" invisible="not active"
                                confirm="Hide this tile from the app?">Turn off</button>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="mart369_home_tile_view_list" model="ir.ui.view">
        <field name="name">mart369.home.tile.list</field>
        <field name="model">mart369.home.tile</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [44, 44]}" string="Picture"/>
                <field name="key"/>
                <field name="name"/>
                <field name="public_categ_id" optional="show"/>
                <field name="route" optional="show"/>
                <field name="image_source" optional="hide"/>
                <field name="art" optional="hide"/>
                <field name="bg" widget="color" optional="hide"/>
                <field name="mode_id" optional="show"/>
                <field name="active" string="Show" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mart369_home_tile_view_form" model="ir.ui.view">
        <field name="name">mart369.home.tile.form</field>
        <field name="model">mart369.home.tile</field>
        <field name="arch" type="xml">
            <form string="Category Tile">
                <header>
                    <button name="action_restore" type="object" string="Put back"
                            class="btn-primary" icon="fa-undo" invisible="not deleted_at"/>
                    <button name="action_toggle_active" type="object"
                            string="Turn on (show in the app)" class="btn-primary"
                            icon="fa-toggle-off" invisible="active"/>
                    <button name="action_toggle_active" type="object"
                            string="Turn off (hide from the app)" class="btn-secondary"
                            icon="fa-toggle-on" invisible="not active"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not deleted_at">
                        This is in the Trash. It is not shown in the app.
                        <field name="trash_days_left" readonly="1" class="oe_inline"/> day(s) left before it is deleted for good.
                        <field name="deleted_at" invisible="1"/>
                    </div>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="text-muted small mb-1">How the tile looks in the app:</div>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <group>
                        <group string="What it says">
                            <field name="name" placeholder="e.g. Fresh fruits"/>
                            <field name="key" placeholder="e.g. fruits"/>
                            <field name="mode_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Where it goes">
                            <field name="public_categ_id"/>
                            <field name="route"
                                   placeholder="e.g. fruits-vegetables/fresh-fruits"/>
                        </group>
                    </group>
                    <group string="Picture">
                        <field name="image_source" widget="radio"/>
                        <field name="image_1920" widget="image"
                               invisible="image_source != 'upload'"
                               options="{'size': [0, 160]}"/>
                        <field name="image_url" invisible="image_source != 'url'"
                               placeholder="https://..."/>
                        <field name="image_path" readonly="1"/>
                    </group>
                    <group string="The drawing (used when there is no picture)">
                        <group>
                            <field name="art"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="badge" placeholder="e.g. ATTA"/>
                            <field name="bg" widget="color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mart369_home_tile_view_search" model="ir.ui.view">
        <field name="name">mart369.home.tile.search</field>
        <field name="model">mart369.home.tile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key"/>
                <filter string="Not in the Trash" name="kept" domain="[('deleted_at', '=', False)]"/>
                <filter string="In the Trash" name="trashed" domain="[('deleted_at', '!=', False)]"/>
                <separator/>
                <filter string="Hidden" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="App mode" name="group_mode" context="{'group_by': 'mode_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mart369_home_tile" model="ir.actions.act_window">
        <field name="name">Category Tiles</field>
        <field name="res_model">mart369.home.tile</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'active_test': False, 'search_default_kept': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first tile</p>
            <p>
                Tiles are the rounded shortcuts just under the banners - Fresh
                fruits, Atta and staples, and so on. Drag the rows to change
                their order.
            </p>
        </field>
    </record>

</odoo>
