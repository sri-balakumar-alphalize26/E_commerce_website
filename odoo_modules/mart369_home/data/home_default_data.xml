         module is installed an upgrade never overwrites what the operator
         has changed. -->
    <data noupdate="1">

        <!-- ══════════════ Shop categories the rows point at ══════════════
             Created so the home page works the moment the module is
             installed. Put products into these and the rows fill up. -->

        <record id="categ_fruits" model="product.public.category">
            <field name="name">Fresh Fruits</field>
            <field name="sequence">10</field>
        </record>
        <record id="categ_staples" model="product.public.category">
            <field name="name">Daily Essentials</field>
            <field name="sequence">20</field>
        </record>
        <record id="categ_tech" model="product.public.category">
