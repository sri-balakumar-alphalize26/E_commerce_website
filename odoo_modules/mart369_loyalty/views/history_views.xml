<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Which order a movement belongs to - the link the Point of Sale order
         used to give, now to the sale order. -->
    <record id="view_loyalty_history_list_mart369" model="ir.ui.view">
        <field name="name">pos.loyalty.history.list.mart369</field>
        <field name="model">pos.loyalty.history</field>
        <field name="inherit_id" ref="pos_loyalty_card.view_loyalty_history_list"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="sale_order_id" string="Order" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_loyalty_history_form_mart369" model="ir.ui.view">
        <field name="name">pos.loyalty.history.form.mart369</field>
        <field name="model">pos.loyalty.history</field>
        <field name="inherit_id" ref="pos_loyalty_card.view_loyalty_history_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="sale_order_id" string="Order" readonly="1"/>
            </field>
        </field>
    </record>

</odoo>
