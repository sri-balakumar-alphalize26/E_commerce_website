<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The bands of the product page, top to bottom, exactly as the app
         draws them. noupdate="1": once installed, an upgrade never undoes
         what the shop has switched off. -->
    <data noupdate="1">

        <record id="sec_gallery" model="mart369.product.section">
            <field name="key">gallery</field>
            <field name="name">Photos</field>
            <field name="note">The picture carousel at the top.</field>
            <field name="sequence">10</field>
        </record>

        <record id="sec_buy" model="mart369.product.section">
            <field name="key">buy</field>
            <field name="name">Price and buy box</field>
            <field name="note">Name, price, the choices and the Add to cart button.</field>
            <field name="sequence">20</field>
        </record>

        <record id="sec_specs" model="mart369.product.section">
            <field name="key">specs</field>
            <field name="name">Item specifications</field>
            <field name="note">The variant's specs table, as the WhatsApp page lists it.</field>
            <field name="sequence">50</field>
        </record>

        <record id="sec_description" model="mart369.product.section">
            <field name="key">description</field>
            <field name="name">Product description</field>
            <field name="note">The Sales Description.</field>
            <field name="sequence">60</field>
        </record>

        <record id="sec_reviews" model="mart369.product.section">
            <field name="key">reviews</field>
            <field name="name">Ratings and reviews</field>
            <field name="note">Real reviews written by customers who bought it.</field>
            <field name="sequence">80</field>
        </record>

        <record id="sec_bundle" model="mart369.product.section">
            <field name="key">bundle</field>
            <field name="name">Frequently bought together</field>
            <field name="sequence">100</field>
        </record>

        <record id="sec_similar" model="mart369.product.section">
            <field name="key">similar</field>
            <field name="name">Similar and related products</field>
            <field name="sequence">110</field>
        </record>

    </data>
</odoo>
