<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everything the product page can show. Generated by
         tools/gen_fields_xml.py - edit the table there and re-run.
         noupdate="1" so an upgrade never switches back on something
         the shop deliberately switched off. -->
    <data noupdate="1">

        <record id="f_images" model="mart369.product.field">
            <field name="key">images</field>
            <field name="name">Photos</field>
            <field name="section_id" ref="sec_gallery"/>
            <field name="sequence">10</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Every picture on the product.</field>
        </record>

        <record id="f_unit_tag" model="mart369.product.field">
            <field name="key">unit_tag</field>
            <field name="name">Size tag on the photo</field>
            <field name="section_id" ref="sec_gallery"/>
            <field name="sequence">20</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_unit_text</field>
            <field name="note">e.g. 1 kg, shown over the image.</field>
        </record>

        <record id="f_brand" model="mart369.product.field">
            <field name="key">brand</field>
            <field name="name">Brand</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">30</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">369 Mart Select</field>
            <field name="note">The link above the product name.</field>
        </record>

        <record id="f_name" model="mart369.product.field">
            <field name="key">name</field>
            <field name="name">Product name</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">40</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">name</field>
            <field name="per_product" eval="False"/>
            <field name="note">Always shown - a page without a name would be useless.</field>
        </record>

        <record id="f_rating_summary" model="mart369.product.field">
            <field name="key">rating_summary</field>
            <field name="name">Star rating</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">50</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The 4.3 and the stars under the name.</field>
        </record>

        <record id="f_price" model="mart369.product.field">
            <field name="key">price</field>
            <field name="name">Price</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">60</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">list_price</field>
            <field name="per_product" eval="False"/>
            <field name="note">Always shown.</field>
        </record>

        <record id="f_mrp" model="mart369.product.field">
            <field name="key">mrp</field>
            <field name="name">MRP and discount</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">70</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">compare_list_price</field>
            <field name="note">The struck-through price and the per-cent-off pill.</field>
        </record>

        <record id="f_per_unit" model="mart369.product.field">
            <field name="key">per_unit</field>
            <field name="name">Price per unit</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">80</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">e.g. 17.25 per 250 g.</field>
        </record>

        <record id="f_low_stock" model="mart369.product.field">
            <field name="key">low_stock</field>
            <field name="name">Only-N-left warning</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">90</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Nudges the customer when stock runs low.</field>
        </record>

        <record id="f_pack_sizes" model="mart369.product.field">
            <field name="key">pack_sizes</field>
            <field name="name">Pack sizes</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">100</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The 1 kg / 5 kg / 10 kg chooser.</field>
        </record>

        <record id="f_delivery_mode" model="mart369.product.field">
            <field name="key">delivery_mode</field>
            <field name="name">Delivery speed badge</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">110</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Quick in 10-20 mins, or Express with the number of days.</field>
        </record>

        <record id="f_wishlist" model="mart369.product.field">
            <field name="key">wishlist</field>
            <field name="name">Save-to-list button</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">120</field>
            <field name="source">computed</field>
            <field name="value_kind">bool</field>
            <field name="per_product" eval="False"/>
            <field name="note">The heart button.</field>
        </record>

        <record id="f_share" model="mart369.product.field">
            <field name="key">share</field>
            <field name="name">Share button</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">130</field>
            <field name="source">computed</field>
            <field name="value_kind">bool</field>
            <field name="per_product" eval="False"/>
        </record>

        <record id="f_features" model="mart369.product.field">
            <field name="key">features</field>
            <field name="name">Key features</field>
            <field name="section_id" ref="sec_features"/>
            <field name="sequence">140</field>
            <field name="source">odoo</field>
            <field name="value_kind">lines</field>
            <field name="odoo_field">mart_features</field>
            <field name="note">One per line. Falls back to the category default.</field>
        </record>

        <record id="f_info_brand" model="mart369.product.field">
            <field name="key">info_brand</field>
            <field name="name">Brand</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">150</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">369 Mart Select</field>
        </record>

        <record id="f_sold_by" model="mart369.product.field">
            <field name="key">sold_by</field>
            <field name="name">Sold by</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">160</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">369 Mart Retail</field>
            <field name="note">Who the customer is buying from.</field>
        </record>

        <record id="f_country_of_origin" model="mart369.product.field">
            <field name="key">country_of_origin</field>
            <field name="name">Country of origin</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">170</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">India</field>
            <field name="note">Required on most marketplaces.</field>
        </record>

        <record id="f_manufacturer_name" model="mart369.product.field">
            <field name="key">manufacturer_name</field>
            <field name="name">Manufacturer name</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">180</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="note">Legally required for packaged goods in India.</field>
        </record>

        <record id="f_manufacturer_address" model="mart369.product.field">
            <field name="key">manufacturer_address</field>
            <field name="name">Manufacturer address</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">190</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="note">Legally required for packaged goods in India.</field>
        </record>

        <record id="f_article_id" model="mart369.product.field">
            <field name="key">article_id</field>
            <field name="name">Article ID</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">200</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">default_code</field>
            <field name="note">The internal reference.</field>
        </record>

        <record id="f_veg" model="mart369.product.field">
            <field name="key">veg</field>
            <field name="name">Vegetarian mark</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">210</field>
            <field name="source">odoo</field>
            <field name="value_kind">bool</field>
            <field name="odoo_field">mart_is_veg</field>
            <field name="note">The green square. Food products only.</field>
        </record>

        <record id="f_item_height" model="mart369.product.field">
            <field name="key">item_height</field>
            <field name="name">Item height</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">220</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_item_height</field>
        </record>

        <record id="f_item_length" model="mart369.product.field">
            <field name="key">item_length</field>
            <field name="name">Item length</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">230</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_item_length</field>
        </record>

        <record id="f_item_width" model="mart369.product.field">
            <field name="key">item_width</field>
            <field name="name">Item width</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">240</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_item_width</field>
        </record>

        <record id="f_net_weight" model="mart369.product.field">
            <field name="key">net_weight</field>
            <field name="name">Net weight</field>
            <field name="section_id" ref="sec_info"/>
            <field name="sequence">250</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">weight</field>
            <field name="note">Taken from the weight on the product.</field>
        </record>

        <record id="f_net_quantity" model="mart369.product.field">
            <field name="key">net_quantity</field>
            <field name="name">Net quantity</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">260</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_unit_text</field>
        </record>

        <record id="f_spec_brand" model="mart369.product.field">
            <field name="key">spec_brand</field>
            <field name="name">Brand</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">270</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">369 Mart Select</field>
        </record>

        <record id="f_warranty" model="mart369.product.field">
            <field name="key">warranty</field>
            <field name="name">Warranty</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">280</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="note">e.g. 1 year manufacturer warranty. Usually set per category.</field>
        </record>

        <record id="f_in_the_box" model="mart369.product.field">
            <field name="key">in_the_box</field>
            <field name="name">In the box</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">290</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_in_the_box</field>
        </record>

        <record id="f_material" model="mart369.product.field">
            <field name="key">material</field>
            <field name="name">Material</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">300</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">mart_material</field>
        </record>

        <record id="f_product_type" model="mart369.product.field">
            <field name="key">product_type</field>
            <field name="name">Product type</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">310</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The category the product sits in.</field>
        </record>

        <record id="f_shelf_life" model="mart369.product.field">
            <field name="key">shelf_life</field>
            <field name="name">Shelf life</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">320</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="note">e.g. 3-5 days, refrigerated. Usually set per category.</field>
        </record>

        <record id="f_description" model="mart369.product.field">
            <field name="key">description</field>
            <field name="name">Description</field>
            <field name="section_id" ref="sec_description"/>
            <field name="sequence">330</field>
            <field name="source">odoo</field>
            <field name="value_kind">html</field>
            <field name="odoo_field">description_ecommerce</field>
            <field name="note">The long text. Falls back to the sales description.</field>
        </record>

        <record id="f_disclaimer" model="mart369.product.field">
            <field name="key">disclaimer</field>
            <field name="name">Disclaimer</field>
            <field name="section_id" ref="sec_description"/>
            <field name="sequence">340</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">While we work to ensure product information is correct, packaging and ingredients may be updated by the manufacturer. Always read the label before use.</field>
            <field name="note">Shown under the description.</field>
        </record>

        <record id="f_returnable" model="mart369.product.field">
            <field name="key">returnable</field>
            <field name="name">Returnable</field>
            <field name="section_id" ref="sec_returns"/>
            <field name="sequence">350</field>
            <field name="source">text</field>
            <field name="value_kind">bool</field>
            <field name="default_value">yes</field>
            <field name="note">Whether this can be returned at all.</field>
        </record>

        <record id="f_return_text" model="mart369.product.field">
            <field name="key">return_text</field>
            <field name="name">Return policy wording</field>
            <field name="section_id" ref="sec_returns"/>
            <field name="sequence">360</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">7-day replacement for damaged or wrong items. Keep the original packaging.</field>
            <field name="note">Usually set per category.</field>
        </record>

        <record id="f_policy_link" model="mart369.product.field">
            <field name="key">policy_link</field>
            <field name="name">View-policy link</field>
            <field name="section_id" ref="sec_returns"/>
            <field name="sequence">370</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">/cancellation-policy</field>
            <field name="note">Where the link goes. That page must exist on the storefront.</field>
        </record>

        <record id="f_rating" model="mart369.product.field">
            <field name="key">rating</field>
            <field name="name">Average rating</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">380</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Worked out from real customer reviews.</field>
        </record>

        <record id="f_rating_count" model="mart369.product.field">
            <field name="key">rating_count</field>
            <field name="name">Number of ratings</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">390</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

        <record id="f_rating_bars" model="mart369.product.field">
            <field name="key">rating_bars</field>
            <field name="name">Star breakdown</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">400</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The five-star to one-star bars.</field>
        </record>

        <record id="f_reviews" model="mart369.product.field">
            <field name="key">reviews</field>
            <field name="name">Customer reviews</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">410</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Written by customers who bought the product.</field>
        </record>

        <record id="f_review_empty" model="mart369.product.field">
            <field name="key">review_empty</field>
            <field name="name">Be-the-first-to-review line</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">420</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">Be the first to review this product</field>
            <field name="note">Shown instead of the block when there are no reviews yet.</field>
        </record>

        <record id="f_address" model="mart369.product.field">
            <field name="key">address</field>
            <field name="name">Delivery address</field>
            <field name="section_id" ref="sec_delivery"/>
            <field name="sequence">430</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="per_product" eval="False"/>
            <field name="note">The customer's own address.</field>
        </record>

        <record id="f_explore_category" model="mart369.product.field">
            <field name="key">explore_category</field>
            <field name="name">Explore-more link</field>
            <field name="section_id" ref="sec_delivery"/>
            <field name="sequence">440</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

        <record id="f_bundle_items" model="mart369.product.field">
            <field name="key">bundle_items</field>
            <field name="name">Frequently bought together</field>
            <field name="section_id" ref="sec_bundle"/>
            <field name="sequence">450</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Uses the accessories set on the product, or picks them automatically.</field>
        </record>

        <record id="f_similar_items" model="mart369.product.field">
            <field name="key">similar_items</field>
            <field name="name">Similar products</field>
            <field name="section_id" ref="sec_similar"/>
            <field name="sequence">460</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Uses the alternative products set on the product, or the same category.</field>
        </record>

        <record id="f_related_items" model="mart369.product.field">
            <field name="key">related_items</field>
            <field name="name">Others you may also like</field>
            <field name="section_id" ref="sec_similar"/>
            <field name="sequence">470</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

        <record id="f_recently_viewed" model="mart369.product.field">
            <field name="key">recently_viewed</field>
            <field name="name">Recently viewed</field>
            <field name="section_id" ref="sec_similar"/>
            <field name="sequence">480</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

    </data>
</odoo>
