<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everything the product page can show. Generated by
         tools/gen_fields_xml.py - edit the table there and re-run.
         noupdate="1" so an upgrade never switches back on something
         the shop deliberately switched off. -->
    <data noupdate="1">

        <record id="f_images" model="mart369.product.field">
            <field name="key">images</field>
            <field name="name">Photos</field>
            <field name="section_id" ref="sec_gallery"/>
            <field name="sequence">10</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="per_product" eval="False"/>
            <field name="note">Every picture of the product and its variant. Always shown.</field>
        </record>

        <record id="f_name" model="mart369.product.field">
            <field name="key">name</field>
            <field name="name">Product name</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">20</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">name</field>
            <field name="per_product" eval="False"/>
            <field name="note">Always shown - a page without a name would be useless.</field>
        </record>

        <record id="f_price" model="mart369.product.field">
            <field name="key">price</field>
            <field name="name">Price</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">30</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">list_price</field>
            <field name="per_product" eval="False"/>
            <field name="note">Always shown.</field>
        </record>

        <record id="f_mrp" model="mart369.product.field">
            <field name="key">mrp</field>
            <field name="name">MRP and discount</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">40</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">compare_list_price</field>
            <field name="note">The struck-through price and the per-cent-off pill.</field>
        </record>

        <record id="f_low_stock" model="mart369.product.field">
            <field name="key">low_stock</field>
            <field name="name">Only-N-left warning</field>
            <field name="section_id" ref="sec_buy"/>
            <field name="sequence">50</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Nudges the customer when stock runs low.</field>
        </record>

        <record id="f_variant_specs" model="mart369.product.field">
            <field name="key">variant_specs</field>
            <field name="name">Variant specs</field>
            <field name="section_id" ref="sec_specs"/>
            <field name="sequence">60</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The variant's specs table, as the WhatsApp page lists it (Edit product &gt; Variants).</field>
        </record>

        <record id="f_sales_description" model="mart369.product.field">
            <field name="key">sales_description</field>
            <field name="name">Sales Description</field>
            <field name="section_id" ref="sec_description"/>
            <field name="sequence">70</field>
            <field name="source">odoo</field>
            <field name="value_kind">text</field>
            <field name="odoo_field">description_sale</field>
            <field name="note">Shown under the picture on the WhatsApp page and here.</field>
        </record>

        <record id="f_rating" model="mart369.product.field">
            <field name="key">rating</field>
            <field name="name">Average rating</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">80</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Worked out from real customer reviews.</field>
        </record>

        <record id="f_rating_count" model="mart369.product.field">
            <field name="key">rating_count</field>
            <field name="name">Number of ratings</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">90</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

        <record id="f_rating_bars" model="mart369.product.field">
            <field name="key">rating_bars</field>
            <field name="name">Star breakdown</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">100</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">The five-star to one-star bars.</field>
        </record>

        <record id="f_reviews" model="mart369.product.field">
            <field name="key">reviews</field>
            <field name="name">Customer reviews</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">110</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Written by customers who bought the product.</field>
        </record>

        <record id="f_review_empty" model="mart369.product.field">
            <field name="key">review_empty</field>
            <field name="name">Be-the-first-to-review line</field>
            <field name="section_id" ref="sec_reviews"/>
            <field name="sequence">120</field>
            <field name="source">text</field>
            <field name="value_kind">text</field>
            <field name="default_value">Be the first to review this product</field>
            <field name="note">Shown instead of the block when there are no reviews yet.</field>
        </record>

        <record id="f_bundle_items" model="mart369.product.field">
            <field name="key">bundle_items</field>
            <field name="name">Frequently bought together</field>
            <field name="section_id" ref="sec_bundle"/>
            <field name="sequence">130</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Uses the accessories set on the product, or picks them automatically.</field>
        </record>

        <record id="f_similar_items" model="mart369.product.field">
            <field name="key">similar_items</field>
            <field name="name">Similar products</field>
            <field name="section_id" ref="sec_similar"/>
            <field name="sequence">140</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
            <field name="note">Uses the alternative products set on the product, or the same category.</field>
        </record>

        <record id="f_related_items" model="mart369.product.field">
            <field name="key">related_items</field>
            <field name="name">Others you may also like</field>
            <field name="section_id" ref="sec_similar"/>
            <field name="sequence">150</field>
            <field name="source">computed</field>
            <field name="value_kind">text</field>
        </record>

    </data>
</odoo>
