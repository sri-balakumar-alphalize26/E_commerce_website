<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On General Information, under Odoo's own fields, so a product is
         filled in on the page that opens first: the Products desk's editor,
         then the two things the desk does not draw - the drawing used when a
         product has no photo, and the per-product exceptions table.

         The editor is the same component the desk uses (editor_widget.js), so
         Inventory > Products and 369 Mart > Products ask the same questions in
         the same boxes. It writes to this form's record: Odoo's own Save and
         Discard apply to it, and there is no second Save button. -->
    <record id="mart369_product_page_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.mart369.page</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mart369.view_product_template_form_mart369"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group" position="after">
                <separator string="369 Mart"/>
                <div class="text-muted small mb-2">
                    What this product looks like in the app - the same boxes as
                    369 Mart &gt; Products. Hover an eye to see where a box shows.
                    Saved with the form's own Save.
                </div>

                <!-- Everything the editor writes has to be on the view, or the
                     record will not save it. Invisible here; the editor is
                     what draws them. The x2many and categories are already on
                     the form (website_sale), with the sub-fields they need. -->
                <field name="mart_page_hidden" invisible="1"/>
                <field name="write_date" invisible="1"/>
                <field name="default_code" invisible="1"/>
                <field name="list_price" invisible="1"/>
                <field name="compare_list_price" invisible="1"/>
                <field name="standard_price" invisible="1"/>
                <field name="mart_unit_text" invisible="1"/>
                <field name="mart_per_unit" invisible="1"/>
                <field name="mart_note" invisible="1"/>
                <field name="mart_home_tag" invisible="1"/>
                <field name="mart_features" invisible="1"/>
                <field name="mart_in_the_box" invisible="1"/>
                <field name="mart_material" invisible="1"/>
                <field name="mart_item_height" invisible="1"/>
                <field name="mart_item_length" invisible="1"/>
                <field name="mart_item_width" invisible="1"/>
                <field name="weight" invisible="1"/>
                <field name="description_ecommerce" invisible="1"/>
                <field name="mart_low_stock_at" invisible="1"/>
                <field name="mart_delivery_text" invisible="1"/>

                <widget name="mart369_product_editor"/>

                <separator string="Drawing (used only when the product has no photo)"/>
                <group name="mart369_drawing">
                    <group>
                        <field name="mart_art"/>
                        <field name="mart_color" widget="color"/>
                    </group>
                    <group>
                        <field name="mart_badge" placeholder="e.g. ATTA"/>
                    </group>
                </group>

                <separator string="Product page exceptions"/>
                <group>
                    <div colspan="2" class="text-muted small mb-2">
                        Every field follows the shop-wide setting unless it is
                        listed here - so this table is the exceptions, not the
                        page. To read the whole page, open it.
                    </div>
                    <!-- The way in. The screen takes a product in its context,
                         so it opens straight onto this one. -->
                    <button name="%(mart369_product.action_mart369_products)d"
                            type="action" colspan="2"
                            string="Open in 369 Mart &gt; Products"
                            class="btn-link" icon="fa-external-link"
                            context="{'mart369_product_id': id}"/>
                    <field name="mart_page_differs" string="Fields differing from the default"/>
                    <field name="mart_page_override_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="section_id" optional="show"/>
                            <field name="field_id"/>
                            <field name="state"/>
                            <field name="value"/>
                        </list>
                    </field>
                    <button name="action_mart_reset_page" type="object" colspan="2"
                            string="Put every field back to the shop default"
                            class="btn-link" icon="fa-undo"
                            invisible="mart_page_differs == 0"
                            confirm="This product will follow the shop-wide settings again. Any wording typed only for this product is removed."/>
                </group>
            </xpath>
            <!-- Everything it held is on General Information now, so the tab
                 would only be an empty page to click into. -->
            <xpath expr="//page[@name='mart369']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- General Information's old boxes. mart369_home puts its
         card boxes there (so it works without this module); with this module
         installed they are in the editor drawn just below instead, and
         showing both would put every box on the form twice. Inherits
         mart369_home's view so it runs after it and can find its nodes. -->
    <record id="mart369_product_general_info_inherit" model="ir.ui.view">
        <field name="name">product.template.form.mart369.general</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="mart369_home.mart369_product_template_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='mart369_home_card']/preceding-sibling::div[1]" position="replace"/>
            <xpath expr="//group[@name='mart369_home_card']" position="replace"/>
            <xpath expr="//group[@name='mart369_home_drawing']" position="replace"/>
        </field>
    </record>

</odoo>
