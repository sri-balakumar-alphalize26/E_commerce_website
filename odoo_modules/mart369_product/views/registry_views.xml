<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ fields -->
    <record id="mart369_product_field_view_list" model="ir.ui.view">
        <field name="name">mart369.product.field.list</field>
        <field name="model">mart369.product.field</field>
        <field name="arch" type="xml">
            <list default_order="section_id, sequence" default_group_by="section_id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key" optional="show"/>
                <field name="section_id" column_invisible="1"/>
                <field name="source" optional="show"/>
                <field name="default_value" optional="show" string="Default"/>
                <field name="override_count" string="Products differing" optional="show"/>
                <field name="note" optional="hide"/>
                <field name="show" string="Show in the app" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mart369_product_field_view_form" model="ir.ui.view">
        <field name="name">mart369.product.field.form</field>
        <field name="model">mart369.product.field</field>
        <field name="arch" type="xml">
            <form string="Product Page Field">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Manufacturer address"/></h1>
                        <field name="note" placeholder="A short reminder for whoever edits this"/>
                    </div>
                    <group>
                        <group string="Where it appears">
                            <field name="section_id"/>
                            <field name="sequence"/>
                            <field name="key" placeholder="e.g. manufacturer_address"/>
                        </group>
                        <group string="Shown to customers">
                            <field name="show"/>
                            <field name="per_product"/>
                            <field name="override_count"/>
                        </group>
                    </group>
                    <group string="Where the value comes from">
                        <field name="source" widget="radio"/>
                        <field name="odoo_field" invisible="source != 'odoo'"
                               required="source == 'odoo'"
                               placeholder="e.g. weight"/>
                        <field name="value_kind"/>
                        <field name="default_value" invisible="source != 'text'"
                               placeholder="Used for every product unless overridden"/>
                    </group>
                    <group string="Different for some categories">
                        <field name="category_value_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="public_categ_id"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mart369_product_field_view_search" model="ir.ui.view">
        <field name="name">mart369.product.field.search</field>
        <field name="model">mart369.product.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key"/>
                <filter string="Shown" name="shown" domain="[('show', '=', True)]"/>
                <filter string="Hidden" name="hidden" domain="[('show', '=', False)]"/>
                <separator/>
                <filter string="Some products differ" name="differing"
                        domain="[('override_count', '>', 0)]"/>
                <filter string="Section" name="group_section" context="{'group_by': 'section_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mart369_product_field" model="ir.actions.act_window">
        <field name="name">Page Fields</field>
        <field name="res_model">mart369.product.field</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_section': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything the product page can show</p>
            <p>
                Each row is one thing a customer can see. Switch it off here and
                it disappears from every product; a single product can still be
                set to always show or always hide it.
            </p>
        </field>
    </record>

    <!-- ========================================================== sections -->
    <record id="mart369_product_section_view_list" model="ir.ui.view">
        <field name="name">mart369.product.section.list</field>
        <field name="model">mart369.product.section</field>
        <field name="arch" type="xml">
            <list default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key" optional="show"/>
                <field name="note" optional="show"/>
                <field name="field_count" string="Fields shown"/>
                <field name="show" string="Show in the app" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mart369_product_section_view_form" model="ir.ui.view">
        <field name="name">mart369.product.section.form</field>
        <field name="model">mart369.product.section</field>
        <field name="arch" type="xml">
            <form string="Product Page Section">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <field name="note"/>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="show"/>
                            <field name="field_count"/>
                        </group>
                    </group>
                    <div class="text-muted small mb-2">
                        Switching this section off hides everything in it, on
                        every product, whatever the fields below say.
                    </div>
                    <field name="field_ids" nolabel="1">
                        <list editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="source"/>
                            <field name="default_value" string="Default"/>
                            <field name="show" string="Show" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mart369_product_section" model="ir.actions.act_window">
        <field name="name">Page Sections</field>
        <field name="res_model">mart369.product.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================================= category defaults -->
    <record id="mart369_product_category_value_view_list" model="ir.ui.view">
        <field name="name">mart369.product.category.value.list</field>
        <field name="model">mart369.product.category.value</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="public_categ_id, field_id">
                <field name="public_categ_id"/>
                <field name="section_id" optional="show"/>
                <field name="field_id"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="action_mart369_product_category_value" model="ir.actions.act_window">
        <field name="name">Wording by Category</field>
        <field name="res_model">mart369.product.category.value</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set wording once for a whole category</p>
            <p>
                Fresh fruit and headphones need different words for the same
                field - "Shelf life: 3-5 days, refrigerated" against
                "Warranty: 1 year". Set it here once instead of typing it on
                every product. A product can still override its category.
            </p>
        </field>
    </record>

</odoo>
