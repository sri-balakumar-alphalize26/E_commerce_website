<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_product.ProductBuilder">
        <Layout display="{ controlPanel: {} }" className="'o_mart369_builder'">
            <t t-set-slot="layout-buttons">
                <div class="mart-topbar">
                    <button class="mart-btn mart-btn-sm" t-on-click="() => this.backToEditor()">
                        <Icon n="'left'" size="13"/> The page
                    </button>
                    <div class="mart-modes">
                        <button t-attf-class="{{ state.tab === 'global' ? 'mart-on' : '' }}"
                                t-on-click="() => this.switchTab('global')">Whole shop</button>
                        <button t-attf-class="{{ state.tab === 'product' ? 'mart-on' : '' }}"
                                t-on-click="() => this.switchTab('product')">One product</button>
                    </div>
                    <span class="mart-status" t-att-data-state="state.status">
                        <i/>
                        <t t-if="state.status === 'saving'">Saving&#8230;</t>
                        <t t-elif="state.status === 'error'">Not saved</t>
                        <t t-else="">Saved</t>
                    </span>
                </div>
            </t>

            <div class="mart-builder" t-if="d">
                <div class="mart-stage">
                    <t t-call="mart369_product.Phone"/>
                    <div class="mart-legend">
                        <span t-if="state.tab === 'global'">Editing <b>every product</b></span>
                        <span t-else="">Editing <b>this product only</b></span>
                        <span><b>Click</b> a band to open its fields</span>
                        <span><b>Greyed</b> = hidden from customers</span>
                    </div>
                </div>
                <t t-call="mart369_product.Panel"/>
            </div>
        </Layout>
    </t>

    <!-- ============================================ the page, drawn as a phone
         The page body itself is shared with the desk editor - see
         page_reader.xml. This screen only supplies the frame and its own band
         wrapper, so the two screens draw one page. -->
    <t t-name="mart369_product.Phone">
        <div class="mart-phone">
            <div class="mart-phone-screen">
                <div class="mart-notch"/>
                <div class="mart-phone-scroll">
                    <div class="hm-page" data-mode="quick">
                        <div class="hm-wrap hm-view-product">
                            <t t-call="mart369_product.PageBody">
                                <t t-set="bandTpl" t-value="'mart369_product.Band'"/>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- One editable band: the overlay controls plus whichever body it draws -->
    <t t-name="mart369_product.Band">
        <div t-attf-class="mart-band {{ state.openSection === section.id ? 'mart-selected' : '' }} {{ section.show ? '' : 'mart-hidden' }}"
             t-on-click="() => this.openSection(section)">
            <span class="mart-band-label">
                <t t-if="!section.show">Hidden &#183; </t><t t-esc="section.name"/>
            </span>
            <div class="mart-band-tools">
                <span class="mart-count-chip" t-if="differing(section)">
                    <t t-esc="differing(section)"/> differ
                </span>
                <button class="mart-tool"
                        t-att-title="section.show ? 'Hide this whole section' : 'Show this whole section'"
                        t-on-click.stop="() => this.toggleSection(section)">
                    <t t-esc="section.show ? '&#128065;' : '&#128683;'"/>
                </button>
            </div>
            <div class="mart-band-body">
                <t t-call="{{ body }}"/>
            </div>
        </div>
    </t>

    <!-- ============================================================== panel -->
    <t t-name="mart369_product.Panel">
        <aside class="mart-panel">
            <t t-if="state.tab === 'product'" t-call="mart369_product.ProductPicker"/>
            <t t-set="section" t-value="openSectionRecord"/>
            <t t-if="section" t-call="mart369_product.SectionPanel"/>
            <div t-else="" class="mart-panel-empty">
                <div class="mart-empty-ic">&#128717;</div>
                <b>Click a band on the phone</b>
                Every part of the product page is there. Open one to switch its
                fields on or off.
                <br/><br/>
                <t t-if="state.tab === 'global'">
                    You are editing the <b>whole shop</b>. Switch to
                    <b>One product</b> to make a single product differ.
                </t>
                <t t-else="">
                    You are editing <b>one product</b>. Anything left on
                    <b>Follow the default</b> keeps up with the shop-wide
                    setting, now and later.
                </t>
            </div>
        </aside>
    </t>

    <t t-name="mart369_product.ProductPicker">
        <div class="mart-panel-head">
            <h3><span class="mart-panel-kicker">Editing</span><t t-esc="d.product ? d.product.name : 'Pick a product'"/></h3>
        </div>
        <div class="mart-panel-body" style="padding-bottom: 4px;">
            <div class="mart-field">
                <label>Change product</label>
                <input type="text" t-att-value="state.search.q" placeholder="Type a product name&#8230;"
                       t-on-input="(ev) => this.onSearchInput(ev)"/>
            </div>
            <div class="mart-search-results" t-if="state.search.results.length">
                <button t-foreach="state.search.results" t-as="p" t-key="p.id"
                        t-on-click="() => this.pickProduct(p.id)">
                    <span t-esc="p.display_name"/>
                </button>
            </div>
        </div>
    </t>

    <t t-name="mart369_product.SectionPanel">
        <div class="mart-panel-head">
            <h3><span class="mart-panel-kicker" t-esc="state.tab === 'global' ? 'Whole shop' : 'This product'"/><t t-esc="section.name"/></h3>
            <button class="mart-btn mart-btn-sm" t-on-click="() => this.toggleSection(section)">
                <t t-esc="section.show ? 'Hide section' : 'Show section'"/>
            </button>
        </div>
        <div class="mart-panel-body">
            <p class="mart-hint mb-3" t-if="section.note" t-esc="section.note"/>
            <div class="mart-warn" t-if="!section.show">
                This whole section is switched off, so none of these fields
                show &#8212; whatever they say individually.
            </div>

            <t t-foreach="rowsOf(section)" t-as="row" t-key="row.id">
                <div class="mart-fieldrow">
                    <div class="mart-fieldrow-head">
                        <b t-esc="row.name"/>
                        <label class="mart-switch" t-if="state.tab === 'global'">
                            <input type="checkbox" t-att-checked="row.show"
                                   t-on-change="() => this.toggleGlobal(row)"/>
                            Show
                        </label>
                        <small t-if="state.tab === 'product' and row.state !== 'follow'"
                               class="mart-differs">differs</small>
                    </div>
                    <div class="mart-hint" t-if="row.note" t-esc="row.note"/>

                    <div class="mart-radios" t-if="state.tab === 'product'">
                        <label t-foreach="STATES" t-as="st" t-key="st[0]"
                               t-attf-class="{{ row.state === st[0] ? 'mart-on' : '' }}">
                            <input type="radio" t-att-name="'st' + row.id" t-att-value="st[0]"
                                   t-att-checked="row.state === st[0]"
                                   t-on-change="() => this.setState(row, st[0])"/>
                            <t t-esc="st[1]"/>
                            <small t-if="st[0] === 'follow'" class="mart-hint">
                                (<t t-esc="row.show ? 'shown' : 'hidden'"/> right now)
                            </small>
                        </label>
                    </div>

                    <div class="mart-field" t-if="state.tab === 'global' and row.source === 'text'">
                        <label>Default wording</label>
                        <textarea t-if="row.value_kind === 'lines'" t-att-value="row.default_value"
                                  placeholder="One per line"
                                  t-on-input="(ev) => this.editDefault(row, ev)"/>
                        <input t-else="" type="text" t-att-value="row.default_value"
                               placeholder="Used for every product unless overridden"
                               t-on-input="(ev) => this.editDefault(row, ev)"/>
                        <span class="mart-hint">Set it per category under
                            <b>Advanced &#8594; Wording by Category</b>.</span>
                    </div>
                    <div class="mart-hint" t-if="row.source === 'odoo'">
                        Comes from the product's own <b t-esc="row.odoo_field"/> field.
                    </div>
                    <div class="mart-hint" t-if="row.source === 'computed'">
                        Worked out by the app.
                    </div>
                </div>
            </t>

            <div class="mart-actions" t-if="state.tab === 'product' and differing(section)">
                <button class="mart-btn" t-on-click="() => this.resetSection(section)">
                    Put these back to the shop default
                </button>
            </div>
        </div>
    </t>

</templates>
