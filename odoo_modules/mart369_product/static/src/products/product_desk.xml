<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_product.ProductDesk">
        <Layout display="{ controlPanel: {} }" className="'o_mart369_desk h-100'">
            <div class="mart-builder pe pr">

                <!-- ========================================== the editor -->
                <t t-if="state.form">
                    <!-- The sticky bar, as on the web admin. -->
                    <header class="pdk-bar">
                        <button class="mart-btn ad-sm" t-on-click="() => this.cancelForm()">
                            <Icon n="'left'" size="15"/> Back
                        </button>
                        <div class="pdk-bar-title">
                            <h2 t-esc="state.form.id ? 'Edit product' : 'New product'"/>
                            <small>
                                <t t-esc="formStatus.name or (state.form.id ? '' : 'Not saved yet')"/>
                                <em t-if="formStatus.dirty" class="pdk-unsaved">Unsaved changes</em>
                            </small>
                        </div>
                        <div class="pdk-bar-act">
                            <button class="mart-btn" t-att-disabled="state.saving" t-on-click="() => this.cancelForm()">Cancel</button>
                            <button class="mart-btn mart-btn-primary" t-att-disabled="state.saving"
                                    t-on-click="() => this.save()">
                                <Icon n="'check'" size="15"/>
                                <t t-esc="state.saving ? 'Saving...' : (state.form.id ? 'Save' : 'Create product')"/>
                            </button>
                        </div>
                    </header>

                    <p t-if="state.error" class="pe-error pdk-form-error" role="alert">
                        <t t-esc="state.error"/>
                    </p>

                    <!-- The same editor Odoo's own product form carries. -->
                    <ProductEditor t-key="state.form.key" data="state.form.data"
                                   currency="state.currency" status="formStatus"
                                   onReady="(editor) => this.editor = editor"/>
                </t>

                <!-- ============================================ the list -->
                <t t-elif="!state.open">
                    <!-- The list, drawn as the web admin's Products list
                         (components/admin/AdminCatalog.jsx), same classes.
                         No Quick/Express here: that is decided per customer,
                         by distance to the branch holding the stock. -->
                    <div class="pdk-listhead">
                        <div>
                            <h2>Products</h2>
                            <p>Every product in the shop. Open one to see what its page shows, or change its details and photographs.</p>
                        </div>
                        <button class="mart-btn mart-btn-primary pr-new" t-on-click="() => this.newProduct()">
                            <Icon n="'plus'" size="16"/> New product
                        </button>
                    </div>

                    <section t-if="state.tiles" class="ad-mini-stats pdk-tiles">
                        <span><small>Products</small><b t-esc="state.tiles.count or 0"/></span>
                        <span><small>Stock value</small><b t-esc="money(state.tiles.value or 0)"/></span>
                        <button type="button" t-attf-class="pdk-tile ad-warn {{ state.tab === 'low' ? 'pdk-on' : '' }}"
                                t-att-aria-pressed="state.tab === 'low' ? 'true' : 'false'"
                                t-on-click="() => this.toggleTab('low')">
                            <small>Low stock</small><b t-esc="state.tiles.low or 0"/>
                        </button>
                        <button type="button" t-attf-class="pdk-tile ad-bad {{ state.tab === 'out' ? 'pdk-on' : '' }}"
                                t-att-aria-pressed="state.tab === 'out' ? 'true' : 'false'"
                                t-on-click="() => this.toggleTab('out')">
                            <small>Out of stock</small><b t-esc="state.tiles.out or 0"/>
                        </button>
                    </section>
                    <p t-if="state.tiles and state.tiles.stock === false" class="ad-hint">
                        <Icon n="'info'" size="14"/> Inventory is not installed, so stock is not tracked.
                    </p>

                    <section class="ad-card pr-listcard">
                        <div class="ad-toolbar">
                            <Tabs t-if="state.tiles" tabs="tabItems" value="state.tab"
                                  onChange="(k) => this.setFilter('tab', k)"/>
                            <div class="ad-toolbar-right">
                                <Search value="state.q" placeholder="'Name or code'" label="'Search products'"
                                        onChange="(v) => this.onSearch(v)"/>
                                <Pick t-if="state.tiles" value="state.sort" options="SORTS" label="'Sort'"
                                      onChange="(v) => this.setFilter('sort', v)"/>
                                <div class="pdk-views" role="group" aria-label="View">
                                    <button type="button" t-attf-class="{{ state.view === 'kanban' ? 'pdk-on' : '' }}"
                                            t-att-aria-pressed="state.view === 'kanban' ? 'true' : 'false'"
                                            title="Cards" aria-label="Cards" t-on-click="() => this.setView('kanban')">
                                        <Icon n="'dash'" size="16"/>
                                    </button>
                                    <button type="button" t-attf-class="{{ state.view === 'list' ? 'pdk-on' : '' }}"
                                            t-att-aria-pressed="state.view === 'list' ? 'true' : 'false'"
                                            title="List" aria-label="List" t-on-click="() => this.setView('list')">
                                        <Icon n="'menu'" size="16"/>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="pdk-chips" role="group" aria-label="Category">
                            <button type="button" t-attf-class="pdk-chip {{ state.categ === null ? 'pdk-on' : '' }}"
                                    t-on-click="() => this.pickCateg(null)">All categories</button>
                            <button t-foreach="categChips" t-as="c" t-key="c.id" type="button"
                                    t-attf-class="pdk-chip {{ state.categ === c.id ? 'pdk-on' : '' }}"
                                    t-on-click="() => this.toggleCateg(c.id)" t-esc="c.label"/>
                            <button t-if="state.uncategorised" type="button"
                                    t-attf-class="pdk-chip {{ state.categ === 0 ? 'pdk-on' : '' }}"
                                    t-on-click="() => this.toggleCateg(0)">Uncategorised</button>
                        </div>

                        <p t-if="filtered and !state.loading" class="ad-hint pdk-why pr-why-pad">
                            <Icon n="'info'" size="14"/>
                            <span t-esc="matchLine"/>
                            <button type="button" class="mart-link" t-on-click="() => this.clearFilters()">Clear filters</button>
                        </p>

                        <p t-if="state.error" class="pe-error" role="alert">
                            We could not reach the shop. <t t-esc="state.error"/>
                            <button class="mart-link" t-on-click="() => this.load()">Try again</button>
                        </p>

                        <div class="ad-table-wrap">
                            <Empty t-if="state.loading and !state.products.length"
                                   icon="'layers'" title="'Loading...'" text="'Fetching products.'"/>
                            <Empty t-elif="!state.products.length" icon="'layers'" title="'No products match'"
                                   text="filtered ? 'Nothing matches. Clear a filter to see more.' : 'There are no products for sale yet.'"/>

                            <table t-elif="state.view === 'list'" class="ad-table pdk-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th class="ad-num">Price</th>
                                        <th class="ad-num">Sold / 7d</th>
                                        <th class="ad-num">In stock</th>
                                        <th>Live</th>
                                        <th/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.products" t-as="p" t-key="p.id"
                                        t-att-style="'--i: ' + (p_index % 12)"
                                        t-attf-class="{{ rowTone(p) }}"
                                        t-on-click="(ev) => this.onRowClick(ev, p)">
                                        <td>
                                            <span class="ad-cell-person">
                                                <span class="ad-thumb"><img t-att-src="imageOf(p)" alt="" loading="lazy"/></span>
                                                <span><b t-esc="p.name"/><small t-esc="unitCode(p)"/></span>
                                            </span>
                                        </td>
                                        <td><small t-esc="rowOf(p).cat or '-'"/></td>
                                        <td class="ad-num" t-esc="money(p.price)"/>
                                        <td class="ad-num" t-esc="rowOf(p).sold7 or 0"/>
                                        <td class="ad-num ad-strong" t-esc="qtyText(p)"/>
                                        <td>
                                            <span t-if="rowOf(p).active !== false" class="ad-pill ad-t-green"><i/>Live</span>
                                            <span t-else="" class="ad-pill ad-t-grey"><i/>Hidden</span>
                                        </td>
                                        <td class="ad-row-act pdk-row-act">
                                            <button class="ad-icon-btn" t-att-aria-label="'Edit ' + p.name" title="Edit"
                                                    t-on-click="() => this.openForm(p.id)"><Icon n="'pen'" size="15"/></button>
                                            <button class="ad-icon-btn" t-att-aria-label="'Details for ' + p.name"
                                                    t-on-click="() => this.open(p)"><Icon n="'right'" size="16"/></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div t-else="" class="pdk-cards">
                                <button t-foreach="state.products" t-as="p" t-key="p.id" type="button"
                                        t-attf-class="pdk-card {{ cardTone(p) }}"
                                        t-att-style="'--i: ' + (p_index % 12)"
                                        t-on-click="() => this.open(p)">
                                    <span class="pdk-card-img">
                                        <img t-if="imageOf(p)" t-att-src="imageOf(p)" alt="" loading="lazy"/>
                                        <Icon t-else="" n="'layers'" size="26"/>
                                        <em t-if="rowOf(p).active === false" class="pdk-card-flag">Hidden</em>
                                    </span>
                                    <span class="pdk-card-body">
                                        <b t-esc="p.name"/>
                                        <small t-esc="unitCat(p)"/>
                                        <span class="pdk-card-foot">
                                            <strong t-esc="money(p.price)"/>
                                            <span t-if="hasQty(p)" t-attf-class="ad-pill ad-t-{{ stockTone(p) }}">
                                                <i/><t t-esc="stockPill(p)"/>
                                            </span>
                                        </span>
                                    </span>
                                </button>
                            </div>
                        </div>
                    </section>
                </t>

                <!-- ========================================== one product -->
                <t t-else="">
                    <header class="pe-head pr-detail-head">
                        <button class="mart-btn pr-back" t-on-click="() => this.back()">
                            <Icon n="'left'" size="14"/> All products
                        </button>
                        <div class="pr-title">
                            <h1 t-esc="state.page ? state.page.product.name : state.open.name"/>
                            <p t-if="state.page">
                                <t t-esc="visibleRows"/> parts on its page
                                <t t-if="state.page.product.categories.length">
                                    · <t t-esc="state.page.product.categories.join(', ')"/>
                                </t>
                            </p>
                        </div>
                        <!-- Three ways on, and they are different jobs: the
                             product's own details here, everything Odoo holds
                             that this screen leaves out (taxes, costing,
                             routes, reordering) under All views, and what the
                             page prints under Edit page. -->
                        <button class="mart-btn" t-on-click="() => this.editProduct()">
                            All views
                        </button>
                        <button class="mart-btn" t-on-click="() => this.editDetails()">
                            Edit details
                        </button>
                        <button class="mart-btn mart-btn-primary"
                                t-on-click="() => this.edit()">
                            Edit page
                        </button>
                    </header>

                    <p t-if="state.error" class="pe-error" role="alert">
                        We could not reach the shop. <t t-esc="state.error"/>
                    </p>

                    <!-- Odoo's own figures for this product; each opens the
                         Odoo screen behind it. -->
                    <div t-if="statTiles.length" class="pr-stats">
                        <t t-foreach="statTiles" t-as="t" t-key="t.key">
                            <button t-if="t.open" type="button" class="pr-stat pr-stat-open"
                                    t-att-title="'Open ' + t.label + ' in Odoo'"
                                    t-on-click="() => this.openStat(t)">
                                <span t-esc="t.label"/>
                                <b t-esc="t.value"/>
                            </button>
                            <div t-else="" t-attf-class="pr-stat {{ t.bad ? 'pr-stat-bad' : '' }}">
                                <span t-esc="t.label"/>
                                <b t-esc="t.value"/>
                            </div>
                        </t>
                    </div>

                    <p class="pe-hintbar">
                        What this product's page shows, and where each line comes
                        from. The product's own details are under Edit details;
                        what the page prints is under Edit page.
                    </p>

                    <div class="pr-detail">
                        <Empty t-if="state.loading and !state.page"
                               icon="'box'" title="'Loading...'"
                               text="'Reading the page.'"/>

                        <Empty t-elif="state.page and !state.page.sections.length"
                               icon="'layers'" title="'No sections yet'"
                               text="'The product page has nothing on it to show.'"/>

                        <t t-elif="state.page">
                            <section t-foreach="state.page.sections" t-as="s" t-key="s.id"
                                     t-attf-class="pr-sec {{ s.show ? '' : 'pr-sec-off' }}">
                                <header class="pr-sec-head">
                                    <h2 t-esc="s.name"/>
                                    <!-- Switched off is said, not implied by
                                         absence: missing and hidden look the
                                         same, and only one is a decision. -->
                                    <span t-attf-class="mart-pill {{ s.show ? 'mart-t-grey' : 'mart-t-amber' }}">
                                        <i aria-hidden="true"/>
                                        <t t-esc="sectionNote(s)"/>
                                    </span>
                                </header>

                                <ul class="pr-rows">
                                    <li t-foreach="s.fields" t-as="f" t-key="f.id"
                                        t-attf-class="pr-row {{ (s.show and f.visible) ? '' : 'pr-row-off' }}">
                                        <span class="pr-row-name">
                                            <t t-esc="f.name"/>
                                            <Icon t-if="!(s.show and f.visible)"
                                                  n="'eye-off'" size="13"/>
                                        </span>
                                        <span class="pr-row-value" t-esc="valueOf(f)"/>
                                        <!-- Which layer won. An inherited value
                                             and one set on this product read the
                                             same without it. -->
                                        <span class="pr-row-from" t-esc="sourceLabel(f.source)"/>
                                    </li>
                                </ul>
                            </section>
                        </t>
                    </div>
                </t>

            </div>
        </Layout>
    </t>


</templates>
