<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369_product.ProductDesk">
        <Layout display="{ controlPanel: {} }" className="'o_mart369_desk h-100'">
            <div class="mart-builder pe pr">

                <!-- ========================================== the editor -->
                <t t-if="state.form">
                    <header class="pe-head pr-detail-head">
                        <button class="mart-btn pr-back" t-on-click="() => this.closeForm()">
                            <Icon n="'left'" size="14"/> Cancel
                        </button>
                        <div class="pr-title">
                            <h1 t-esc="state.form.id ? 'Edit product' : 'New product'"/>
                            <p t-if="!state.form.id">
                                Everything is offered until a category is chosen -
                                after that the page settings decide what is asked for.
                            </p>
                            <p t-else="">
                                The product's own details. What its page shows is
                                under Edit page.
                            </p>
                        </div>
                        <button class="mart-btn mart-btn-primary"
                                t-att-disabled="state.saving"
                                t-on-click="() => this.save()">
                            <t t-esc="state.saving ? 'Saving...' : 'Save'"/>
                        </button>
                    </header>

                    <p t-if="state.error" class="pe-error" role="alert">
                        <t t-esc="state.error"/>
                    </p>

                    <div class="pr-form">
                        <!-- Photographs first: it is the thing that was
                             impossible before and the first thing anybody
                             wants to do. -->
                        <section class="pr-sec">
                            <header class="pr-sec-head"><h2>Photographs</h2></header>
                            <div class="pr-photos">
                                <div class="pr-photo pr-photo-main">
                                    <img t-if="state.form.photo" t-att-src="state.form.photo" alt=""/>
                                    <span t-else="" class="pr-photo-none">No photograph</span>
                                    <label class="mart-btn">
                                        Choose
                                        <input type="file" accept="image/*" hidden=""
                                               t-on-change="(ev) => this.onPhoto(ev, true)"/>
                                    </label>
                                    <button t-if="state.form.photo" class="mart-link"
                                            t-on-click="() => this.clearPhoto()">Remove</button>
                                    <small>On the card</small>
                                </div>

                                <div t-foreach="state.form.photos" t-as="ph" t-key="ph.id"
                                     class="pr-photo">
                                    <img t-att-src="ph.url" alt=""/>
                                    <button class="mart-link"
                                            t-on-click="() => this.dropPhoto(ph)">Remove</button>
                                </div>
                                <div t-foreach="pendingPhotos" t-as="ph" t-key="ph_index"
                                     class="pr-photo pr-photo-new">
                                    <img t-att-src="ph.url" alt=""/>
                                    <button class="mart-link"
                                            t-on-click="() => this.dropPhoto(ph)">Remove</button>
                                    <small>Not saved yet</small>
                                </div>

                                <label class="pr-photo pr-photo-add">
                                    <span>+ Add photographs</span>
                                    <input type="file" accept="image/*" multiple="" hidden=""
                                           t-on-change="(ev) => this.onPhoto(ev, false)"/>
                                </label>
                            </div>
                            <p class="pr-hint">
                                The first is the picture on the card. The rest become
                                the gallery the shopper can swipe. With no photograph
                                at all the app draws its own artwork instead.
                            </p>
                        </section>

                        <section t-foreach="state.form.groups" t-as="g" t-key="g.title"
                                 class="pr-sec">
                            <header class="pr-sec-head"><h2 t-esc="g.title"/></header>
                            <div class="pr-fields">
                                <t t-foreach="g.boxes" t-as="b" t-key="b.name">
                                    <!-- Categories are a checklist, not a box:
                                         which ones a product is in decides
                                         what the rest of this form asks for. -->
                                    <label t-if="b.widget === 'categories'"
                                           class="mart-field pr-field-wide">
                                        <span t-esc="b.label"/>
                                        <div class="pr-categs">
                                            <button t-foreach="state.form.categories" t-as="c"
                                                    t-key="c.id" type="button"
                                                    t-attf-class="pr-categ {{ isChosen(c.id) ? 'mart-on' : '' }}"
                                                    t-att-aria-pressed="isChosen(c.id) ? 'true' : 'false'"
                                                    t-on-click="() => this.toggleCategory(c.id)">
                                                <t t-esc="c.name"/>
                                            </button>
                                        </div>
                                    </label>

                                    <label t-elif="b.widget === 'text' or b.widget === 'html'"
                                           class="mart-field pr-field-wide">
                                        <span t-esc="b.label"/>
                                        <textarea rows="4" t-att-value="state.form.values[b.name]"
                                                  t-on-input="(ev) => this.setField(b.name, ev.target.value)"/>
                                        <small t-if="b.help" t-esc="b.help"/>
                                    </label>

                                    <label t-elif="b.widget === 'number' or b.widget === 'integer'"
                                           class="mart-field">
                                        <span t-esc="b.label"/>
                                        <input type="number"
                                               t-att-step="b.widget === 'integer' ? '1' : '0.01'"
                                               t-att-value="state.form.values[b.name]"
                                               t-on-input="(ev) => this.setField(b.name, ev.target.value)"/>
                                        <small t-if="b.help" t-esc="b.help"/>
                                    </label>

                                    <label t-else="" class="mart-field">
                                        <span t-esc="b.label"/>
                                        <input type="text" t-att-value="state.form.values[b.name]"
                                               t-att-required="b.required ? 'required' : false"
                                               t-on-input="(ev) => this.setField(b.name, ev.target.value)"/>
                                        <small t-if="b.help" t-esc="b.help"/>
                                    </label>
                                </t>
                            </div>
                        </section>
                    </div>
                </t>

                <!-- ============================================ the list -->
                <t t-elif="!state.open">
                    <header class="pe-head">
                        <div>
                            <h1>Products</h1>
                            <p>Every product, and what its page will show.</p>
                        </div>
                    </header>

                    <div class="pe-toolbar pr-toolbar">
                        <Search value="state.q" placeholder="'A product name or code'"
                                label="'Search products'"
                                onChange="(v) => this.onSearch(v)"/>
                        <button class="mart-btn mart-btn-primary pr-new"
                                t-on-click="() => this.newProduct()">
                            New product
                        </button>
                        <div class="pe-toolbar-gap"/>
                        <span class="pr-count">
                            <t t-esc="state.total"/> of <t t-esc="state.allCount"/>
                        </span>
                        <!-- The same two Odoo offers on its own product list,
                             in the same order, so the icons mean what they
                             mean everywhere else in the backend. -->
                        <div class="pr-views" role="group" aria-label="View">
                            <button type="button"
                                    t-attf-class="{{ state.view === 'kanban' ? 'mart-on' : '' }}"
                                    t-att-aria-pressed="state.view === 'kanban' ? 'true' : 'false'"
                                    title="Cards" t-on-click="() => this.setView('kanban')">
                                <Icon n="'dash'" size="15"/>
                            </button>
                            <button type="button"
                                    t-attf-class="{{ state.view === 'list' ? 'mart-on' : '' }}"
                                    t-att-aria-pressed="state.view === 'list' ? 'true' : 'false'"
                                    title="List" t-on-click="() => this.setView('list')">
                                <Icon n="'menu'" size="15"/>
                            </button>
                        </div>
                    </div>

                    <p t-if="state.error" class="pe-error" role="alert">
                        We could not reach the shop. <t t-esc="state.error"/>
                        <button class="mart-link" t-on-click="() => this.load()">Try again</button>
                    </p>

                    <div class="pr-cols">
                        <!-- The rail. Its counts are the server's, rolled up
                             through the category tree. -->
                        <aside class="pr-rail" aria-label="Categories">
                            <button type="button"
                                    t-attf-class="pr-rail-row {{ state.categ === null ? 'mart-on' : '' }}"
                                    t-on-click="() => this.pickCateg(null)">
                                <span>All products</span>
                                <em t-esc="state.allCount"/>
                            </button>
                            <button t-foreach="topCategories" t-as="c" t-key="c.id"
                                    type="button"
                                    t-attf-class="pr-rail-row {{ state.categ === c.id ? 'mart-on' : '' }}"
                                    t-on-click="() => this.pickCateg(c.id)">
                                <span t-esc="c.name"/>
                                <em t-esc="c.count"/>
                            </button>
                            <button t-if="state.uncategorised" type="button"
                                    t-attf-class="pr-rail-row {{ state.categ === 0 ? 'mart-on' : '' }}"
                                    t-on-click="() => this.pickCateg(0)">
                                <span>Uncategorised</span>
                                <em t-esc="state.uncategorised"/>
                            </button>
                        </aside>

                        <div class="pr-main">
                            <Empty t-if="state.loading and !state.products.length"
                                   icon="'box'" title="'Loading...'"
                                   text="'Fetching the shop.'"/>

                            <Empty t-elif="!state.products.length"
                                   icon="'search'" title="'Nothing here'"
                                   text="'No published product matches that.'"/>

                            <!-- A table when there are columns worth lining
                                 up, cards when the picture is the point. -->
                            <table t-elif="state.view === 'list'" class="pr-list">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Code</th>
                                        <th>Category</th>
                                        <th class="pr-num">Price</th>
                                        <th>Page</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.products" t-as="p" t-key="p.id"
                                        t-on-click="() => this.open(p)">
                                        <td>
                                            <span class="pr-list-name">
                                                <span class="pr-list-img">
                                                    <img t-att-src="p.image" alt="" loading="lazy"/>
                                                </span>
                                                <b t-esc="p.name"/>
                                            </span>
                                        </td>
                                        <td class="pr-dim" t-esc="p.code or '-'"/>
                                        <td class="pr-dim" t-esc="p.categories.length ? p.categories.join(', ') : 'Uncategorised'"/>
                                        <td class="pr-num" t-esc="money(p.price)"/>
                                        <td>
                                            <span t-if="p.differs" class="mart-pill mart-t-blue">
                                                <i aria-hidden="true"/>
                                                <t t-esc="p.differs"/> changed
                                            </span>
                                            <span t-else="" class="pr-dim">Follows the shop</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div t-else="" class="pr-grid">
                                <button t-foreach="state.products" t-as="p" t-key="p.id"
                                        type="button" class="pr-card"
                                        t-att-style="'--i: ' + p_index"
                                        t-on-click="() => this.open(p)">
                                    <span class="pr-card-img">
                                        <img t-att-src="p.image" alt="" loading="lazy"/>
                                    </span>
                                    <span class="pr-card-body">
                                        <b t-esc="p.name"/>
                                        <small t-if="p.code" t-esc="p.code"/>
                                    </span>
                                    <!-- Customised, so it is worth opening. -->
                                    <span t-if="p.differs" class="mart-pill mart-t-blue pr-card-tag">
                                        <i aria-hidden="true"/>
                                        <t t-esc="p.differs"/> changed
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- ========================================== one product -->
                <t t-else="">
                    <header class="pe-head pr-detail-head">
                        <button class="mart-btn pr-back" t-on-click="() => this.back()">
                            <Icon n="'left'" size="14"/> All products
                        </button>
                        <div class="pr-title">
                            <h1 t-esc="state.page ? state.page.product.name : state.open.name"/>
                            <p t-if="state.page">
                                <t t-esc="visibleRows"/> parts on its page
                                <t t-if="state.page.product.categories.length">
                                    · <t t-esc="state.page.product.categories.join(', ')"/>
                                </t>
                            </p>
                        </div>
                        <!-- Three ways on, and they are different jobs: the
                             product's own details here, everything Odoo holds
                             that this screen leaves out (taxes, costing,
                             routes, reordering) under All views, and what the
                             page prints under Edit page. -->
                        <button class="mart-btn" t-on-click="() => this.editProduct()">
                            All views
                        </button>
                        <button class="mart-btn" t-on-click="() => this.editDetails()">
                            Edit details
                        </button>
                        <button class="mart-btn mart-btn-primary"
                                t-on-click="() => this.edit()">
                            Edit page
                        </button>
                    </header>

                    <p t-if="state.error" class="pe-error" role="alert">
                        We could not reach the shop. <t t-esc="state.error"/>
                    </p>

                    <p class="pe-hintbar">
                        What this product's page shows, and where each line comes
                        from. The product's own details are under Edit details;
                        what the page prints is under Edit page.
                    </p>

                    <div class="pr-detail">
                        <Empty t-if="state.loading and !state.page"
                               icon="'box'" title="'Loading...'"
                               text="'Reading the page.'"/>

                        <Empty t-elif="state.page and !state.page.sections.length"
                               icon="'layers'" title="'No sections yet'"
                               text="'The product page has nothing on it to show.'"/>

                        <t t-elif="state.page">
                            <section t-foreach="state.page.sections" t-as="s" t-key="s.id"
                                     t-attf-class="pr-sec {{ s.show ? '' : 'pr-sec-off' }}">
                                <header class="pr-sec-head">
                                    <h2 t-esc="s.name"/>
                                    <!-- Switched off is said, not implied by
                                         absence: missing and hidden look the
                                         same, and only one is a decision. -->
                                    <span t-attf-class="mart-pill {{ s.show ? 'mart-t-grey' : 'mart-t-amber' }}">
                                        <i aria-hidden="true"/>
                                        <t t-esc="sectionNote(s)"/>
                                    </span>
                                </header>

                                <ul class="pr-rows">
                                    <li t-foreach="s.fields" t-as="f" t-key="f.id"
                                        t-attf-class="pr-row {{ (s.show and f.visible) ? '' : 'pr-row-off' }}">
                                        <span class="pr-row-name">
                                            <t t-esc="f.name"/>
                                            <Icon t-if="!(s.show and f.visible)"
                                                  n="'eye-off'" size="13"/>
                                        </span>
                                        <span class="pr-row-value" t-esc="valueOf(f)"/>
                                        <!-- Which layer won. An inherited value
                                             and one set on this product read the
                                             same without it. -->
                                        <span class="pr-row-from" t-esc="sourceLabel(f.source)"/>
                                    </li>
                                </ul>
                            </section>
                        </t>
                    </div>
                </t>

            </div>
        </Layout>
    </t>

</templates>
