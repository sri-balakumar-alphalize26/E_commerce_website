<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- easy.sales -->
    <record id="view_easy_sales_form_wa_send" model="ir.ui.view">
        <field name="name">easy.sales.form.wa.send</field>
        <field name="model">easy.sales</field>
        <field name="inherit_id" ref="easy_sales.easy_sales_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_via_channels"
                        string="📱 Send via WhatsApp &amp; Email"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'cancelled'"
                        groups="whatsapp_gateway.group_whatsapp_user"/>
            </xpath>
        </field>
    </record>

