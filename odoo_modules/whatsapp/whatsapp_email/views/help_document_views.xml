<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Tree View (admin) -->
    <!-- ============================================================ -->
    <record id="view_help_document_tree" model="ir.ui.view">
        <field name="name">whatsapp.help.document.tree</field>
        <field name="model">whatsapp.help.document</field>
        <field name="arch" type="xml">
            <list string="Help Documents">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="description"/>
                <field name="pdf_filename" string="PDF"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form View (admin) -->
    <!-- ============================================================ -->
    <record id="view_help_document_form" model="ir.ui.view">
        <field name="name">whatsapp.help.document.form</field>
        <field name="model">whatsapp.help.document</field>
        <field name="arch" type="xml">
            <form string="Help Document">
                <div class="alert alert-info" role="alert" style="margin-bottom:0;">
                    Upload a <strong>PDF</strong> (and optionally write HTML content).
                    It appears as a card in the <strong>Help</strong> menu;
                    "Open guide" shows it in the browser and "Open in PDF doc" opens the full PDF.
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="icon" placeholder="e.g. emoji character"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="PDF"/>
                    <group>
                        <field name="pdf_file" filename="pdf_filename"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="static_pdf_url" placeholder="/whatsapp_gateway/static/doc/manual.pdf"/>
                    </group>
                    <separator string="HTML Content (optional — shown instead of the PDF on 'Open Guide')"/>
                    <field name="html_content"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action: Admin list/form -->
    <!-- ============================================================ -->
    <record id="action_help_document_admin" model="ir.actions.act_window">
        <field name="name">Help Documents</field>
        <field name="res_model">whatsapp.help.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Action: User-facing help page (client action) -->
    <!-- ============================================================ -->
    <record id="action_help_document_page" model="ir.actions.client">
        <field name="name">Help</field>
        <field name="tag">whatsapp_gateway.help_documents</field>
    </record>

</odoo>
