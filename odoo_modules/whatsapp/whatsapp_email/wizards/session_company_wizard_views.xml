<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_session_company_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.session.company.wizard.form</field>
        <field name="model">whatsapp.session.company.wizard</field>
        <field name="arch" type="xml">
            <form string="Change company">
                <field name="session_id" invisible="1"/>
                <field name="allowed_company_ids" invisible="1"/>
                <group>
                    <field name="current_company_id" readonly="1"/>
                    <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not summary">
                    <b>Please check - this is what will change:</b>
                    <field name="summary" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="not company_id"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
