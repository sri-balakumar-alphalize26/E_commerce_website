<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No `res.groups.privilege` record and no `privilege_id` here, on purpose.
        369ai 19 changed that shape partway through its life and this file has to
        load on either side of the change - see _link_groups_to_app() in this
        module's __init__.py, which does the filing afterwards against whatever
        the running build actually has.
    -->
    <data noupdate="1">

        <record id="module_category_whatsapp" model="ir.module.category">
            <field name="name">WhatsApp</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_whatsapp_user" model="res.groups">
            <field name="name">WhatsApp User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_whatsapp_manager" model="res.groups">
            <field name="name">WhatsApp Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
