<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_optout_list" model="ir.ui.view">
        <field name="name">whatsapp.optout.list</field>
        <field name="model">whatsapp.optout</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Opted Out"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_optout_form" model="ir.ui.view">
        <field name="name">whatsapp.optout.form</field>
        <field name="model">whatsapp.optout</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="phone"/>
                        <h1><field name="phone" placeholder="968XXXXXXXX"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        Archive this only if the person has asked to hear from
                        us again. The number is shared between clients, so an
                        opt-out covers all of them - it has to, because what
                        the recipient actually blocked was this one number.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_optout" model="ir.actions.act_window">
        <field name="name">Opted Out</field>
        <field name="res_model">whatsapp.optout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nobody has opted out
            </p>
            <p>
                Numbers land here automatically when someone replies STOP, and
                are never messaged again.
            </p>
        </field>
    </record>

</odoo>
