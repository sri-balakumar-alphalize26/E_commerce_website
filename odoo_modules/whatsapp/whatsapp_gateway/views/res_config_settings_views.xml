<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > WhatsApp: the panel address + the vendor's link token. -->
    <record id="res_config_settings_view_form_whatsapp_gateway" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp.gateway</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp" string="WhatsApp" name="whatsapp_gateway"
                     logo="/whatsapp_gateway/static/description/icon.png" groups="base.group_system">
                    <block title="WhatsApp panel" id="whatsapp_gateway_panel_block">
                        <setting id="wa_panel_link" string="Link this database"
                                 help="The address of your WhatsApp panel and your vendor's link token. Once per database; WhatsApp and Email, WA Tracker and Sales Automation all use this link.">
                            <field name="wa_linked" invisible="1"/>
                            <div class="mt-2">
                                <div class="o_wa_link_ok" invisible="not wa_linked">
                                    <span class="o_wa_link_dot"/> <field name="wa_link_text" readonly="1" nolabel="1" class="oe_inline fw-bold"/>
                                </div>
                                <div class="text-warning" invisible="wa_linked">
                                    <i class="fa fa-exclamation-triangle"/> Not linked yet - type the address, paste the token: it links at once.
                                </div>
                            </div>
                            <div class="row mt-2">
                                <label for="wa_panel_url" class="col-lg-4 o_light_label"/>
                                <field name="wa_panel_url" class="col-lg-8" placeholder="http://127.0.0.1:8086"/>
                            </div>
                            <div class="row mt-2">
                                <label for="wa_link_token" class="col-lg-4 o_light_label"/>
                                <field name="wa_link_token" class="col-lg-8" password="True" placeholder="paste the vendor's link token"/>
                            </div>
                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <button name="action_wa_link" type="object" string="Link again" class="btn-secondary" icon="fa-link"
                                        invisible="not wa_linked"/>
                                <button name="action_wa_help" type="object" string="Help (steps + videos)" class="btn-link" icon="fa-question-circle"/>
                            </div>
                        </setting>
                        <setting id="wa_panel_numbers" string="WhatsApp numbers"
                                 help="Numbers of this database. Connect one per company or employee, then give it its e-mail.">
                            <div class="mt-2"><field name="wa_number_count" readonly="1" class="oe_inline"/> connected</div>
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <button name="action_wa_connect" type="object" string="+ Connect a number" class="btn-secondary"/>
                                <button name="action_wa_numbers" type="object" string="Open the numbers" class="btn-link" icon="fa-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
