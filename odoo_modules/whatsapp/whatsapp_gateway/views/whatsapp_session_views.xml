<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SESSION FORM ============
         No Connect button and no QR block. Pairing happens once on the
         gateway; a QR here would be a second, competing source of truth.
    -->
    <record id="view_whatsapp_session_form" model="ir.ui.view">
        <field name="name">whatsapp.session.form</field>
        <field name="model">whatsapp.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-primary"
                            invisible="status not in ('connected', 'error')"/>
                    <button name="action_connect_screen"
                            string="Scan QR"
                            type="object"
                            class="btn-primary"
                            invisible="status in ('connected', 'error') or not id"
                            groups="base.group_system"/>
                    <button name="action_check_again"
                            string="Check again"
                            type="object"
                            class="btn-secondary"
                            invisible="status == 'connected' or not id or not active"/>
                    <button name="action_fetch_config"
                            string="Load Settings"
                            type="object"
                            class="btn-secondary"
                            invisible="status != 'connected'"
                            help="Ask the panel which number and name this database should use."/>
                    <button name="action_add_email"
                            string="Add email"
                            type="object"
                            class="btn-secondary"
                            invisible="not id or not active or not gateway_api_key or authorized_email"
                            groups="base.group_system"
                            help="Give this number (its company) its own e-mail account. The password stays on the panel."/>
                    <button name="action_add_email"
                            string="Change email"
                            type="object"
                            class="btn-secondary"
                            invisible="not id or not active or not gateway_api_key or not authorized_email"
                            groups="base.group_system"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="disconnected,connecting,connected,wrong_number"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comments">
                            <field name="message_count"
                                   widget="statinfo"
                                   string="Messages"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Company WhatsApp"/>
                        </h1>
                    </div>
                    <div name="number_facts"/>
                    <!-- one line for "not linked": the steps are shown for what else is missing -->
                    <div invisible="not id or not active or not setup_next or setup_next == 'phone'" class="alert alert-info" role="status">
                        <field name="setup_next" invisible="1"/>
                        <field name="setup_text" readonly="1" nolabel="1"/>
                        <div name="setup_buttons" class="mt-2">
                            <button name="action_fetch_config" type="object" string="Load Settings"
                                    class="btn-primary" invisible="setup_next != 'settings'"/>
                        </div>
                    </div>
                    <div invisible="status != 'wrong_number'" class="alert alert-danger" role="alert">
                        <b>Wrong phone.</b> It was logged out again. Scan with
                        <field name="shown_number" readonly="1" nolabel="1" class="oe_inline"/>.
                    </div>
                    <div invisible="not id or not active or status in ('connected', 'wrong_number', 'error') or setup_next in ('key', 'settings')"
                         class="alert alert-warning" role="alert">
                        <b>Not linked.</b> Scan with
                        <field name="shown_number" readonly="1" nolabel="1" class="oe_inline"/>.
                        <div invisible="not error_message"><field name="error_message" readonly="1" nolabel="1"/></div>
                    </div>
                    <div invisible="status != 'error' and (not error_message or status in ('disconnected', 'connecting', 'waiting_qr'))"
                         class="alert alert-danger" role="alert">
                        <span invisible="error_message">The WhatsApp panel cannot be reached.</span>
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <div invisible="not number_mismatch" class="alert alert-warning" role="alert" groups="base.group_system">
                        <field name="number_mismatch" readonly="1" nolabel="1"/>
                    </div>
                    <div invisible="not waiting_count" class="alert alert-warning" role="status">
                        <field name="waiting_count" invisible="1"/>
                        <field name="waiting_text" readonly="1" nolabel="1" class="d-inline"/>
                        <button name="action_drop_waiting" type="object" string="Do not send them"
                                class="btn-secondary ms-2" groups="base.group_system"
                                confirm="These messages will never be sent. They stay in the list as failed. Go on?"/>
                    </div>

                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group string="Number">
                                    <!-- a new one starts with its key; afterwards it is in Technical -->
                                    <field name="gateway_api_key" password="True"
                                           string="Setup Key" groups="base.group_system"
                                           invisible="id and setup_next != 'key'"
                                           placeholder="wa1_... paste from the panel and save"/>
                                    <field name="shown_number" string="Number" readonly="1" invisible="not id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="active" invisible="1"/>
                                </group>
                                <group string="Channels">
                                    <field name="use_whatsapp"/>
                                    <field name="use_email"/>
                                    <field name="authorized_email" string="Email from" readonly="1"
                                           invisible="not id" placeholder="no e-mail yet: press Add email"/>
                                    <field name="route_odoo_mail" groups="base.group_system"/>
                                </group>
                            </group>
                            <div name="general_more"/>
                            <separator string="Messages"/>
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Time"/>
                                    <field name="direction"/>
                                    <field name="phone"/>
                                    <field name="partner_id"/>
                                    <field name="message"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_system">
                            <group>
                                <group string="Connection">
                                    <field name="is_activated" widget="boolean_toggle" readonly="1"/>
                                    <field name="gateway_api_key" password="True"
                                           string="Setup Key" invisible="not id or setup_next == 'key'"
                                           placeholder="wa1_... paste from the panel and save"/>
                                    <field name="gateway_url" readonly="1"/>
                                    <field name="instance_name" readonly="1"/>
                                    <field name="phone_number" readonly="1"/>
                                    <field name="authorized_number" readonly="1"/>
                                    <field name="authorized_email" readonly="1"/>
                                    <field name="tenant_label" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="status">
                                Shown for reference only. The gateway enforces the
                                real limits - the daily cap, the sending rate, the
                                opt-out list and blocked words - on the server,
                                where no 369ai database can get around them.
                                Change them in the WhatsApp panel.
                            </div>
                            <group>
                                <group string="Limits">
                                    <field name="send_delay_ms" readonly="1"/>
                                    <field name="daily_cap" readonly="1"/>
                                    <field name="dedupe_minutes" readonly="1"/>
                                </group>
                            </group>
                            <group string="Incoming">
                                <field name="webhook_url" readonly="1"
                                       widget="CopyClipboardChar"/>
                                <field name="webhook_secret"
                                       groups="base.group_no_one"/>
                                <field name="state_checked" readonly="1"
                                       groups="base.group_no_one"/>
                            </group>
                            <div class="text-muted">
                                Nothing to press. This address is sent to the panel
                                with <b>Load Settings</b> (and every few minutes by
                                the cron); the panel forwards every incoming message
                                on this database's number here, with an
                                <code>X-Odoo-Database</code> header naming this
                                database. A number shared by several databases
                                delivers to all of them.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ SESSION LIST ============ -->
    <record id="view_whatsapp_session_list" model="ir.ui.view">
        <field name="name">whatsapp.session.list</field>
        <field name="model">whatsapp.session</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Numbers" create="false" delete="false" decoration-muted="not active">
                <field name="active" column_invisible="True"/>
                <field name="removed" column_invisible="True"/>
                <header>
                    <button name="action_connect_new" type="object" display="always"
                            string="+ Connect a number" class="btn-primary"
                            groups="base.group_system"/>
                    <button name="action_check_connection" type="object" display="always"
                            string="Check connection" groups="base.group_system"/>
                    <button name="action_link_panel" type="object" display="always"
                            string="Link to WhatsApp panel" icon="fa-link" groups="base.group_system"/>
                    <button name="action_open_help" type="object" display="always"
                            string="Help (steps + videos)" icon="fa-question-circle"/>
                </header>
                <field name="name" string="Name"/>
                <field name="shown_number" string="Number"/>
                <field name="authorized_number" column_invisible="True"/>
                <field name="phone_number" optional="hide"/>
                <field name="instance_name" optional="hide"/>
                <field name="tenant_label" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="show"/>
                <field name="authorized_email" string="Email" optional="show"/>
                <field name="status" widget="badge" invisible="not active"
                       decoration-success="status == 'connected'"
                       decoration-danger="status in ('wrong_number', 'error', 'disconnected')"
                       decoration-warning="status in ('connecting', 'waiting_qr')"/>
                <field name="switched_to" string="Switched" optional="show" decoration-info="switched_to"/>
                <field name="message_count" string="Messages" optional="show"/>
                <button name="action_switch_back" type="object" string="Switch back"
                        class="btn-primary" invisible="active or removed or not switched_to" groups="base.group_system"/>
                <button name="action_connect_screen" type="object" string="Scan again"
                        class="btn-secondary" invisible="status in ('connected', 'error') or not active"
                        groups="base.group_system"/>
                <button name="action_check_again" type="object" string="Check again"
                        class="btn-secondary" invisible="status == 'connected' or not active"/>
                <button name="action_turn_off" type="object" string="Turn off"
                        class="btn-secondary" invisible="not active" groups="base.group_system"/>
                <button name="action_turn_on" type="object" string="Turn on"
                        class="btn-primary" invisible="active or removed or switched_to" groups="base.group_system"/>
                <button name="action_remove_number" type="object" string="Remove"
                        class="btn-link text-danger" invisible="removed" groups="base.group_system"/>
            </list>
        </field>
    </record>

    <!-- ============ SESSION ACTION ============ -->
    <record id="action_whatsapp_session" model="ir.actions.act_window">
        <field name="name">WhatsApp Numbers</field>
        <field name="res_model">whatsapp.session</field>
        <field name="domain">[('removed', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect your first WhatsApp number
            </p>
            <p>
                Press <b>+ Connect a number</b>: choose the country, type the
                number, scan the QR.
            </p>
        </field>
    </record>

    <record id="action_whatsapp_connect" model="ir.actions.client">
        <field name="name">Connect a number</field>
        <field name="tag">whatsapp_gateway.connect</field>
    </record>

</odoo>
