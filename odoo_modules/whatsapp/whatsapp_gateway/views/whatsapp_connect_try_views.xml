<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_connect_try_list" model="ir.ui.view">
        <field name="name">whatsapp.connect.try.list</field>
        <field name="model">whatsapp.connect.try</field>
        <field name="arch" type="xml">
            <list string="Failed Connections" create="false" edit="false">
                <field name="create_date" string="When"/>
                <field name="number"/>
                <field name="step"/>
                <field name="error"/>
                <field name="create_uid" string="Who"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_connect_try" model="ir.actions.act_window">
        <field name="name">Failed Connections</field>
        <field name="res_model">whatsapp.connect.try</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No failed tries</p>
            <p>When a number cannot be connected, the reason is kept here for 90 days.</p>
        </field>
    </record>

</odoo>
