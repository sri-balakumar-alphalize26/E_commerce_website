    <!-- 26 Nov 2026: the top-right branch switch. Only the switched-on branches
         are seen, by everyone, the managers too. -->
    <record id="rule_wa_employee_session_branch" model="ir.rule">
        <field name="name">WhatsApp employee_session: switched-on branches</field>
        <field name="model_id" ref="model_wa_employee_session"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
