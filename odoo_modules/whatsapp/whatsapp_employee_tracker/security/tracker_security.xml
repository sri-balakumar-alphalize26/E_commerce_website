<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_wa_tracker_manager" model="res.groups">
        <field name="name">WA Tracker Manager</field>
        <field name="comment">Full access to monitor all employees WhatsApp communications.</field>
    </record>

    <record id="group_wa_tracker_dept_head" model="res.groups">
        <field name="name">WA Tracker Department Head</field>
        <field name="comment">View WhatsApp tracking data for employees in their department only.</field>
    </record>


    <!-- Administration > Settings gets these menus without a hand-tick on
         every new database: the admin group implies the module's manager group. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wa_tracker_manager'))]"/>
    </record>

    <!-- 24 Nov 2026: what was written is the managers', and the employee's own -->
    <record id="rule_wa_communication_log_own" model="ir.rule">
        <field name="name">WhatsApp communication_log: own number</field>
        <field name="model_id" ref="model_wa_communication_log"/>
        <field name="domain_force">[('employee_session_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_wa_communication_log_department" model="ir.rule">
        <field name="name">WhatsApp communication_log: own department</field>
        <field name="model_id" ref="model_wa_communication_log"/>
        <field name="domain_force">[('employee_session_id.employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_wa_tracker_dept_head'))]"/>
    </record>
    <record id="rule_wa_communication_log_manager" model="ir.rule">
        <field name="name">WhatsApp communication_log: managers all</field>
        <field name="model_id" ref="model_wa_communication_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wa_tracker_manager'))]"/>
    </record>

