<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Employee Session: Kanban View -->
    <!-- ============================================================ -->
    <record id="view_wa_employee_session_kanban_config" model="ir.ui.view">
        <field name="name">wa.employee.session.kanban.config</field>
        <field name="model">wa.employee.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="phone_number"/>
                <field name="session_id"/>
                <field name="session_status"/>
                <field name="monitoring_enabled"/>
                <field name="total_messages"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center p-2">
                            <i class="fa fa-user-circle fa-2x text-primary me-3"/>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <strong><field name="employee_id"/></strong>
                                    <span t-if="record.session_status.raw_value == 'connected'" class="badge bg-success">Connected</span>
                                    <span t-elif="record.session_status.raw_value == 'disconnected'" class="badge bg-danger">Disconnected</span>
                                    <span t-else="" class="badge bg-warning">Waiting QR</span>
                                </div>
                                <div class="text-muted small"><field name="department_id"/></div>
                                <div class="small mt-1">
                                    <i class="fa fa-whatsapp text-success me-1"/><field name="phone_number"/>
                                    <span class="ms-2"><i class="fa fa-comments text-primary me-1"/><field name="total_messages"/> msgs</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Employee Session: List View -->
    <!-- ============================================================ -->
    <record id="view_wa_employee_session_list" model="ir.ui.view">
        <field name="name">wa.employee.session.list</field>
        <field name="model">wa.employee.session</field>
        <field name="arch" type="xml">
            <list string="Employee WhatsApp Sessions" decoration-muted="not session_active">
                <header>
                    <button name="action_connect_new" type="object" display="always"
                            string="+ Connect a number" class="btn-primary" groups="base.group_system"/>
                </header>
                <field name="session_active" column_invisible="True"/>
                <field name="employee_id"/>
                <field name="department_id" optional="hide"/>
                <field name="job_title" optional="hide"/>
                <field name="phone_number" widget="wa_phone" readonly="1"/>
                <field name="session_id"/>
                <field name="session_status" widget="badge"
                       decoration-success="session_status == 'connected'"
                       decoration-warning="session_status in ('connecting', 'waiting_qr')"
                       decoration-danger="session_status in ('wrong_number', 'error', 'disconnected')"/>
                <field name="link_text" string="To do" optional="show"/>
                <field name="today_sent" string="Sent Today" optional="show"/>
                <field name="today_received" string="Recv Today" optional="show"/>
                <field name="total_messages" optional="show"/>
                <field name="unique_contacts" optional="hide"/>
                <field name="alert_count" optional="hide"/>
                <field name="quality_score" optional="hide"/>
                <field name="last_activity" optional="show"/>
                <field name="monitoring_enabled" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Employee Session: Form View -->
    <!-- ============================================================ -->
    <record id="view_wa_employee_session_form" model="ir.ui.view">
        <field name="name">wa.employee.session.form</field>
        <field name="model">wa.employee.session</field>
        <field name="arch" type="xml">
            <form string="Employee WhatsApp Session">
                <header>
                    <button name="action_refresh_stats"
                            string="Refresh Stats"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                    <button name="action_full_history" string="Full history" type="object" icon="fa-comments"/>
                    <button name="action_other_employee" string="Other employee" type="object"
                            invisible="not active" groups="base.group_system"
                            confirm="The chats until now stay with this employee. From now on the number is somebody else's. Go on?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-comments">
                            <field name="total_messages" widget="statinfo" string="Messages"/>
                        </button>
                        <button name="action_view_conversations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="unique_contacts" widget="statinfo" string="Contacts"/>
                        </button>
                        <button name="action_view_alerts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                        <button name="action_view_quality_scores"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-star">
                            <field name="quality_score" widget="statinfo" string="Quality"/>
                        </button>
                    </div>

                    <div invisible="not link_text" class="alert alert-warning" role="status">
                        <field name="link_text" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Employee Details">
                            <field name="has_chats" invisible="1"/>
                            <field name="employee_id" readonly="has_chats"/>
                            <field name="since"/>
                            <field name="until" invisible="not until"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="job_title"/>
                        </group>
                        <group string="WhatsApp Assignment">
                            <field name="session_number" invisible="1"/>
                            <field name="free_session_ids" invisible="1"/>
                            <field name="session_id" readonly="has_chats" domain="[('id', 'in', free_session_ids)]"
                                   context="{'wa_number_in_name': True}" options="{'no_create': True}"/>
                            <field name="phone_number" widget="wa_phone" options="{'plus': True}"
                                   readonly="session_number or has_chats" force_save="1"/>
                            <field name="session_status"/>
                            <field name="monitoring_enabled"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Today" name="today">
                            <group>
                                <group string="Today">
                                    <field name="today_sent"/>
                                    <field name="today_received"/>
                                </group>
                                <group string="Overall">
                                    <field name="total_sent"/>
                                    <field name="total_received"/>
                                    <field name="avg_response_minutes"/>
                                    <field name="last_activity"/>
                                </group>
                            </group>
                        </page>
                        <page string="Conversations" name="conversations">
                            <button name="action_view_conversations"
                                    string="Open All Conversations"
                                    type="object"
                                    class="btn-primary mb-3"
                                    icon="fa-comments"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                        <page string="Auto Reply" name="auto_reply">
                            <group>
                                <group string="Settings">
                                    <field name="auto_reply_enabled"/>
                                    <field name="auto_reply_timeout"
                                           invisible="not auto_reply_enabled"/>
                                    <field name="auto_reply_max_products"
                                           invisible="not auto_reply_enabled"/>
                                    <field name="auto_reply_bargain_enabled"
                                           invisible="not auto_reply_enabled"/>
                                </group>
                                <group string="Messages" invisible="not auto_reply_enabled">
                                    <field name="auto_reply_greeting"/>
                                    <field name="auto_reply_no_match"/>
                                </group>
                                <group string="Checkout" invisible="not auto_reply_enabled">
                                    <field name="auto_reply_hide_quantity"/>
                                    <field name="auto_reply_stock_restrict"/>
                                    <field name="auto_reply_ask_delivery"/>
                                    <field name="auto_reply_payment_enabled"/>
                                    <field name="auto_reply_cod_enabled"/>
                                    <field name="auto_reply_auto_invoice"/>
                                    <field name="auto_reply_company_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wa_employee_session_search" model="ir.ui.view">
        <field name="name">wa.employee.session.search</field>
        <field name="model">wa.employee.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="phone_number"/>
                <filter name="not_connected" string="Not connected" domain="[('session_id.status', '!=', 'connected')]"/>
                <filter name="session_off" string="WhatsApp session off" domain="[('session_id.active', '=', False)]"/>
                <separator/>
                <filter name="with_old" string="Old numbers too" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <filter name="only_old" string="Old numbers" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_wa_employee_handover_form" model="ir.ui.view">
        <field name="name">wa.employee.handover.form</field>
        <field name="model">wa.employee.handover</field>
        <field name="arch" type="xml">
            <form string="Other employee">
                <group>
                    <field name="session_id"/>
                    <field name="employee_id" options="{'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_do" type="object" string="From now on" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action -->
    <!-- ============================================================ -->
    <record id="action_wa_employee_session" model="ir.actions.act_window">
        <field name="name">Employee Sessions</field>
        <field name="res_model">wa.employee.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wa_employee_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign WhatsApp sessions to employees
            </p>
        </field>
    </record>

</odoo>
