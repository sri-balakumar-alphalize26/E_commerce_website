<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 27 Nov 2026: ONE Help in the top menu. It opens the WhatsApp Help pop-up
         on static/help/help.html: two choices, "User Manual" (PDF) and "How It
         Works" (steps, with the video inside). A tap asks "Open here" (pop-up, Back
         to the choices) or "Open in a new tab"; the pop-up's X closes it.
         ?v=14 in the url: browsers keep static pages 7 days - bump it with changes.
         The old "User Guide" (Configuration) and the small Odoo form are gone:
         removing their records here deletes them on upgrade. -->
    <record id="action_wa_tracker_help_centre" model="ir.actions.client">
        <field name="name">WA Tracker Help</field>
        <field name="tag">whatsapp_employee_tracker.help</field>
        <field name="params" eval="{'url': '/whatsapp_employee_tracker/static/help/help.html?v=14'}"/>
    </record>

    <menuitem id="menu_wa_tracker_help"
              name="Help"
              parent="menu_wa_tracker_root"
              action="action_wa_tracker_help_centre"
              sequence="99"/>
</odoo>
