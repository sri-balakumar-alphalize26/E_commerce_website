import logging
from odoo import models, fields

_logger = logging.getLogger(__name__)


class SaleOrder(models.Model):
    _inherit = 'sale.order'

    wa_conversation_id = fields.Many2one('wa.conversation', string='WA Conversation')
    wa_employee_session_id = fields.Many2one('wa.employee.session', string='WA Employee Session')
    wa_payment_mode = fields.Selection([
        ('online', 'Online'),
        ('cod', 'Cash on Delivery'),
    ], string='WA Payment Mode')

    def _wa_finalize(self, paid=True):
        """Confirm SO, create+post invoice, optionally register payment,
        and send the invoice PDF to the WhatsApp chat."""
        self.ensure_one()
        try:
            if self.state in ('draft', 'sent'):
                self.action_confirm()
            inv = self.invoice_ids.filtered(
                lambda m: m.move_type == 'out_invoice' and m.state != 'cancel')
            if not inv:
                inv = self._create_invoices()
            inv.filtered(lambda m: m.state == 'draft').action_post()
            if paid:
                reg = self.env['account.payment.register'].sudo().with_context(
                    active_model='account.move', active_ids=inv.ids).create({})
                reg._create_payments()
                self.wa_payment_mode = 'online'
            pdf, _x = self.env['ir.actions.report'].sudo()._render_qweb_pdf(
                'account.account_invoices', inv.ids)
            sess = self.wa_employee_session_id
            phone = (self.wa_conversation_id.phone if self.wa_conversation_id else '') \
                or self.partner_id.phone or ''
            fname = ((inv[:1].name or 'Invoice').replace('/', '_')) + '.pdf'
            if sess and phone:
                sess.session_id.send_document(
                    phone, pdf, fname, caption='Invoice (Paid)' if paid else 'Invoice')
            return True
        except Exception as e:
            _logger.error("WA finalize SO %s failed: %s", self.id, e)
            return False
