<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_employee_tracker.Dashboard" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <!-- numbers of this database that nobody has yet -->
            <div t-if="wa.free.length" class="d-flex flex-wrap gap-3 p-3 pb-0">
                <div t-foreach="wa.free" t-as="n" t-key="n.id" class="bg-view border p-3" style="border-radius: 12px; width: 360px; max-width: 100%;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-user-o fa-2x text-muted me-2" role="img" aria-label="No employee" title="No employee"/>
                            <div><strong class="fs-5">No employee</strong><div class="text-muted small" t-esc="n.name"/></div>
                        </div>
                        <span t-if="n.status === 'connected'" class="badge rounded-pill bg-success">Online</span>
                        <span t-elif="n.status === 'disconnected'" class="badge rounded-pill bg-danger">Offline</span>
                        <span t-else="" class="badge rounded-pill bg-warning">Waiting</span>
                    </div>
                    <div class="text-muted small mb-2"><i class="fa fa-whatsapp text-success me-1" role="img" aria-label="WhatsApp" title="WhatsApp"/><t t-esc="n.number || 'No number yet'"/></div>
                    <button t-if="n.can_give" type="button" class="btn btn-primary btn-sm" t-on-click="() => this.giveNumber(n.id)">Choose the employee</button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
