<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_employee_tracker.ChatView">
        <div class="wa-chat-container d-flex" style="height: calc(100vh - 52px); overflow:hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

            <!-- ===== LEFT PANEL: Contact List ===== -->
            <div class="d-flex flex-column" style="width:420px; min-width:420px; border-right:1px solid #d1d7db; background:#fff;">

                <!-- Header -->
                <div class="px-3 py-2" t-att-style="'background:#008069; color:white;' + (showHome ? ' min-height:60px; padding-top:13px !important;' : '')">
                    <div class="d-flex align-items-center justify-content-between">
                        <span style="font-size:17px;">
                            <i t-if="!showHome" class="fa fa-whatsapp me-2"/>WA Tracker
                        </span>
                        <div>
                            <button t-if="state.home" type="button" class="btn btn-sm text-white" t-on-click="toggleClassic"
                                    t-att-title="state.classic ? 'Back to the simple list' : 'All chats and old numbers'"><i t-att-class="state.classic ? 'fa fa-list' : 'fa fa-history'"/></button>
                            <button class="btn btn-sm text-white" t-on-click="loadConversations" title="Refresh">
                                <i class="fa fa-refresh"/>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Employee Filter -->
                <div t-if="!showHome" class="px-2 py-1" style="background:#008069;">
                    <select class="form-select form-select-sm"
                            t-on-change="onEmployeeChange"
                            style="border-radius:8px; border:none; font-size:13px; background:#f0f2f5;">
                        <option value="">All Employees (present numbers)</option>
                        <t t-foreach="state.employees" t-as="emp" t-key="emp.id">
                            <option t-att-value="emp.id"
                                    t-att-selected="state.employeeId === emp.id">
                                <t t-esc="emp.name"/>
                            </option>
                        </t>
                    </select>
                    <select t-if="state.employeeId" class="form-select form-select-sm mt-1 wa-number-select"
                            t-on-change="onNumberChange" aria-label="Number"
                            style="border-radius:8px; border:none; font-size:13px; background:#f0f2f5;">
                        <t t-foreach="selectedEmployee.numbers" t-as="n" t-key="n.id">
                            <option t-att-value="n.id" t-att-selected="state.numberId === n.id"><t t-esc="numberLabel(n)"/></option>
                        </t>
                        <option t-if="selectedEmployee.numbers.length > 1" value="" t-att-selected="!state.numberId">All numbers (full history)</option>
                    </select>
                </div>

                <!-- The employees -->
                <div t-if="showHome" class="wa-drop">
                    <button type="button" class="wa-drop-box" t-att-class="{ late: isLate(pickedRow), soon: !isLate(pickedRow) and waitingOf(pickedRow).length }" t-att-aria-expanded="state.drop ? 'true' : 'false'" t-on-click="toggleDrop">
                        <span class="wa-drop-text"><t t-if="pickedRow"><t t-esc="pickedRow.name"/> <small t-att-class="pickedRow.connected ? 'wa-home-soft' : 'wa-home-late'" t-esc="activeText(pickedRow)"/></t><t t-else="">All employees</t></span>
                        <span t-att-class="isLate(pickedRow) ? 'wa-home-late' : waitingOf(pickedRow).length ? 'wa-home-soon' : 'wa-home-soft'"><t t-esc="waitingOf(pickedRow).length"/> waiting</span>
                        <i class="fa fa-caret-down"/>
                    </button>
                    <div t-if="state.drop" class="wa-drop-list">
                        <button type="button" class="wa-drop-row" t-att-class="{ on: !state.picked }" t-on-click="() => this.choose(null)">
                            <span class="wa-drop-text">All employees<small class="wa-home-soft" t-esc="allToday"/></span>
                            <span class="wa-drop-end"><span t-att-class="isLate(null) ? 'wa-home-late' : waitingOf(null).length ? 'wa-home-soon' : 'wa-home-soft'"><t t-esc="waitingOf(null).length"/> waiting</span></span>
                        </button>
                        <div t-foreach="board" t-as="row" t-key="row.id" class="wa-drop-line">
                            <button type="button" class="wa-drop-row" t-att-class="{ on: state.picked === row.id }" t-on-click="() => this.choose(row)">
                                <span class="wa-drop-text"><t t-esc="row.name"/><small t-att-class="row.connected ? 'wa-home-soft' : 'wa-home-late'" t-att-title="exactTime(row.last)" t-esc="activeText(row)"/><small t-if="wrongCount(row)" class="wa-home-late">Wrong words in <t t-esc="wrongCount(row)"/> chat<t t-if="wrongCount(row) > 1">s</t></small></span>
                                <span class="wa-drop-end" t-att-class="isLate(row) ? 'wa-home-late' : waitingOf(row).length ? 'wa-home-soon' : 'wa-home-soft'"><span><t t-esc="waitingOf(row).length"/> waiting</span><span t-if="oldestOf(row)">oldest <t t-esc="oldestOf(row)"/></span></span>
                            </button>
                            <button t-if="!row.connected" type="button" class="btn btn-sm btn-secondary me-2" t-att-disabled="state.checking === row.id" t-on-click="() => this.checkNumber(row)">Check again</button>
                        </div>
                    </div>
                </div>

                <!-- Search -->
                <div t-att-class="showHome ? 'wa-home-find' : 'p-2'" t-att-style="showHome ? '' : 'background:#f0f2f5;'">
                    <div class="position-relative">
                        <i class="fa fa-search position-absolute" style="left:12px; top:9px; color:#54656f;"/>
                        <input type="text"
                               class="form-control form-control-sm"
                               t-att-placeholder="showHome ? 'Search' : 'Search or start new chat'"
                               t-on-input="onSearchInput"
                               t-att-style="'padding-left:35px; border-radius:8px; border:none; font-size:14px; background:' + (showHome ? '#f4f6f6' : '#fff')"/>
                    </div>
                </div>

                <!-- Contact List -->
                <div t-if="state.phoneDown" class="px-3 py-1 small" style="background:#fff3cd; color:#664d03;">Phone not reachable, showing saved chats</div>
                <div t-if="showHome" class="flex-grow-1 wa-home-list" style="overflow-y:auto;">
                    <button type="button" t-foreach="homeRows" t-as="c" t-key="c.card + '/' + c.id" class="wa-home-row"
                            t-att-class="{ on: state.selectedConvId === c.id and state.numberId === c.card }" t-on-click="() => this.openHomeChat(c)">
                        <span class="wa-home-face"><i t-if="c.group or !letter(c.name)" t-att-class="c.group ? 'fa fa-users' : 'fa fa-user'"/><t t-else="" t-esc="letter(c.name)"/></span>
                        <span class="wa-home-text">
                            <span class="wa-home-two"><span class="wa-home-name" t-esc="c.name"/><span t-att-class="c.unread ? 'wa-home-new' : 'wa-home-soft'" t-att-title="exactTime(c.date)" t-esc="listTime(c.date)"/></span>
                            <span class="wa-home-two">
                                <span class="wa-home-soft wa-home-cut"><span t-if="c.mine and listTick(c)" class="me-1" t-att-style="'color:' + tick(listTick(c)).color"><i t-foreach="tick(listTick(c)).icons" t-as="icon" t-key="icon_index" t-att-class="'fa ' + icon"/></span><t t-if="c.sender"><t t-esc="c.sender"/>: </t><t t-esc="c.preview"/></span>
                                <span class="wa-home-marks"><span t-if="!state.picked" class="wa-home-soft" t-esc="cardName(c)"/><span t-if="c.unread" class="wa-home-badge" t-esc="c.unread"/></span>
                            </span>
                        </span>
                    </button>
                    <div t-if="!homeRows.length" class="text-center text-muted p-4"><t t-if="state.searchQuery">Nothing found.</t><t t-else="">No chats yet.</t></div>
                </div>
                <div t-else="" class="flex-grow-1" style="overflow-y:auto;" t-on-scroll="onListScroll">
                    <t t-foreach="filteredConversations" t-as="conv" t-key="conv.id">
                        <div t-on-click="() => this.selectConversation(conv.id)"
                             class="d-flex align-items-center px-3 py-2"
                             t-att-style="'cursor:pointer; border-bottom:1px solid #f0f2f5;' + (state.selectedConvId === conv.id ? ' background-color:#f0f2f5;' : '')"
                             t-attf-class="wa-contact-row">

                            <!-- Avatar -->
                            <div class="flex-shrink-0 me-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center"
                                     style="width:49px; height:49px; background-color:#dfe5e7;">
                                    <i t-att-class="conv.group ? 'fa fa-users' : 'fa fa-user'" style="font-size:24px; color:#fff;"/>
                                </div>
                            </div>

                            <!-- Info -->
                            <div class="flex-grow-1 min-w-0 py-1">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="text-truncate fw-semibold" style="font-size:16px; color:#111b21;">
                                        <t t-esc="conv.contact_name"/>
                                    </span>
                                    <small class="flex-shrink-0 ms-2" style="font-size:12px; color:#667781;">
                                        <t t-esc="formatTime(conv.last_message_date)"/>
                                    </small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="text-truncate" style="font-size:13px; color:#667781;">
                                        <t t-esc="conv.last_message_preview or conv.phone"/>
                                    </span>
                                    <t t-if="!state.numberId and conv.own_number">
                                        <small class="flex-shrink-0 ms-2 wa-own-number" t-att-style="'font-size:11px; color:' + (conv.own_current ? '#008069' : '#8a6d3b')"><t t-esc="conv.own_number"/></small>
                                    </t>
                                    <t t-if="conv.total_messages > 0">
                                        <span class="badge rounded-pill flex-shrink-0 ms-2"
                                              style="background-color:#25d366; color:white; font-size:11px; min-width:20px;">
                                            <t t-esc="conv.total_messages"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div t-if="hasOlderChats" class="text-center p-3">
                        <button type="button" class="btn btn-sm btn-secondary" t-on-click="showOlderChats">Show older chats</button>
                    </div>
                    <t t-if="filteredConversations.length === 0">
                        <div class="text-center p-4" style="color:#667781;">
                            <i class="fa fa-inbox fa-2x d-block mb-2"/>
                            No conversations found
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===== RIGHT PANEL: Messages ===== -->
            <div class="flex-grow-1 d-flex flex-column" t-att-class="{ 'wa-talk-plain': showHome }" style="background:#efeae2; background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23d4cfc6%22%20fill-opacity%3D%220.2%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E');">

                <t t-if="state.selectedConvId">
                    <!-- Chat Header -->
                    <div t-if="openChat" class="wa-talk-head">
                        <div>
                            <div class="wa-talk-name"><t t-esc="openChat.name"/><t t-if="openChat.group"> (group)</t></div>
                            <div class="wa-home-soft wa-talk-sub"><t t-esc="cardName(openChat)"/><t t-if="chatOwner"> · <t t-esc="activeText(chatOwner)"/></t></div>
                        </div>
                        <span t-if="openState" class="ms-auto" t-att-class="openChat.state === 'no' ? 'wa-home-late' : 'wa-home-good'" t-esc="openState"/>
                        <button class="btn btn-sm" t-on-click="refreshMessages" title="Refresh" style="color:#54656f;"><i class="fa fa-refresh"/></button>
                    </div>
                    <div t-else="" class="d-flex align-items-center px-4 py-2" style="background:#f0f2f5; border-bottom:1px solid #d1d7db; min-height:60px;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width:40px; height:40px; background-color:#dfe5e7;">
                            <i class="fa fa-user" style="font-size:20px; color:#fff;"/>
                        </div>
                        <div t-if="chatOwner" class="wa-chat-owner order-last" t-att-title="exactTime(chatOwner.last)">
                            <span><t t-esc="chatOwner.name"/> <span class="wa-home-soft" t-esc="activeText(chatOwner)"/></span>
                        </div>
                        <div class="flex-grow-1">
                            <div style="font-size:16px; color:#111b21;">
                                <t t-esc="selectedConvName"/>
                            </div>
                            <small style="font-size:13px; color:#667781;">
                                <t t-esc="selectedConvPhone"/>
                                <t t-if="selectedConvEmployee">
                                    <span class="ms-2">· <t t-esc="selectedConvEmployee"/><t t-if="selectedConvOwn"> on <t t-esc="selectedConvOwn"/></t></span>
                                </t>
                            </small>
                        </div>
                        <button class="btn btn-sm" t-on-click="refreshMessages" title="Refresh"
                                style="color:#54656f;">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>

                    <!-- Messages Area -->
                    <div class="flex-grow-1 px-4 py-3" style="overflow-y:auto;" t-ref="messagesContainer" t-on-scroll="onMessagesScroll">
                        <div t-if="state.loadingOlder" class="text-center small text-muted">Loading older messages...</div>
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div t-if="isNewDay(msg_index)" class="text-center my-2 wa-day">
                                <span class="px-3 py-1 rounded shadow-sm" style="background:#fff; color:#54656f; font-size:12.5px;"><t t-esc="dayLabel(msg.message_date)"/></span>
                            </div>
                            <div class="d-flex mb-1"
                                 t-att-class="msg.direction === 'outgoing' ? 'justify-content-end' : 'justify-content-start'">
                                <div class="px-2 py-1 position-relative"
                                     t-att-class="msg.direction === 'outgoing' ? 'wa-msg-out' : 'wa-msg-in'"
                                     style="max-width:65%; border-radius:7.5px; word-wrap:break-word; box-shadow:0 1px 0.5px rgba(0,0,0,0.13);">

                                    <div t-if="isWrong(msg)" class="wa-home-late">Wrong words</div>
                                    <div t-if="msg.sender" class="fw-bold" style="font-size:12.5px; color:#1f7aec;" t-esc="msg.sender"/>
                                    <span style="font-size:14.2px; color:#111b21; white-space:pre-wrap;">
                                        <i t-if="msg.deleted" class="text-muted">This message was deleted</i>
                                        <t t-else=""><t t-foreach="pieces(msg)" t-as="p" t-key="p_index"><a t-if="p.href" target="_blank" rel="noopener noreferrer" style="word-break:break-all;" t-att-href="p.href" t-esc="p.text"/><code t-elif="p.code" t-esc="p.text"/><span t-else="" t-att-class="{ 'fw-bold': p.bold, 'fst-italic': p.italic, 'text-decoration-line-through': p.strike }" t-esc="p.text"/></t></t>
                                    </span>
                                    <div t-if="msg.media" class="mt-1">
                                        <t t-if="msg.media.kind === 'file'"><a class="btn btn-sm btn-secondary" target="_blank" rel="noopener" t-att-href="mediaUrl(msg)"><i class="fa fa-download me-1"/><t t-esc="msg.media.name || 'Open the document'"/></a></t>
                                        <t t-elif="!state.media[msg.id]"><button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.openMedia(msg)"><i t-att-class="msg.media.kind === 'image' ? 'fa fa-picture-o me-1' : 'fa fa-play me-1'"/><t t-if="msg.media.kind === 'image'">Show picture</t><t t-elif="msg.media.kind === 'video'">Play video</t><t t-else="">Play voice note</t></button></t>
                                        <t t-elif="state.media[msg.id] === 'failed'"><span class="small text-muted">It cannot be opened: not there any more, or too large.</span></t>
                                        <audio t-else="" controls="" autoplay="" style="max-width:100%;" t-att-src="mediaUrl(msg)" t-on-error="() => this.mediaFailed(msg)"/>
                                    </div>
                                    <span t-if="msg.reactions and msg.reactions.length" class="badge rounded-pill bg-light text-dark border ms-1" t-esc="msg.reactions.join(' ')"/>
                                    <small t-if="msg.edited and !msg.deleted" class="text-muted ms-1">edited</small>
                                    <span class="d-inline-flex align-items-center float-end ms-2 mt-1" style="font-size:11px; color:#667781;">
                                        <t t-esc="formatClock(msg.message_date)"/>
                                        <t t-if="msg.direction === 'outgoing'">
                                            <span class="ms-1 wa-tick" t-att-title="msg.status" t-att-style="'font-size:10px; color:' + tick(msg.status).color">
                                                <i t-foreach="tick(msg.status).icons" t-as="icon" t-key="icon_index" t-att-class="'fa ' + icon"/>
                                            </span>
                                        </t>
                                    </span>
                                </div>
                            </div>
                        </t>

                        <div t-if="state.loading and !state.messages.length" class="text-center py-5" style="color:#667781;"><i class="fa fa-spinner fa-spin me-2"/>Loading…</div>
                        <t t-if="state.messages.length === 0 and !state.loading">
                            <div class="text-center py-5">
                                <div class="d-inline-block px-3 py-2 rounded" style="background:rgba(255,255,255,0.9); color:#667781; font-size:13px;">
                                    <i class="fa fa-lock me-1"/> Messages are loaded from the tracker database
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Picture or video, large; a tap beside it, the cross or Esc closes it -->
                <div t-if="state.viewer" role="dialog" aria-modal="true" aria-label="Picture or video" t-on-click.self="closeViewer"
                     class="d-flex flex-column align-items-center justify-content-center p-3"
                     style="position:fixed; inset:0; z-index:1080; background:rgba(0,0,0,0.85);">
                    <div class="d-flex gap-2 align-self-end mb-2">
                        <a class="btn btn-secondary" target="_blank" rel="noopener" t-att-href="mediaUrl(state.viewer)" title="Open in a new tab"><i class="fa fa-external-link"/></a>
                        <button type="button" class="btn btn-secondary" aria-label="Close" title="Close" t-on-click="closeViewer"><i class="fa fa-times"/></button>
                    </div>
                    <img t-if="state.viewer.media.kind === 'image'" alt="Picture" style="max-width:100%; max-height:82vh; object-fit:contain; border-radius:6px;" t-att-src="mediaUrl(state.viewer)" t-on-error="viewerFailed"/>
                    <video t-else="" controls="" autoplay="" style="max-width:100%; max-height:82vh;" t-att-src="mediaUrl(state.viewer)" t-on-error="viewerFailed"/>
                </div>

                <!-- Reply: private chats of the phone, administrators -->
                <div t-if="state.selectedConvId and canReply" class="px-3 py-2" style="background:#f0f2f5; border-top:1px solid #d1d7db;">
                    <div t-if="state.replyError" class="small text-danger mb-1" role="alert" t-esc="state.replyError"/>
                    <div class="d-flex align-items-end gap-2">
                        <textarea class="form-control" rows="1" maxlength="4000" placeholder="Type a message" aria-label="Message"
                                  style="resize:none; border-radius:8px; border:none;" t-model="state.reply" t-on-keydown="onReplyKey"/>
                        <button type="button" class="btn btn-primary" t-att-disabled="!state.reply.trim()" t-on-mousedown.prevent="" t-on-click="sendReply" title="Send">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>

                <!-- The employees -->
                <div t-if="!state.selectedConvId and state.replies.length and !state.home" class="wa-board">
                    <h2>Employees</h2>
                    <p>Press a name to see only that person's chats.</p>
                    <t t-foreach="board" t-as="row" t-key="row.id">
                        <div class="wa-board-line">
                            <button type="button" class="wa-board-row" t-att-class="{ on: state.picked === row.id }" t-att-aria-pressed="state.picked === row.id" t-on-click="() => this._openNumber(row)">
                                <span class="wa-board-face"><t t-esc="initials(row.name)"/></span>
                                <span class="wa-board-text"><span t-esc="row.name"/><small t-att-class="row.connected ? 'wa-home-soft' : 'wa-home-late'" t-att-title="exactTime(row.last)" t-esc="activeText(row)"/></span>
                                <span class="wa-board-end">
                                    <span t-if="count(row, 'no')" class="wa-home-late"><t t-esc="count(row, 'no')"/> not replied</span>
                                    <span t-elif="count(row, 'yes')" class="wa-home-good">All replied</span>
                                    <span t-else="" class="wa-home-soft">No messages</span>
                                    <span t-if="wrongCount(row)" class="wa-home-late">Wrong words in <t t-esc="wrongCount(row)"/> chat<t t-if="wrongCount(row) > 1">s</t></span>
                                </span>
                            </button>
                            <button t-if="!row.connected" type="button" class="btn btn-sm btn-secondary" t-att-disabled="state.checking === row.id" t-on-click="() => this.checkNumber(row)">Check again</button>
                        </div>
                    </t>
                </div>

                <!-- Empty State (no conversation selected) -->
                <t t-if="!state.selectedConvId and (state.home or !state.replies.length)">
                    <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1"
                         style="background:#f0f2f5;">
                        <div style="text-align:center; max-width:500px;">
                            <i class="fa fa-whatsapp" style="font-size:80px; color:#41c352; display:block; margin-bottom:20px;"/>
                            <h3 style="color:#41525d; font-weight:300;">WA Employee Tracker</h3>
                            <p style="color:#667781; font-size:14px;">
                                Select a conversation from the left panel to view messages.
                                <br/>Monitor employee WhatsApp communications in real-time.
                            </p>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
