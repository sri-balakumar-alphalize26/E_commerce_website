<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mart369_cart.DealDesk">
    <Layout display="{ controlPanel: {} }" className="'o_mart369_deals h-100'">
        <div class="mart-builder pe dd">

            <header class="pe-head">
                <div>
                    <h1>Deals</h1>
                    <p>
                        A price cut on the products you pick, for as long as you say.
                        Shoppers do not type anything - the card is simply cheaper.
                    </p>
                </div>
                <div class="dd-head-act">
                    <button class="mart-btn mart-trash-chip" t-att-disabled="state.busy"
                            t-att-aria-expanded="state.trashOpen ? 'true' : 'false'"
                            t-on-click="() => this.openTrash()">
                        <Icon n="'trash'" size="14"/> Trash<em
                            t-if="state.trash.length" t-esc="state.trash.length"/>
                    </button>
                    <button class="mart-btn" t-on-click="() => this.allViews()">
                        <Icon n="'menu'" size="14"/> All views
                    </button>
                    <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy"
                            t-on-click="() => this.open(null)">
                        <Icon n="'plus'" size="14"/> New deal
                    </button>
                </div>
            </header>

            <div class="dd-tiles">
                <button t-foreach="TILES" t-as="tile" t-key="tile.key" type="button"
                        t-attf-class="dd-tile {{ state.tab === tile.key ? 'dd-tile-on' : '' }}"
                        t-att-aria-pressed="state.tab === tile.key ? 'true' : 'false'"
                        t-on-click="() => this.pick(tile.key)">
                    <span class="dd-tile-top">
                        <Icon n="tile.icon" size="15"/>
                        <t t-esc="tile.label"/>
                    </span>
                    <b t-esc="tileCount(tile)"/>
                </button>
                <span class="dd-tile dd-tile-flat">
                    <span class="dd-tile-top">
                        <Icon n="'basket'" size="14"/> Products on offer
                    </span>
                    <b t-esc="state.onOffer"/>
                </span>
            </div>

            <p t-if="state.error" class="pe-error" role="alert">
                We could not reach the shop. <t t-esc="state.error"/>
                <button class="mart-link" t-on-click="() => this.load()">Try again</button>
            </p>

            <section t-if="state.trashOpen" class="dd-trash">
                <header>
                    <h2>Trash</h2>
                    <button class="mart-link" t-on-click="() => this.openTrash()">Close</button>
                </header>
                <p class="mart-hint">
                    <t t-if="state.trashDays">
                        A removed deal stops discounting at once and waits
                        <t t-esc="state.trashDays"/> days here, then goes for good.
                        Putting one back returns it exactly as it was - switched
                        off if it was switched off.
                    </t>
                    <t t-else="">
                        Removed deals stop discounting at once and are kept until
                        you delete them for good.
                    </t>
                </p>
                <p t-if="!state.trash.length" class="pe-loading">Nothing removed.</p>
                <ul t-else="" class="mart-trash-list">
                    <li t-foreach="state.trash" t-as="deal" t-key="deal.id">
                        <span class="mart-trash-txt">
                            <b t-esc="deal.name"/>
                            <small>
                                <t t-esc="worth(deal)"/>
                                · <t t-esc="deal.productCount"/> product<t t-if="deal.productCount !== 1">s</t>
                                · removed <t t-esc="when(deal.deletedAt)"/>
                                <t t-if="state.trashDays">
                                    · <t t-esc="deal.daysLeft"/> day<t t-if="deal.daysLeft !== 1">s</t> left
                                </t>
                            </small>
                        </span>
                        <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                t-on-click="() => this.restore(deal)">Put back</button>
                        <button class="mart-btn mart-btn-sm mart-btn-danger"
                                t-att-disabled="state.busy"
                                t-on-click="() => this.forget(deal)">Delete for good</button>
                    </li>
                </ul>
            </section>

            <div class="dd-list">
                <p t-if="state.loading and !state.deals.length" class="pe-loading">
                    Loading deals...
                </p>
                <p t-elif="!shown.length" class="pe-loading">
                    <t t-if="state.tab === 'all'">
                        Nothing on offer. Make a deal and the price drops on the
                        card, in the basket and on the order.
                    </t>
                    <t t-else="">No deals in this state.</t>
                </p>

                <ul t-else="" class="dd-cards">
                    <!-- Tapping the card opens it for editing. The two buttons
                         stop the click so they do not open it as well. -->
                    <li t-foreach="shown" t-as="deal" t-key="deal.id"
                        t-attf-class="dd-card {{ deal.live ? '' : 'dd-card-off' }}"
                        tabindex="0" role="button"
                        t-att-aria-label="'Edit ' + deal.name"
                        t-on-click="() => this.open(deal)"
                        t-on-keydown="(ev) => ev.key === 'Enter' ? this.open(deal) : null">
                        <span class="dd-card-head">
                            <b t-esc="deal.name"/>
                            <span t-attf-class="mart-pill {{ deal.live ? 'mart-pill-green' : '' }}"
                                  t-esc="why(deal)"/>
                            <span class="dd-card-hint">Tap to edit</span>
                        </span>
                        <span class="dd-card-sub">
                            <t t-esc="worth(deal)"/>
                            · <t t-esc="deal.productCount"/> product<t t-if="deal.productCount !== 1">s</t>
                            <t t-if="deal.floor"> · never below <t t-esc="money(deal.floor)"/></t>
                        </span>
                        <span t-if="deal.note" class="dd-card-note" t-esc="deal.note"/>

                        <!-- What a shopper will actually pay, so nobody has to
                             work it out to check the deal is right. -->
                        <span t-if="deal.products.length" class="dd-card-prices">
                            <span t-foreach="deal.products.slice(0, 3)" t-as="p" t-key="p.id"
                                  class="dd-price">
                                <em t-esc="p.name"/>
                                <s t-esc="money(p.price)"/>
                                <b t-esc="money(p.dealPrice)"/>
                            </span>
                            <small t-if="deal.productCount > 3">
                                and <t t-esc="deal.productCount - 3"/> more
                            </small>
                        </span>

                        <span class="dd-card-act">
                            <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                    t-on-click.stop="() => this.toggle(deal)">
                                <t t-if="deal.active">Switch off</t>
                                <t t-else="">Switch on</t>
                            </button>
                            <button class="mart-btn mart-btn-sm mart-btn-danger"
                                    t-att-disabled="state.busy"
                                    t-on-click.stop="() => this.remove(deal)">Remove</button>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </Layout>
</t>

<t t-name="mart369_cart.DealDialog">
    <Dialog size="'lg'" contentClass="'dd-dialog'"
            title="state.draft.id ? state.draft.name || 'Edit deal' : 'New deal'">
        <div class="dd-form-wrap">
            <p class="dd-sub">
                Shoppers see the lower price straight away. They do not type anything.
            </p>
            <p t-if="state.error" class="dd-error" role="alert" t-esc="state.error"/>

            <div class="dd-form">
                <label class="dd-field dd-span2"><span>Name</span>
                    <input type="text" t-att-value="state.draft.name"
                           placeholder="Diwali weekend"
                           t-on-input="(ev) => this.edit('name', ev)"/></label>

                <label class="dd-field dd-span2"><span>Note</span>
                    <input type="text" t-att-value="state.draft.note"
                           placeholder="A line for whoever opens this in six months"
                           t-on-input="(ev) => this.edit('note', ev)"/></label>

                <label class="dd-field"><span>Discount</span>
                    <Pick label="'Discount'" value="state.draft.kind" options="kindOptions"
                          onChange="(v) => this.set('kind', v)"/></label>
                <label class="dd-field">
                    <span>
                        <t t-if="state.draft.kind === 'percent'">Per cent off</t>
                        <t t-else="">Amount off</t>
                    </span>
                    <input type="number" t-att-value="state.draft.value"
                           t-on-input="(ev) => this.edit('value', ev)"/></label>

                <label class="dd-field"><span>Never below</span>
                    <input type="number" t-att-value="state.draft.floor"
                           placeholder="0 for no floor"
                           t-on-input="(ev) => this.edit('floor', ev)"/></label>
                <label class="dd-field"><span>Starts</span>
                    <input type="datetime-local"
                           t-att-value="forInput(state.draft.startsOn)"
                           t-on-input="(ev) => this.edit('startsOn', ev)"/></label>

                <label class="dd-field"><span>Ends</span>
                    <input type="datetime-local"
                           t-att-value="forInput(state.draft.endsOn)"
                           t-on-input="(ev) => this.edit('endsOn', ev)"/></label>
                <span/>

                <div class="dd-field dd-span2">
                    <span>Products <em t-esc="state.draft.products.length"/> picked</span>
                    <Search value="state.q" placeholder="'Search the catalogue'"
                            label="'Search the catalogue'" wide="true"
                            onChange="(v) => this.onSearch(v)"/>
                    <ul t-if="state.results.length" class="dd-results">
                        <li t-foreach="state.results" t-as="p" t-key="p.id">
                            <button type="button" t-on-click="() => this.add(p)">
                                <span t-esc="p.name"/>
                                <small t-esc="money(p.list_price)"/>
                            </button>
                        </li>
                    </ul>
                    <div t-if="state.draft.products.length" class="dd-chips">
                        <span t-foreach="state.draft.products" t-as="p" t-key="p.id"
                              class="dd-chip">
                            <t t-esc="p.name"/>
                            <button type="button" t-att-aria-label="'Remove ' + p.name"
                                    t-on-click="() => this.drop(p.id)">&#215;</button>
                        </span>
                    </div>
                </div>
            </div>

            <p class="dd-hint">
                <Icon n="'info'" size="14"/>
                Leave the dates empty and it runs until you switch it off. A product
                caught by two deals takes the better one, never both. Nothing is
                written to the products - the lower price is worked out whenever a
                card, a basket or an order is priced.
            </p>
        </div>

        <t t-set-slot="footer">
            <button class="mart-btn mart-btn-primary" t-att-disabled="!canSave or state.busy"
                    t-on-click="() => this.save()">
                <t t-if="state.draft.id">Save changes</t>
                <t t-else="">Create deal</t>
            </button>
            <button class="mart-btn" t-on-click="() => this.props.close()">
                Cancel
            </button>
        </t>
    </Dialog>
</t>

</templates>
