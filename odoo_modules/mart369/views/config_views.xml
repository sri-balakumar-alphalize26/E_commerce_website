<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mart369_config_form" model="ir.ui.view">
        <field name="name">mart369.config.form</field>
        <field name="model">mart369.config</field>
        <field name="arch" type="xml">
            <form string="369 Mart Settings">
                <sheet>
                    <group string="Shared by every 369 Mart module">
                        <field name="image_base_url"/>
                        <field name="cache_seconds"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mart369_config" model="ir.actions.act_window">
        <field name="name">369 Mart Settings</field>
        <field name="res_model">mart369.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
