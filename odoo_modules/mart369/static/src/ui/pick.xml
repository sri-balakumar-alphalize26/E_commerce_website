<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mart369.Pick">
        <Dropdown position="'bottom-start'" menuClass="'mart-select-menu'" disabled="!!props.disabled">
            <button t-if="props.icon" type="button"
                    t-attf-class="mart-select mart-select-icon {{ moved ? 'mart-select-moved' : '' }}"
                    t-att-aria-label="props.label + ': ' + current" t-att-title="current"
                    t-att-disabled="props.disabled or false"
                    t-on-keydown="onKeydown">
                <Icon n="props.icon" size="16"/>
            </button>
            <button t-else="" class="mart-select" type="button" t-att-aria-label="props.label"
                    t-att-disabled="props.disabled or false"
                    t-on-keydown="onKeydown">
                <span t-esc="current"/>
                <Icon n="'chev'" size="14"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem t-foreach="props.options" t-as="opt" t-key="opt[0]"
                              class="opt[0] === props.value ? 'mart-select-on' : ''"
                              onSelected="() => this.choose(opt[0])">
                    <Icon n="'check'" size="14"/>
                    <t t-esc="opt[1]"/>
                </DropdownItem>
            </t>
        </Dropdown>
    </t>

</templates>
