<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ========== PAYMENT SCREEN BUTTONS EXTENSION ========== -->
    <t t-name="pos_loyalty_card.PaymentButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            
            <!-- Selected Customer Card Info -->
            <t t-if="loyaltyCardInfo">
                <div class="loyalty-customer-badge mb-2" t-on-click="openLoyaltyPopup">
                    <i class="fa fa-user-circle"/> 
                    <span class="name"><t t-esc="loyaltyCardInfo.name"/></span>
                    <span class="badge bg-primary ms-2">
                        <t t-esc="Math.round(loyaltyCardInfo.total_points || 0)"/> pts
                    </span>
                </div>
            </t>
            
            <!-- Redeem Points Button -->
            <button class="btn btn-lg w-100 loyalty-redeem-btn" t-on-click="openRedeemPopup">
                <i class="fa fa-gift"/> Redeem Points
            </button>
            
            <!-- Show Redemption Applied Info -->
            <t t-if="hasLoyaltyRedemption">
                <div class="loyalty-redemption-applied">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa fa-check-circle text-success"/> 
                            <strong><t t-esc="Math.round(loyaltyRedemptionInfo.points)"/> pts</strong> redeemed
                            <br/>
                            <small class="text-success">- ₹<t t-esc="loyaltyRedemptionInfo.amount.toFixed(2)"/></small>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" t-on-click="removeRedemption">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </div>
            </t>
            
        </xpath>
    </t>

