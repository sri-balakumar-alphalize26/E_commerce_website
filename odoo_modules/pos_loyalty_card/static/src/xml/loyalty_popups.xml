<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ========== LOYALTY CARD POPUP ========== -->
    <t t-name="pos_loyalty_card.LoyaltyCardPopup">
        <Dialog title="'Loyalty Card'" size="'md'">
            <div class="p-3">
                
                <!-- Create Mode -->
                <t t-if="state.mode === 'create'">
                    <h5 class="text-center mb-3">New Customer</h5>
                    
                    <t t-if="state.error">
                        <div class="alert alert-danger py-2"><t t-esc="state.error"/></div>
                    </t>
                    
                    <div class="mb-2">
                        <input type="text" class="form-control" placeholder="Name *" 
                               t-att-value="state.newName" t-on-input="onNameInput"/>
                    </div>
                    <div class="mb-2">
                        <input type="text" class="form-control" placeholder="Mobile *" 
                               t-att-value="state.newPhone" t-on-input="onPhoneInput"/>
                    </div>
                    <div class="mb-3">
                        <input type="email" class="form-control" placeholder="Email" 
                               t-att-value="state.newEmail" t-on-input="onEmailInput"/>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary flex-fill" t-on-click="backToSearch">Back</button>
                        <button class="btn btn-success flex-fill" t-on-click="doCreate" t-att-disabled="state.creating">
                            <t t-if="state.creating">Creating...</t>
                            <t t-else="">Create</t>
                        </button>
                    </div>
                </t>
                
                <!-- Search Mode -->
                <t t-else="">
                    <h5 class="text-center mb-3">Find or Create Card</h5>
                    
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Mobile or Card #" 
                               t-att-value="state.searchTerm" t-on-input="onInput" t-on-keyup="onKeyup"/>
                        <button class="btn btn-primary" t-on-click="doSearch" t-att-disabled="state.searching">
                            <t t-if="state.searching">...</t><t t-else="">Search</t>
                        </button>
                    </div>
                    
                    <t t-if="state.error">
                        <div class="alert alert-warning py-2"><t t-esc="state.error"/></div>
                    </t>
                    
                    <t t-if="state.cardData">
                        <div class="card border-success mb-3">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong><t t-esc="state.cardData.name"/></strong><br/>
                                        <small class="text-muted">
                                            <t t-esc="state.cardData.card_number"/> | <t t-esc="state.cardData.phone"/>
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <h4 class="mb-0 text-primary">
                                            <t t-esc="Math.round(state.cardData.total_points || 0)"/>
                                        </h4>
                                        <small>Points</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-fill" t-on-click="skip">Skip</button>
                            <button class="btn btn-success flex-fill" t-on-click="selectCard">Select</button>
                        </div>
                    </t>
                    
                    <t t-else="">
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-fill" t-on-click="skip">Skip</button>
                            <button class="btn btn-primary flex-fill" t-on-click="showCreate">New Card</button>
                        </div>
                    </t>
                </t>
            </div>
        </Dialog>
    </t>

    <!-- ========== REDEEM POINTS POPUP ========== -->
    <t t-name="pos_loyalty_card.RedeemPopup">
        <Dialog title="'Redeem Loyalty Points'" size="'lg'">
            <div class="p-3">
                
                <!-- Search if no card -->
                <t t-if="!state.cardData">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Mobile or Card #"
                               t-att-value="state.searchTerm" t-on-input="onInput" t-on-keyup="onKeyup"/>
                        <button class="btn btn-primary" t-on-click="doSearch" t-att-disabled="state.searching">
                            <t t-if="state.searching">...</t><t t-else="">Search</t>
                        </button>
                    </div>
                </t>
                
                <t t-if="state.error">
                    <div class="alert alert-danger py-2"><t t-esc="state.error"/></div>
                </t>
                
                <!-- Card Found -->
                <t t-if="state.cardData">
                    <div class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white py-2">
                            <strong><t t-esc="state.cardData.name"/></strong>
                            <span class="float-end"><t t-esc="state.cardData.card_number"/></span>
                        </div>
                        <div class="card-body">
                            <!-- Points Summary -->
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <h3 class="mb-0 text-primary">
                                        <t t-esc="Math.round(state.cardData.total_points || 0)"/>
                                    </h3>
                                    <small>Available Points</small>
                                </div>
                                <div class="col-6">
                                    <h3 class="mb-0 text-success">
                                        ₹<t t-esc="(state.cardData.points_value || 0).toFixed(2)"/>
                                    </h3>
                                    <small>Points Value</small>
                                </div>
                            </div>
                            
                            <t t-if="state.cardData.can_redeem">
                                <!-- Verification Checkbox -->
                                <div class="form-check mb-3 p-3 bg-light rounded">
                                    <input type="checkbox" class="form-check-input" id="verifyCustomer" 
                                           t-att-checked="state.verified" t-on-change="onVerify"/>
                                    <label class="form-check-label" for="verifyCustomer">
                                        <strong>I verify this customer's identity</strong>
                                    </label>
                                </div>
                                
                                <t t-if="state.verified">
                                    <!-- Points Input -->
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label">Points to Redeem</label>
                                            <input type="number" class="form-control text-center fs-4" 
                                                   t-att-value="state.pointsToRedeem" 
                                                   t-on-input="onPointsInput" 
                                                   min="0" 
                                                   t-att-max="state.maxRedeemPoints"/>
                                            <div class="btn-group w-100 mt-2">
                                                <button class="btn btn-sm btn-outline-secondary" t-on-click="setMin">
                                                    Min (<t t-esc="state.cardData.min_redeem_points"/>)
                                                </button>
                                                <button class="btn btn-sm btn-outline-primary" t-on-click="setMax">
                                                    Max (<t t-esc="Math.round(state.maxRedeemPoints)"/>)
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-6 text-center">
                                            <label class="form-label">Discount Amount</label>
                                            <div class="bg-success text-white p-3 rounded">
                                                <h3 class="mb-0">₹<t t-esc="discountAmount.toFixed(2)"/></h3>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Payment Breakdown - THE KEY FEATURE -->
                                    <div class="card bg-light mb-3">
                                        <div class="card-header py-2">
                                            <strong>Payment Breakdown</strong>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="d-flex justify-content-between py-1">
                                                <span>Order Total:</span>
                                                <span class="fw-bold">₹<t t-esc="state.orderTotal.toFixed(2)"/></span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 text-success">
                                                <span>
                                                    <i class="fa fa-gift"/> Loyalty Points 
                                                    (<t t-esc="Math.round(state.pointsToRedeem)"/> pts):
                                                </span>
                                                <span class="fw-bold">- ₹<t t-esc="discountAmount.toFixed(2)"/></span>
                                            </div>
                                            <hr class="my-2"/>
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="fw-bold fs-5">Remaining (Cash/Card):</span>
                                                <span class="fw-bold fs-5 text-primary">
                                                    ₹<t t-esc="remainingToPay.toFixed(2)"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="alert alert-warning">
                                    <i class="fa fa-info-circle"/> 
                                    Need at least <strong><t t-esc="state.cardData.min_redeem_points"/></strong> points to redeem
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                
                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary flex-fill" t-on-click="cancel">Cancel</button>
                    <button class="btn btn-success flex-fill" t-on-click="confirm" 
                            t-att-disabled="!canRedeem || state.processing">
                        <t t-if="state.processing">Processing...</t>
                        <t t-else="">
                            <i class="fa fa-check"/> Apply Redemption
                        </t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
