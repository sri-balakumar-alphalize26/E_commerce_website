<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Loyalty Card Popup - Modern Design -->
    <t t-name="pos_loyalty_card.LoyaltyCardPopup">
        <Dialog title="props.loyaltyMode !== false ? '🎁 Loyalty Card' : '👤 Customer Details'" size="'md'">
            <div class="loyalty-card-popup p-3">
                
                <!-- ============================================ -->
                <!-- CREATE MODE - New Card (Loyalty) or New Customer -->
                <!-- ============================================ -->
                <t t-if="state.mode === 'create'">
                    <div class="new-card-form">
                        <!-- Header Strip -->
                        <div class="popup-header-strip bg-success text-white mb-4">
                            <t t-if="props.loyaltyMode !== false">
                                <i class="fa fa-user-plus me-2"/> New Card Details
                            </t>
                            <t t-else="">
                                <i class="fa fa-user-plus me-2"/> Create New Customer
                            </t>
                        </div>
                        
                        <!-- Icon and Title -->
                        <div class="text-center mb-4">
                            <div class="loyalty-icon-circle bg-success-subtle mx-auto mb-3">
                                <i class="fa fa-user-plus fa-2x text-success"/>
                            </div>
                            <t t-if="props.loyaltyMode !== false">
                                <h5 class="text-success mb-1">New Customer Registration</h5>
                                <p class="text-muted small mb-0">Create a new loyalty card</p>
                            </t>
                            <t t-else="">
                                <h5 class="text-success mb-1">New Customer</h5>
                                <p class="text-muted small mb-0">Save customer details for this order</p>
                            </t>
                        </div>
                        
                        <t t-if="state.error">
                            <div class="alert alert-danger py-2 d-flex align-items-center">
                                <i class="fa fa-exclamation-circle me-2"/>
                                <span t-esc="state.error"/>
                            </div>
                        </t>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg" 
                                   placeholder="Enter customer name" 
                                   t-att-value="state.newName" 
                                   t-on-input="onNameInput"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <t t-if="countryDialCode">
                                    <span class="input-group-text">+<t t-esc="countryDialCode"/></span>
                                </t>
                                <input type="tel" inputmode="numeric"
                                       t-att-class="'form-control form-control-lg' + (showPhoneInvalid ? ' is-invalid' : (isNewPhoneValid ? ' is-valid' : ''))"
                                       t-att-placeholder="phonePlaceholder"
                                       t-att-value="state.newPhone"
                                       t-on-input="onPhoneInput"
                                       t-att-maxlength="mobileDigits"/>
                            </div>
                            <t t-if="showPhoneInvalid">
                                <small class="text-danger d-block mt-1">
                                    <i class="fa fa-exclamation-circle me-1"/>Enter exactly <t t-esc="mobileDigits"/> digits
                                </small>
                            </t>
                            <t t-elif="props.loyaltyMode !== false">
                                <small class="text-muted">Points will be saved to this number</small>
                            </t>
                            <t t-else="">
                                <small class="text-muted">Used for order linking and WhatsApp receipt</small>
                            </t>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Email (Optional)</label>
                            <input type="email" class="form-control" 
                                   placeholder="Enter email address" 
                                   t-att-value="state.newEmail" 
                                   t-on-input="onEmailInput"/>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="backToSearch">
                                <i class="fa fa-arrow-left me-1"/> Back
                            </button>
                            <button class="btn btn-success btn-lg flex-fill" t-on-click="doCreate" t-att-disabled="state.creating">
                                <t t-if="state.creating">
                                    <i class="fa fa-spinner fa-spin me-1"/> Creating...
                                </t>
                                <t t-else="">
                                    <i class="fa fa-check me-1"/>
                                    <t t-if="props.loyaltyMode !== false"> Create Card</t>
                                    <t t-else=""> Save Customer</t>
                                </t>
                            </button>
                        </div>
                    </div>
                </t>
                
                <!-- ============================================ -->
                <!-- SEARCH MODE (Find or Create) -->
                <!-- ============================================ -->
                <t t-else="">
                    <!-- Icon and Title -->
                    <div class="text-center mb-4">
                        <div t-att-class="'loyalty-icon-circle mx-auto mb-3 ' + (props.loyaltyMode !== false ? 'bg-primary-subtle' : 'bg-info-subtle')">
                            <i t-att-class="'fa fa-2x ' + (props.loyaltyMode !== false ? 'fa-id-card text-primary' : 'fa-phone text-info')"/>
                        </div>
                        <t t-if="props.loyaltyMode !== false">
                            <h5 class="mb-1">Find or Create Card</h5>
                            <p class="text-muted small mb-0">Enter mobile number or loyalty card number</p>
                            <p class="text-primary small mb-0"><i class="fa fa-barcode me-1"/> or scan the loyalty card</p>
                        </t>
                        <t t-else="">
                            <h5 class="mb-1">Customer Details</h5>
                            <p class="text-muted small mb-0">Enter mobile number to find or create customer</p>
                        </t>
                    </div>
                    
                    <!-- Search Input -->
                    <div class="mb-4">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light"><i class="fa fa-search text-muted"/></span>
                            <t t-if="countryDialCode">
                                <span class="input-group-text fw-bold">+<t t-esc="countryDialCode"/></span>
                            </t>
                            <input type="text"
                                   t-att-class="'form-control' + (showSearchInvalid ? ' is-invalid' : '')"
                                   t-att-placeholder="props.loyaltyMode !== false ? 'Mobile number or card number...' : 'Mobile number...'"
                                   t-att-value="state.searchTerm"
                                   t-on-input="onInput"
                                   t-on-keyup="onKeyup"
                                   autofocus="autofocus"/>
                            <button class="btn btn-primary px-4" t-on-click="doSearch" t-att-disabled="state.searching">
                                <t t-if="state.searching"><i class="fa fa-spinner fa-spin"/></t>
                                <t t-else="">Search</t>
                            </button>
                        </div>
                    </div>
                    
                    <t t-if="state.error">
                        <div class="alert alert-danger py-2 d-flex align-items-center mb-3">
                            <i class="fa fa-exclamation-circle me-2"/>
                            <span t-esc="state.error"/>
                        </div>
                    </t>
                    
                    <!-- Customer Found -->
                    <t t-if="state.cardData">
                        <div class="card border-success mb-4 loyalty-card-found">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center">
                                    <div class="loyalty-avatar bg-success text-white me-3">
                                        <i class="fa fa-check"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1 text-success"><t t-esc="state.cardData.name"/></h5>
                                        <p class="mb-0 text-muted small">
                                            <t t-if="state.cardData.card_number and props.loyaltyMode !== false"><t t-esc="state.cardData.card_number"/> | </t>
                                            <i class="fa fa-phone me-1"/><t t-esc="state.cardData.phone"/>
                                        </p>
                                        <t t-if="props.loyaltyMode === false and state.cardData.partner_id">
                                            <p class="mb-0 text-muted small">
                                                <i class="fa fa-id-badge me-1"/>Customer ID: <t t-esc="state.cardData.partner_id"/>
                                            </p>
                                        </t>
                                    </div>
                                    <t t-if="props.loyaltyMode !== false">
                                        <div class="text-end">
                                            <h3 class="text-primary mb-0"><t t-esc="Math.round(state.cardData.total_points || 0)"/></h3>
                                            <small class="text-success fw-semibold">Points</small>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="skip">
                                <i class="fa fa-times me-1"/> Skip
                            </button>
                            <button class="btn btn-success btn-lg flex-fill" t-on-click="selectCard">
                                <i class="fa fa-check me-1"/> Select
                            </button>
                        </div>
                    </t>
                    
                    <!-- No Customer Found - Show Create Button in ALL modes -->
                    <t t-else="">
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="skip">
                                <i class="fa fa-times me-1"/> Skip
                            </button>
                            <button class="btn btn-primary btn-lg flex-fill" t-on-click="showCreate">
                                <i class="fa fa-user-plus me-1"/>
                                <t t-if="props.loyaltyMode !== false"> New Card</t>
                                <t t-else=""> Create New Customer</t>
                            </button>
                        </div>
                    </t>
                </t>
            </div>
        </Dialog>
    </t>

    <!-- Redeem Popup - Modern Design -->
    <t t-name="pos_loyalty_card.RedeemPopup">
        <Dialog title="'🎁 Redeem Points'" size="'lg'">
            <div class="loyalty-redeem-popup p-3">
                
                <t t-if="!state.cardData">
                    <!-- Search Section -->
                    <div class="text-center mb-4">
                        <div class="loyalty-icon-circle bg-purple-subtle mx-auto mb-3">
                            <i class="fa fa-gift fa-2x text-purple"/>
                        </div>
                        <h5 class="mb-1">Redeem Your Points</h5>
                        <p class="text-muted small mb-0">Search for a loyalty card to redeem points</p>
                    </div>
                    
                    <div class="mb-4">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light"><i class="fa fa-search text-muted"/></span>
                            <t t-if="countryDialCode">
                                <span class="input-group-text fw-bold">+<t t-esc="countryDialCode"/></span>
                            </t>
                            <input type="text" class="form-control"
                                   placeholder="Mobile or Card #"
                                   t-att-value="state.searchTerm" 
                                   t-on-input="onInput" 
                                   t-on-keyup="onKeyup"/>
                            <button class="btn btn-primary px-4" t-on-click="doSearch" t-att-disabled="state.searching">
                                <t t-if="state.searching"><i class="fa fa-spinner fa-spin"/></t>
                                <t t-else="">Search</t>
                            </button>
                        </div>
                    </div>
                </t>
                
                <t t-if="state.error">
                    <div class="alert alert-danger py-2 d-flex align-items-center">
                        <i class="fa fa-exclamation-circle me-2"/>
                        <span t-esc="state.error"/>
                    </div>
                </t>
                
                <t t-if="state.cardData">
                    <div class="card border-primary mb-4 loyalty-card-found">
                        <div class="card-header bg-primary text-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="loyalty-avatar bg-white text-primary me-3">
                                        <i class="fa fa-user"/>
                                    </div>
                                    <div>
                                        <strong class="fs-5"><t t-esc="state.cardData.name"/></strong>
                                        <div class="small opacity-75"><t t-esc="state.cardData.card_number"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-4">
                                <div class="col-6">
                                    <div class="redemption-stat">
                                        <h2 class="mb-0 text-primary"><t t-esc="Math.round(state.cardData.total_points || 0)"/></h2>
                                        <small class="text-muted">Available Points</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="redemption-stat">
                                        <h2 class="mb-0 text-success">₹<t t-esc="(state.cardData.points_value || 0).toFixed(2)"/></h2>
                                        <small class="text-muted">Points Value</small>
                                    </div>
                                </div>
                            </div>
                            
                            <t t-if="state.cardData.can_redeem">
                                <div class="card border-warning mb-3">
                                    <div class="card-body py-3">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="verify" 
                                                   t-att-checked="state.verified" 
                                                   t-on-change="onVerify"
                                                   style="transform: scale(1.3);"/>
                                            <label class="form-check-label fw-semibold ms-2" for="verify">
                                                <i class="fa fa-shield me-1 text-warning"/> I verify customer identity
                                            </label>
                                        </div>
                                        <small class="text-muted d-block mt-1 ms-4">Please verify before proceeding</small>
                                    </div>
                                </div>
                                
                                <t t-if="state.verified">
                                    <t t-if="belowMinimum">
                                        <div class="alert alert-danger d-flex align-items-center">
                                            <i class="fa fa-exclamation-triangle me-2"/>
                                            <div>
                                                <b>This order is too small to redeem.</b>
                                                Minimum <t t-esc="Math.round(minRedeemPoints)"/> pts
                                                (₹<t t-esc="(minRedeemPoints / ppc).toFixed(2)"/>) required, but this
                                                order allows only <t t-esc="Math.round(state.maxPoints)"/> pts
                                                (₹<t t-esc="maxRedeemValue.toFixed(2)"/>).
                                            </div>
                                        </div>
                                    </t>
                                    <div class="row mb-4" t-if="!belowMinimum">
                                        <div class="col-6">
                                            <label class="form-label fw-semibold">Points to Redeem</label>
                                            <div class="input-group input-group-lg">
                                                <input type="number" class="form-control text-center fw-bold" 
                                                       t-att-value="state.points" 
                                                       t-on-input="onPoints" 
                                                       min="0" 
                                                       t-att-max="state.maxPoints"/>
                                                <span class="input-group-text">pts</span>
                                            </div>
                                            <div class="btn-group w-100 mt-2">
                                                <button class="btn btn-outline-secondary" t-on-click="setMin">Min</button>
                                                <button class="btn btn-outline-secondary" t-on-click="setMax">Max</button>
                                            </div>
                                            <div class="text-danger small fw-semibold mt-1">
                                                <i class="fa fa-exclamation-circle me-1"/>
                                                Max redeemable: <t t-esc="Math.round(state.maxPoints)"/> pts
                                                (₹<t t-esc="maxRedeemValue.toFixed(2)"/>)
                                            </div>
                                            <t t-if="isCapped">
                                                <div class="text-muted small mt-1">
                                                    Card has <t t-esc="Math.round(cardTotalPoints)"/> pts, but this order
                                                    only allows up to <t t-esc="Math.round(state.maxPoints)"/> pts
                                                    (order total × max redeem %).
                                                </div>
                                            </t>
                                        </div>
                                        <div class="col-6 text-center">
                                            <label class="form-label fw-semibold">Your Discount</label>
                                            <div class="bg-success text-white p-3 rounded-3">
                                                <h2 class="mb-0">₹<t t-esc="discount.toFixed(2)"/></h2>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="card bg-light mb-3">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">Order Summary</h6>
                                            <div class="d-flex justify-content-between mb-2">
                                                <span>Order Total:</span>
                                                <span class="fw-semibold">₹<t t-esc="orderTotal.toFixed(2)"/></span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-2 text-success">
                                                <span>Points Discount:</span>
                                                <span class="fw-semibold">- ₹<t t-esc="discount.toFixed(2)"/></span>
                                            </div>
                                            <hr class="my-2"/>
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-bold">Amount to Pay:</span>
                                                <span class="fw-bold text-primary fs-5">₹<t t-esc="finalAmount.toFixed(2)"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="alert alert-warning d-flex align-items-center">
                                    <i class="fa fa-exclamation-triangle fa-2x me-3"/>
                                    <div>
                                        <strong>Not Enough Points</strong>
                                        <p class="mb-0 small">Need minimum <t t-esc="state.cardData.min_redeem_points"/> points to redeem</p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="cancel">
                        <i class="fa fa-times me-1"/> Cancel
                    </button>
                    <button class="btn btn-success btn-lg flex-fill" t-on-click="confirm" t-att-disabled="!canRedeem || state.processing">
                        <t t-if="state.processing">
                            <i class="fa fa-spinner fa-spin me-1"/> Processing...
                        </t>
                        <t t-else="">
                            <i class="fa fa-check me-1"/> Redeem
                        </t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

    <!-- 
        =========================================================================
        SINGLE Payment Screen Button Extension 
        - Customer Details section: Always visible when customer is linked
        - Loyalty buttons (Earn/Redeem/Balance/History): Only when loyalty is ON
        =========================================================================
    -->
    <t t-name="pos_loyalty_card.PaymentButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
          <!-- ====== LOYALTY CARDS SECTION (Only when loyalty is ON) ====== -->
          <t t-if="loyaltyEnabled">
            <t t-if="loyaltyCardInfo">
                <div class="btn btn-lg w-100 mb-1 loyalty-info-btn" t-on-click="openLoyaltyPopup">
                    <i class="fa fa-id-card me-1"/> <t t-esc="loyaltyCardInfo.name"/>
                    <span class="badge loyalty-info-badge ms-2"><t t-esc="Math.round(loyaltyCardInfo.total_points || 0)"/> pts</span>
                </div>
            </t>
            <t t-else="">
                <div class="btn btn-lg w-100 mb-1 loyalty-add-btn" t-on-click="openLoyaltyPopup">
                    <i class="fa fa-id-card me-1"/> Add Loyalty Card
                </div>
            </t>
            <button class="btn btn-lg w-100 loyalty-btn" t-on-click="openRedeemPopup">
                <i class="fa fa-gift"/> Redeem Points
            </button>
            
            <!-- Small indicator when redemption is active -->
            <t t-if="hasRedemption">
                <div class="loyalty-active-indicator" t-on-click="removeRedemption">
                    <i class="fa fa-check-circle"/> <t t-esc="Math.round(redemptionInfo.points_redeemed)"/> pts applied
                    <span class="remove-hint"><i class="fa fa-times"/></span>
                </div>
            </t>
          </t>
        </xpath>
    </t>
    
    <!-- Payment Summary Extension - Shows breakdown in the main payment area -->
    <t t-name="pos_loyalty_card.PaymentSummary" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-summary')]" position="before">
            <!-- ====== SKIPPED LOYALTY NOTE (red) with reopen button ====== -->
            <t t-if="loyaltyWasSkipped">
                <div class="alert alert-danger d-flex align-items-center justify-content-between" style="margin: 10px 12px;">
                    <div>
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <b>Loyalty skipped.</b> The customer won't get points credited.
                        To add credits, tap <b>Add Loyalty Card</b>.
                    </div>
                    <button class="btn btn-danger btn-sm ms-2" t-on-click="openLoyaltyPopup">
                        <i class="fa fa-id-card me-1"/> Add Loyalty Card
                    </button>
                </div>
            </t>
            <!-- ====== CUSTOMER DETAILS BOX (When loyalty is OFF) - Same style as Loyalty Redemption ====== -->
            <t t-if="customerDetails and !loyaltyEnabled">
                <div class="customer-details-summary">
                    <!-- Header Row: Title + Remove Button -->
                    <div class="summary-header-row">
                        <div class="summary-title">
                            <i class="fa fa-user"/> Customer Details
                        </div>
                        <button class="btn btn-sm remove-btn" t-on-click="removeCustomerDetails">
                            <i class="fa fa-times"/> Remove
                        </button>
                    </div>
                    <!-- Detail Rows -->
                    <div class="summary-grid">
                        <div class="summary-row">
                            <span class="label">Name</span>
                            <span class="value"><t t-esc="customerDetails.name"/></span>
                        </div>
                        <div class="summary-row">
                            <span class="label"><i class="fa fa-phone"/> Mobile</span>
                            <span class="value"><t t-esc="customerDetails.phone"/></span>
                        </div>
                        <t t-if="customerDetails.partner_id">
                            <div class="summary-row">
                                <span class="label">Customer ID</span>
                                <span class="value">#<t t-esc="customerDetails.partner_id"/></span>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ====== LOYALTY REDEMPTION BOX (When loyalty is ON and redemption applied) ====== -->
            <t t-if="loyaltyEnabled and hasRedemption">
                <div class="loyalty-payment-summary">
                    <!-- Header Row: Title + Remove Button -->
                    <div class="summary-header-row">
                        <div class="summary-title">
                            <i class="fa fa-gift"/> Loyalty Redemption Applied
                        </div>
                        <button class="btn btn-sm remove-btn" t-on-click="removeRedemption">
                            <i class="fa fa-times"/> Remove
                        </button>
                    </div>
                    <!-- Detail Rows -->
                    <div class="summary-grid">
                        <div class="summary-row">
                            <span class="label">Original Total</span>
                            <span class="value">₹<t t-esc="originalTotal.toFixed(2)"/></span>
                        </div>
                        <div class="summary-row discount">
                            <span class="label">
                                <i class="fa fa-minus-circle"/> Points Redeemed 
                                (<t t-esc="Math.round(redemptionInfo.points_redeemed)"/> pts)
                            </span>
                            <span class="value">- ₹<t t-esc="redemptionInfo.discount_value.toFixed(2)"/></span>
                        </div>
                        <div class="summary-row final">
                            <span class="label">Amount to Pay</span>
                            <span class="value">₹<t t-esc="remainingAmount.toFixed(2)"/></span>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ====== REFUND: redeemed points credited back on this return ====== -->
            <t t-if="loyaltyEnabled and hasReturnRedeem">
                <div class="loyalty-payment-summary loyalty-return-summary">
                    <div class="summary-header-row">
                        <div class="summary-title">
                            <i class="fa fa-undo"/> Loyalty Points Refund
                        </div>
                    </div>
                    <div class="summary-grid">
                        <div class="summary-row">
                            <span class="label">Refund Amount</span>
                            <span class="value">₹<t t-esc="Math.abs(remainingAmount).toFixed(2)"/></span>
                        </div>
                        <div class="summary-row discount">
                            <span class="label">
                                <i class="fa fa-plus-circle"/> Points Credited Back
                            </span>
                            <span class="value"><t t-esc="Math.round(returnRedeem.points)"/> pts (₹<t t-esc="returnRedeem.value.toFixed(2)"/>)</span>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
