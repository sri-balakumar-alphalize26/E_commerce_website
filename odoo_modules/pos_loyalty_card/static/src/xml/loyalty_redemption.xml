<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- =========================================================================
         LOYALTY REDEMPTION UI TEMPLATES (integrated from File 2)
         
         These templates provide the Payment section Loyalty Card popup UI:
         - LoyaltyIdentifyPopup: Customer identification (auto-shows on payment)
         - LoyaltyRedeemConfirmPopup: Redemption confirmation
         - LoyaltyRedeemDetailsPopup: Select redemption amount
         - LoyaltyRedeemSummaryPopup: Success summary
         - LoyaltyRedeemPopup: Legacy/fallback redemption
         
         NOTE: Payment Screen Button Extension is in loyalty.xml (not duplicated here)
         ========================================================================= -->

    <!-- ========== POPUP 1: Customer Identification ========== -->
    <t t-name="pos_loyalty_card.LoyaltyIdentifyPopup">
        <Dialog title="'🎁 Loyalty Card'" size="'md'">
            <div class="loyalty-identify-popup p-3">
                
                <!-- New Customer Form -->
                <t t-if="state.showNewForm">
                    <div class="new-customer-form">
                        <div class="text-center mb-4">
                            <div class="loyalty-icon-circle bg-primary-subtle mx-auto mb-3">
                                <i class="fa fa-user-plus fa-2x text-primary"/>
                            </div>
                            <h5 class="text-primary mb-1">New Customer Registration</h5>
                            <p class="text-muted small mb-0">Create a new loyalty card</p>
                        </div>
                        
                        <t t-if="state.errorMessage">
                            <div class="alert alert-danger py-2 d-flex align-items-center">
                                <i class="fa fa-exclamation-circle me-2"/>
                                <span t-esc="state.errorMessage"/>
                            </div>
                        </t>
                        
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg"
                                   placeholder="Enter customer name"
                                   t-att-value="state.newName"
                                   t-on-input="onNameInput"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control form-control-lg"
                                   placeholder="Enter 10-digit mobile number"
                                   t-att-value="state.newPhone"
                                   t-on-input="onPhoneInput"
                                   maxlength="15"/>
                            <small class="text-muted">Points will be saved to this number</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Email (Optional)</label>
                            <input type="email" class="form-control"
                                   placeholder="Enter email address"
                                   t-att-value="state.newEmail"
                                   t-on-input="onEmailInput"/>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="cancelNewForm">
                                <i class="fa fa-arrow-left me-1"/> Back
                            </button>
                            <button class="btn btn-success btn-lg flex-fill" 
                                    t-on-click="createNewCustomer"
                                    t-att-disabled="state.isCreating">
                                <t t-if="state.isCreating">
                                    <i class="fa fa-spinner fa-spin me-1"/> Creating...
                                </t>
                                <t t-else="">
                                    <i class="fa fa-check me-1"/> Create Card
                                </t>
                            </button>
                        </div>
                    </div>
                </t>
                
                <!-- Search Form -->
                <t t-else="">
                    <div class="text-center mb-4">
                        <div class="loyalty-icon-circle bg-primary-subtle mx-auto mb-3">
                            <i class="fa fa-id-card fa-2x text-primary"/>
                        </div>
                        <h5 class="mb-1">Save Points to Your Account</h5>
                        <p class="text-muted small mb-0">Enter your mobile number or loyalty card number</p>
                    </div>
                    
                    <div class="mb-4">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light"><i class="fa fa-search text-muted"/></span>
                            <input type="text" class="form-control" 
                                   placeholder="Mobile number or card number..."
                                   t-att-value="state.searchTerm"
                                   t-on-input="onSearchInput"
                                   t-on-keyup="onSearchKeyup"
                                   autofocus="autofocus"/>
                            <button class="btn btn-primary px-4" t-on-click="searchCard" t-att-disabled="state.isSearching">
                                <t t-if="state.isSearching"><i class="fa fa-spinner fa-spin"/></t>
                                <t t-else="">Search</t>
                            </button>
                        </div>
                        <t t-if="state.validationMessage">
                            <small class="text-warning d-block mt-1"><t t-esc="state.validationMessage"/></small>
                        </t>
                    </div>
                    
                    <t t-if="state.errorMessage">
                        <div class="alert alert-danger py-2"><t t-esc="state.errorMessage"/></div>
                    </t>
                    
                    <!-- Customer Found -->
                    <t t-if="state.cardFound and state.cardData">
                        <div class="card border-success mb-4 loyalty-card-found">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center">
                                    <div class="loyalty-avatar bg-success text-white me-3"><i class="fa fa-check"/></div>
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1 text-success"><t t-esc="state.cardData.name"/></h5>
                                        <p class="mb-0 text-muted small">
                                            <t t-esc="state.cardData.card_number"/> | <t t-esc="state.cardData.phone"/>
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <h3 class="text-primary mb-0"><t t-esc="state.cardData.total_points.toFixed(0)"/></h3>
                                        <small class="text-success fw-semibold">Points</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="skip">Skip</button>
                            <button class="btn btn-success btn-lg flex-fill" t-on-click="continueWithCustomer">
                                <i class="fa fa-check me-1"/> Continue
                            </button>
                        </div>
                    </t>
                    
                    <!-- No Customer Found -->
                    <t t-elif="state.searchDone and !state.cardFound">
                        <div class="text-center py-3 mb-4">
                            <div class="loyalty-icon-circle bg-warning-subtle mx-auto mb-3">
                                <i class="fa fa-user-times fa-2x text-warning"/>
                            </div>
                            <h6 class="text-warning mb-1">No loyalty card found</h6>
                            <p class="text-muted small mb-0">Would you like to create one?</p>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="skip">Skip</button>
                            <button class="btn btn-primary btn-lg flex-fill" t-on-click="showNewCustomerForm">
                                <i class="fa fa-user-plus me-1"/> New Customer
                            </button>
                        </div>
                    </t>
                    
                    <!-- Initial State -->
                    <t t-else="">
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="skip">Skip Loyalty</button>
                            <button class="btn btn-outline-primary btn-lg flex-fill" t-on-click="showNewCustomerForm">
                                <i class="fa fa-user-plus me-1"/> New Customer
                            </button>
                        </div>
                    </t>
                </t>
            </div>
        </Dialog>
    </t>


    <!-- ========== POPUP 2: Redemption Confirmation ========== -->
    <t t-name="pos_loyalty_card.LoyaltyRedeemConfirmPopup">
        <Dialog title="'🎁 Redeem Points'" size="'md'">
            <div class="loyalty-redeem-confirm-popup p-3">
                <div class="text-center mb-4">
                    <div class="loyalty-icon-circle bg-purple-subtle mx-auto mb-3">
                        <i class="fa fa-gift fa-2x text-purple"/>
                    </div>
                    <h5 class="mb-1">Redeem Your Points</h5>
                    <p class="text-muted small mb-0">Convert your points to savings</p>
                </div>
                
                <t t-if="!state.cardFound">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Find Your Card</label>
                        <div class="input-group input-group-lg">
                            <input type="text" class="form-control"
                                   placeholder="Enter mobile or card number"
                                   t-att-value="state.searchTerm"
                                   t-on-input="onSearchInput"
                                   t-on-keyup="onSearchKeyup"/>
                            <button class="btn btn-primary" t-on-click="searchCard" t-att-disabled="state.isSearching">
                                <t t-if="state.isSearching"><i class="fa fa-spinner fa-spin"/></t>
                                <t t-else="">Search</t>
                            </button>
                        </div>
                    </div>
                </t>
                
                <t t-if="state.errorMessage">
                    <div class="alert alert-danger py-2"><t t-esc="state.errorMessage"/></div>
                </t>
                
                <t t-if="state.cardFound and state.cardData">
                    <div class="card border-primary mb-4">
                        <div class="card-header bg-primary text-white py-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="fa fa-user me-2"/><t t-esc="state.cardData.name"/></span>
                                <span class="badge bg-light text-primary"><t t-esc="state.cardData.card_number"/></span>
                            </div>
                        </div>
                        <div class="card-body text-center py-4">
                            <h1 class="display-4 text-primary mb-1"><t t-esc="state.cardData.total_points.toFixed(0)"/></h1>
                            <p class="text-muted mb-2">Available Points</p>
                            <div class="badge bg-success-subtle text-success fs-6 px-3 py-2">
                                Worth ₹<t t-esc="state.cardData.points_value.toFixed(2)"/>
                            </div>
                        </div>
                    </div>
                    
                    <t t-if="canProceedToRedeem">
                        <div class="alert alert-success d-flex align-items-center mb-4">
                            <i class="fa fa-check-circle fa-2x me-3"/>
                            <div>
                                <strong>Eligible for Redemption!</strong>
                                <p class="mb-0 small">You can redeem your points on this order.</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="cancel">Cancel</button>
                            <button class="btn btn-success btn-lg flex-fill" t-on-click="confirmRedeem">
                                <i class="fa fa-gift me-1"/> Yes, Redeem Points
                            </button>
                        </div>
                    </t>
                    
                    <t t-elif="insufficientPoints">
                        <div class="alert alert-warning d-flex align-items-center mb-4">
                            <i class="fa fa-exclamation-triangle fa-2x me-3"/>
                            <div>
                                <strong>Not Enough Points</strong>
                                <p class="mb-0 small">Minimum <t t-esc="state.cardData.min_redemption_points"/> points required.</p>
                            </div>
                        </div>
                        <button class="btn btn-secondary btn-lg w-100" t-on-click="cancel">Go Back</button>
                    </t>
                </t>
                
                <t t-elif="!state.cardFound and !state.errorMessage">
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-search fa-3x mb-3 opacity-50"/>
                        <p class="mb-0">Search for a loyalty card to redeem points</p>
                    </div>
                    <button class="btn btn-outline-secondary btn-lg w-100" t-on-click="cancel">Cancel</button>
                </t>
            </div>
        </Dialog>
    </t>


    <!-- ========== POPUP 3: Redemption Details ========== -->
    <t t-name="pos_loyalty_card.LoyaltyRedeemDetailsPopup">
        <Dialog title="'💰 Select Redemption Amount'" size="'lg'">
            <div class="loyalty-redeem-details-popup p-3">
                <div class="card bg-light mb-4">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fw-semibold"><t t-esc="state.cardData.name"/></span>
                                <span class="text-muted ms-2">(<t t-esc="state.cardData.card_number"/>)</span>
                            </div>
                            <div class="badge bg-primary fs-6"><t t-esc="state.cardData.total_points.toFixed(0)"/> pts available</div>
                        </div>
                    </div>
                </div>
                
                <t t-if="state.errorMessage">
                    <div class="alert alert-danger py-2"><t t-esc="state.errorMessage"/></div>
                </t>
                
                <div class="card border-warning mb-4">
                    <div class="card-body py-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="verifyCustomer"
                                   t-on-change="onVerificationChange" t-att-checked="state.isVerified"
                                   style="transform: scale(1.3);"/>
                            <label class="form-check-label fw-semibold ms-2" for="verifyCustomer">
                                <i class="fa fa-shield me-1 text-warning"/> I confirm the customer's identity
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1 ms-4">Please verify before proceeding</small>
                    </div>
                </div>
                
                <t t-if="state.isVerified">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="card h-100">
                                <div class="card-header bg-primary text-white py-2">Points to Redeem</div>
                                <div class="card-body">
                                    <div class="input-group input-group-lg mb-2">
                                        <input type="number" class="form-control text-center fw-bold"
                                               t-att-value="state.pointsToRedeem"
                                               t-on-input="onPointsInput"
                                               t-att-disabled="!state.cardData.allow_partial"
                                               t-att-max="state.maxRedeemablePoints" min="0"/>
                                        <span class="input-group-text">pts</span>
                                    </div>
                                    <div class="btn-group w-100">
                                        <button class="btn btn-outline-secondary" t-on-click="setMinPoints">Min</button>
                                        <button class="btn btn-outline-secondary" t-on-click="setMaxPoints">Max</button>
                                    </div>
                                    <small class="text-muted d-block mt-2 text-center">
                                        Remaining: <strong><t t-esc="remainingAfterRedeem.toFixed(0)"/> pts</strong>
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-success text-white py-2">Your Discount</div>
                                <div class="card-body text-center d-flex flex-column justify-content-center">
                                    <h1 class="display-4 text-success mb-2">₹<t t-esc="state.discountValue.toFixed(2)"/></h1>
                                    <p class="text-muted mb-0">Will be deducted from your bill</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="card-title mb-3">Order Summary</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Original Amount:</span>
                                <span class="fw-semibold">₹<t t-esc="orderTotal.toFixed(2)"/></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span>Points Discount:</span>
                                <span class="fw-semibold">- ₹<t t-esc="state.discountValue.toFixed(2)"/></span>
                            </div>
                            <hr class="my-2"/>
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">Amount to Pay:</span>
                                <span class="fw-bold text-primary fs-5">₹<t t-esc="finalOrderAmount.toFixed(2)"/></span>
                            </div>
                        </div>
                    </div>
                </t>
                
                <t t-else="">
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-lock fa-3x mb-3 opacity-50"/>
                        <p class="mb-0">Please verify customer identity to proceed</p>
                    </div>
                </t>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-lg flex-fill" t-on-click="cancel">Cancel</button>
                    <button class="btn btn-success btn-lg flex-fill" t-on-click="confirmRedemption" 
                            t-att-disabled="!canRedeem or state.isProcessing">
                        <t t-if="state.isProcessing"><i class="fa fa-spinner fa-spin me-1"/> Processing...</t>
                        <t t-else=""><i class="fa fa-check me-1"/> Confirm Redemption</t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>


    <!-- ========== POPUP 4: Redemption Summary (Success) ========== -->
    <t t-name="pos_loyalty_card.LoyaltyRedeemSummaryPopup">
        <Dialog title="'✅ Redemption Successful'" size="'md'">
            <div class="loyalty-redeem-summary-popup p-3">
                <div class="text-center mb-4">
                    <div class="loyalty-success-icon mx-auto mb-3">
                        <i class="fa fa-check-circle fa-4x text-success"/>
                    </div>
                    <h4 class="text-success mb-1">Points Redeemed Successfully!</h4>
                    <p class="text-muted mb-0"><t t-esc="customerName"/> (<t t-esc="cardNumber"/>)</p>
                </div>
                
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row text-center mb-4">
                            <div class="col-4">
                                <div class="redemption-stat">
                                    <small class="text-muted d-block">Original</small>
                                    <h5 class="mb-0">₹<t t-esc="originalAmount.toFixed(2)"/></h5>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="redemption-stat text-danger">
                                    <small class="text-muted d-block">Redeemed</small>
                                    <h5 class="mb-0 text-danger">- ₹<t t-esc="discountAmount.toFixed(2)"/></h5>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="redemption-stat text-primary">
                                    <small class="text-muted d-block">To Pay</small>
                                    <h5 class="mb-0 text-primary">₹<t t-esc="finalAmount.toFixed(2)"/></h5>
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-info mb-0 text-center">
                            <i class="fa fa-info-circle me-1"/>
                            You redeemed <strong><t t-esc="pointsRedeemed.toFixed(0)"/> points</strong>
                            <br/>
                            <small>Remaining balance: <strong><t t-esc="remainingPoints.toFixed(0)"/> points</strong></small>
                        </div>
                    </div>
                </div>
                
                <button class="btn btn-success btn-lg w-100" t-on-click="proceedToPayment">
                    <i class="fa fa-credit-card me-2"/> Proceed to Payment
                </button>
            </div>
        </Dialog>
    </t>


    <!-- ========== Legacy Popup (Backward Compatibility) ========== -->
    <t t-name="pos_loyalty_card.LoyaltyRedeemPopup">
        <Dialog title="'Redeem Points'" size="'lg'">
            <div class="loyalty-redeem-popup p-3">
                <div class="mb-4">
                    <label class="form-label fw-bold">Card Number / Phone</label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-lg"
                               placeholder="Enter card number or phone"
                               t-att-value="state.searchTerm"
                               t-on-input="onSearchInput"
                               t-on-keyup="onSearchKeyup"/>
                        <button class="btn btn-primary" t-on-click="searchCard" t-att-disabled="state.isSearching">
                            <t t-if="state.isSearching"><i class="fa fa-spinner fa-spin"/></t>
                            <t t-else="">Search</t>
                        </button>
                    </div>
                </div>
                
                <t t-if="state.errorMessage">
                    <div class="alert alert-danger"><t t-esc="state.errorMessage"/></div>
                </t>
                
                <t t-if="state.cardFound and state.cardData">
                    <div class="card border-success mb-4">
                        <div class="card-header bg-success text-white py-2">
                            <strong>Loyalty Card Found</strong>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6">
                                    <p class="mb-1"><strong>Card:</strong> <t t-esc="state.cardData.card_number"/></p>
                                    <p class="mb-1"><strong>Name:</strong> <t t-esc="state.cardData.name"/></p>
                                    <p class="mb-0"><strong>Phone:</strong> <t t-esc="state.cardData.phone"/></p>
                                </div>
                                <div class="col-6 text-center">
                                    <h2 class="text-primary mb-0"><t t-esc="state.cardData.total_points.toFixed(0)"/></h2>
                                    <small class="text-muted">Available Points</small>
                                    <h5 class="text-success">≈ ₹<t t-esc="state.cardData.points_value.toFixed(2)"/></h5>
                                </div>
                            </div>
                            
                            <t t-if="state.cardData.can_redeem">
                                <hr/>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="verifyRedeem"
                                           t-on-change="onVerificationChange" t-att-checked="state.isVerified"/>
                                    <label class="form-check-label fw-bold" for="verifyRedeem">
                                        I confirm customer identity
                                    </label>
                                </div>
                                
                                <t t-if="state.isVerified">
                                    <div class="row align-items-center">
                                        <div class="col-6">
                                            <label class="form-label">Points to Redeem</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control text-center"
                                                       t-att-value="state.pointsToRedeem"
                                                       t-on-input="onPointsInput"
                                                       t-att-disabled="!state.cardData.allow_partial"/>
                                                <span class="input-group-text">pts</span>
                                            </div>
                                            <div class="btn-group mt-2 w-100">
                                                <button class="btn btn-sm btn-outline-secondary" t-on-click="setMinPoints">Min</button>
                                                <button class="btn btn-sm btn-outline-secondary" t-on-click="setMaxPoints">Max</button>
                                            </div>
                                        </div>
                                        <div class="col-6 text-center">
                                            <div class="bg-success text-white p-3 rounded">
                                                <small>Discount</small>
                                                <h2 class="mb-0">₹<t t-esc="state.discountValue.toFixed(2)"/></h2>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            
                            <t t-else="">
                                <div class="alert alert-warning mt-3 mb-0">
                                    Need minimum <t t-esc="state.cardData.min_redemption_points"/> points
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary btn-lg" t-on-click="cancel">Cancel</button>
                    <button class="btn btn-success btn-lg" t-on-click="confirmRedemption" t-att-disabled="!canRedeem">
                        Confirm Redemption
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
