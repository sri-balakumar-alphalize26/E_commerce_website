<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================================
         REPORT FILES (integrated from File 2 for Print Loyalty Card UI)
         ========================================================================= -->
    
    <!-- Custom Paper Format for ATM Card Size -->
    <record id="paperformat_loyalty_card" model="report.paperformat">
        <field name="name">Loyalty Card (ATM Size)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">54</field>
        <field name="page_width">86</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_loyalty_card" model="ir.actions.report">
        <field name="name">Loyalty Card</field>
        <field name="model">pos.loyalty.card</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_loyalty_card.report_loyalty_card_document</field>
        <field name="report_file">pos_loyalty_card.report_loyalty_card_document</field>
        <field name="print_report_name">'Loyalty_Card_%s' % (object.card_number)</field>
        <field name="binding_model_id" ref="model_pos_loyalty_card"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_loyalty_card"/>
    </record>
</odoo>
