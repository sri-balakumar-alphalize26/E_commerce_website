<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated product for loyalty discount lines on POS receipts -->
        <record id="product_loyalty_redemption" model="product.product">
            <field name="name">Loyalty Points Redemption</field>
            <field name="type">service</field>
            <field name="available_in_pos">True</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="list_price">0.0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
