<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Who may work with loyalty cards. These used to be Point of Sale's own
         user and manager groups; the module no longer needs Point of Sale. -->
    <record id="module_category_loyalty" model="ir.module.category">
        <field name="name">Loyalty</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_loyalty" model="res.groups.privilege">
        <field name="name">Loyalty Cards</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_loyalty"/>
    </record>

    <record id="group_loyalty_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_loyalty"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loyalty_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_loyalty"/>
        <field name="implied_ids" eval="[(4, ref('group_loyalty_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
