<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- History List View with proper earned/redeemed display -->
    <record id="view_loyalty_history_list" model="ir.ui.view">
        <field name="name">pos.loyalty.history.list</field>
        <field name="model">pos.loyalty.history</field>
        <field name="arch" type="xml">
            <list string="Points History" default_order="create_date desc">
                <field name="create_date" string="Date"/>
                <field name="card_id" string="Card"/>
                <field name="type" widget="badge"
                       decoration-success="type == 'earned'"
                       decoration-danger="type == 'redeemed'"
                       decoration-warning="type == 'returned'"
                       decoration-info="type == 'redeem_returned'"/>
                <field name="points" string="Points"
                       decoration-success="type == 'earned'"
                       decoration-danger="type == 'redeemed'"
                       decoration-warning="type == 'returned'"
                       decoration-info="type == 'redeem_returned'"/>
                <field name="description"/>
                <button name="action_open_order" type="object" string="View Order"
                        icon="fa-external-link" class="btn-link"
                        invisible="not order_id"/>
                <field name="amount" string="Order Amount" optional="show"/>
                <field name="order_id" string="POS Order" optional="show"/>
            </list>
        </field>
    </record>

    <!-- History Form View -->
    <record id="view_loyalty_history_form" model="ir.ui.view">
        <field name="name">pos.loyalty.history.form</field>
        <field name="model">pos.loyalty.history</field>
        <field name="arch" type="xml">
            <form string="Points History" create="false">
                <header>
                    <button name="action_open_order" type="object" string="View Order"
                            class="btn-primary" icon="fa-external-link"
                            invisible="not order_id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Transaction Details">
                            <field name="card_id" readonly="1"/>
                            <field name="type" readonly="1"/>
                            <field name="points" readonly="1"/>
                            <field name="description" readonly="1"/>
                        </group>
                        <group string="Order Information">
                            <field name="amount" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- History Search View -->
    <record id="view_loyalty_history_search" model="ir.ui.view">
        <field name="name">pos.loyalty.history.search</field>
        <field name="model">pos.loyalty.history</field>
        <field name="arch" type="xml">
            <search string="Search Points History">
                <field name="customer_name" string="Search" filter_domain="[
                    '|', '|', '|', '|', '|', '|',
                    ('card_number', 'ilike', self),
                    ('customer_name', 'ilike', self),
                    ('customer_phone', 'ilike', self),
                    ('description', 'ilike', self),
                    ('type', 'ilike', self),
                    ('order_id.name', 'ilike', self),
                    ('order_id.pos_reference', 'ilike', self)
                ]"/>
                <separator/>
                <filter name="filter_earned" string="Earned" domain="[('type', '=', 'earned')]"/>
                <filter name="filter_redeemed" string="Redeemed" domain="[('type', '=', 'redeemed')]"/>
                <filter name="filter_returned" string="Returned" domain="[('type', '=', 'returned')]"/>
                <filter name="filter_redeem_returned" string="Refunded (points back)" domain="[('type', '=', 'redeem_returned')]"/>
                <separator/>
                <filter name="group_card" string="Card" context="{'group_by': 'card_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- Action for Points History -->
    <record id="action_loyalty_history" model="ir.actions.act_window">
        <field name="name">Points History</field>
        <field name="res_model">pos.loyalty.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_date': 1, 'search_default_group_card': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No points history yet
            </p>
            <p>
                Points are automatically recorded when customers earn or redeem points at POS.
            </p>
        </field>
    </record>
</odoo>
