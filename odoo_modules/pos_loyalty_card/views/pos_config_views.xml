<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Enable Loyalty Cards" toggle to POS Settings page.
         Mobile number length / country dial code are configured globally under
         Configuration > Loyalty > Loyalty Settings. -->
    <record id="res_config_settings_view_form_loyalty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.loyalty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Loyalty Cards" id="pos_loyalty_card_section">
                    <setting string="Loyalty Cards" help="Loyalty is now managed in Configuration → Loyalty → Loyalty Settings (master switch + per-shop list).">
                        <field name="pos_enable_loyalty_cards" readonly="1"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
