<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Campaign list -->
    <record id="view_whatsapp_campaign_list" model="ir.ui.view">
        <field name="name">whatsapp.campaign.list</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <list string="Broadcasts">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state=='queued'"
                       decoration-success="state=='done'"
                       decoration-muted="state=='cancelled'"/>
                <field name="total_count" string="Total"/>
                <field name="sent_count" string="Sent"/>
                <field name="pending_count" string="Pending"/>
                <field name="failed_count" string="Failed"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Campaign form -->
    <record id="view_whatsapp_campaign_form" model="ir.ui.view">
        <field name="name">whatsapp.campaign.form</field>
        <field name="model">whatsapp.campaign</field>
        <field name="arch" type="xml">
            <form string="Broadcast">
                <header>
                    <button name="action_queue" type="object" string="Queue &amp; Send"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Queue this broadcast to all selected recipients? Messages send in the background."/>
                    <button name="action_cancel" type="object" string="Cancel Sending"
                            invisible="state != 'queued'"
                            confirm="Cancel the remaining pending messages?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,done"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Send offers or festival wishes to your loyalty customers over WhatsApp.
                        Messages are sent in the background at a safe pace (~20/min) to protect
                        the WhatsApp number. Use <b>{name}</b> in the message to personalise it.
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="recipient_mode" widget="radio"/>
                        <field name="card_ids" widget="many2many_tags"
                               invisible="recipient_mode != 'selected'"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" colspan="2"
                               placeholder="Happy Diwali {name}! 🎉 Enjoy 20% off this week at our store."/>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>
                    <group string="Progress" invisible="state == 'draft'">
                        <field name="total_count"/>
                        <field name="sent_count"/>
                        <field name="pending_count"/>
                        <field name="failed_count"/>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Recipients">
                            <field name="queue_ids" readonly="1">
                                <list>
                                    <field name="partner_name"/>
                                    <field name="phone"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='sent'"
                                           decoration-warning="state=='pending'"
                                           decoration-danger="state=='failed'"
                                           decoration-muted="state=='cancelled'"/>
                                    <field name="attempts"/>
                                    <field name="sent_date"/>
                                    <field name="error"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_campaign" model="ir.actions.act_window">
        <field name="name">Broadcast Offers</field>
        <field name="res_model">whatsapp.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first broadcast</p>
            <p>Send offers or festival wishes to all your loyalty customers over WhatsApp.</p>
        </field>
    </record>

    <!-- Read-only queue monitor -->
    <record id="view_whatsapp_send_queue_list" model="ir.ui.view">
        <field name="name">whatsapp.send.queue.list</field>
        <field name="model">whatsapp.send.queue</field>
        <field name="arch" type="xml">
            <list string="Send Queue" create="false">
                <field name="send_type"/>
                <field name="partner_name"/>
                <field name="phone"/>
                <field name="state" widget="badge"
                       decoration-success="state=='sent'"
                       decoration-warning="state=='pending'"
                       decoration-danger="state=='failed'"
                       decoration-muted="state=='cancelled'"/>
                <field name="scheduled_at"/>
                <field name="attempts"/>
                <field name="sent_date"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_send_queue" model="ir.actions.act_window">
        <field name="name">Send Queue</field>
        <field name="res_model">whatsapp.send.queue</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menus under the WhatsApp root -->
    <menuitem id="menu_whatsapp_broadcast"
              name="Broadcast Offers"
              parent="menu_whatsapp_root"
              action="action_whatsapp_campaign"
              groups="group_whatsapp_manager"
              sequence="25"/>

    <menuitem id="menu_whatsapp_send_queue"
              name="Send Queue"
              parent="menu_whatsapp_config"
              action="action_whatsapp_send_queue"
              groups="group_whatsapp_manager"
              sequence="30"/>

</odoo>
