<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Points Rule Form View -->
    <record id="view_pos_loyalty_points_rule_form" model="ir.ui.view">
        <field name="name">pos.loyalty.points.rule.form</field>
        <field name="model">pos.loyalty.points.rule</field>
        <field name="arch" type="xml">
            <form string="Points Rule">
                <header>
                    <button name="action_activate" 
                            string="Set as Active" 
                            type="object" 
                            class="btn-primary"
                            invisible="is_active == True"/>
                    <button name="action_deactivate" 
                            string="Deactivate" 
                            type="object" 
                            class="btn-warning"
                            invisible="is_active == False"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Default Points Rule"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Points Earning Rule">
                            <field name="currency_amount" string="Amount Spent (₹)"/>
                            <field name="points_earned" string="Points Earned"/>
                            <field name="points_value" string="Points Value (₹)"/>
                            <field name="conversion_display" readonly="1" string="Earning Summary"/>
                        </group>
                        <group string="Redemption Settings">
                            <field name="min_redemption_points" string="Minimum Points to Redeem"/>
                            <field name="redemption_points_per_unit" string="Points per ₹1 Discount"/>
                            <field name="max_redemption_percent" string="Max % of Order"/>
                            <field name="allow_partial_redemption" string="Allow Partial Redemption"/>
                            <field name="redemption_display" readonly="1" string="Redemption Summary"/>
                        </group>
                    </group>
                    <group>
                        <group string="Status">
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Points Rule List View -->
    <record id="view_pos_loyalty_points_rule_list" model="ir.ui.view">
        <field name="name">pos.loyalty.points.rule.list</field>
        <field name="model">pos.loyalty.points.rule</field>
        <field name="arch" type="xml">
            <list string="Points Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="currency_amount" string="Amount (₹)"/>
                <field name="points_earned" string="Points Earned"/>
                <field name="min_redemption_points" string="Min Redeem"/>
                <field name="redemption_points_per_unit" string="Pts/₹1"/>
                <field name="conversion_display" string="Earning Rule"/>
                <field name="redemption_display" string="Redemption Rule"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Points Rule Search View -->
    <record id="view_pos_loyalty_points_rule_search" model="ir.ui.view">
        <field name="name">pos.loyalty.points.rule.search</field>
        <field name="model">pos.loyalty.points.rule</field>
        <field name="arch" type="xml">
            <search string="Search Points Rules">
                <field name="name"/>
                <separator/>
                <filter name="active_rules" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive_rules" string="Inactive" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action: Points Rule -->
    <record id="action_pos_loyalty_points_rule" model="ir.actions.act_window">
        <field name="name">Points Rule</field>
        <field name="res_model">pos.loyalty.points.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_rules': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first points conversion rule
            </p>
            <p>
                Define how customers earn and redeem points.
                Example: ₹100 spent = 10 points, Minimum 5000 points to redeem, 10 points = ₹1 discount
            </p>
        </field>
    </record>
</odoo>
