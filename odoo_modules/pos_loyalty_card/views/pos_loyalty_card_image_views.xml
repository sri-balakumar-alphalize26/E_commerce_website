<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_card_image_list" model="ir.ui.view">
        <field name="name">pos.loyalty.card.image.list</field>
        <field name="model">pos.loyalty.card.image</field>
        <field name="arch" type="xml">
            <list string="Card Images" create="0">
                <field name="create_date"/>
                <field name="card_number"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="points"/>
                <field name="event_type"/>
                <field name="image" widget="image" options="{'size': [64, 40], 'zoom': true, 'zoom_delay': 0}"/>
            </list>
        </field>
    </record>

    <record id="view_loyalty_card_image_kanban" model="ir.ui.view">
        <field name="name">pos.loyalty.card.image.kanban</field>
        <field name="model">pos.loyalty.card.image</field>
        <field name="arch" type="xml">
            <kanban default_group_by="card_number" create="0">
                <field name="card_number"/>
                <field name="customer_name"/>
                <field name="points"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="padding:6px;">
                            <field name="image" widget="image" class="w-100" options="{'zoom': true}"/>
                            <div style="margin-top:4px;">
                                <strong><field name="card_number"/></strong>
                                <div><field name="customer_name"/></div>
                                <div><field name="points"/> pts</div>
                                <div class="text-muted"><field name="create_date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_loyalty_card_image_form" model="ir.ui.view">
        <field name="name">pos.loyalty.card.image.form</field>
        <field name="model">pos.loyalty.card.image</field>
        <field name="arch" type="xml">
            <form string="Card Image" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="card_number"/>
                            <field name="customer_name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="points"/>
                            <field name="event_type"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <field name="image" widget="image" nolabel="1" class="w-100"
                           options="{'zoom': true}" style="max-width: 520px;"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loyalty_card_image_search" model="ir.ui.view">
        <field name="name">pos.loyalty.card.image.search</field>
        <field name="model">pos.loyalty.card.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="card_number"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <filter name="grp_date" string="Date" context="{'group_by': 'snapshot_day'}"/>
                <filter name="grp_card" string="Card Number" context="{'group_by': 'card_number'}"/>
            </search>
        </field>
    </record>

    <record id="action_loyalty_card_image" model="ir.actions.act_window">
        <field name="name">Card Images</field>
        <field name="res_model">pos.loyalty.card.image</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'group_by': ['snapshot_day', 'card_number']}</field>
    </record>

    <record id="action_loyalty_card_image_download" model="ir.actions.act_window">
        <field name="name">Download Card Images</field>
        <field name="res_model">pos.loyalty.card.image.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_loyalty_card_images" name="Card Images"
              parent="menu_sec_images" action="action_loyalty_card_image" sequence="10"/>
    <menuitem id="menu_loyalty_card_images_download" name="Download Card Images (ZIP)"
              parent="menu_sec_images" action="action_loyalty_card_image_download" sequence="20"/>
</odoo>
