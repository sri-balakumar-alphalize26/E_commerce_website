<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Orders sits first in the 369 Mart menu, ahead of the configuration
        screens. The others are opened when something needs setting up; this one
        is open all day, so it should not be the fifth thing down the list.

        Home Page 10, Product Page 15, Customers 20, Addresses 30, Payments 40.
    -->

    <menuitem id="menu_mart369_orders"
              name="Orders"
              parent="mart369_home.menu_mart369_root"
              action="action_mart369_orders"
              groups="sales_team.group_sale_salesman"
              sequence="5"/>

    <menuitem id="menu_mart369_returns"
              name="Returns"
              parent="mart369_home.menu_mart369_root"
              action="action_mart369_returns"
              groups="sales_team.group_sale_salesman"
              sequence="6"/>

</odoo>
