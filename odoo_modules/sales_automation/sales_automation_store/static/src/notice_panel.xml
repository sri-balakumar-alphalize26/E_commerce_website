<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_automation_store.NoticePanel">
        <t t-if="data.allowed">
            <aside t-if="data.panel" class="sa_side" aria-label="Sales notifications">
                <header class="sa_side_head">
                    <i class="fa fa-bell sa_side_bell" role="img" aria-hidden="true"/>
                    <div class="sa_side_title"><b>Notifications</b>
                        <small t-if="count"><t t-esc="count"/> need your look</small><small t-else="">All read</small></div>
                    <button type="button" class="sa_side_x" t-on-click="() => this.notice.fold()" aria-label="Fold to the side" title="Fold">&#10005;</button>
                </header>

                <div class="sa_side_list">
                    <section t-foreach="sections" t-as="s" t-key="s.key" class="sa_side_section">
                        <button type="button" class="sa_side_sect" t-on-click="() => this.toggle(s.key)" t-att-aria-expanded="state.shut[s.key] ? 'false' : 'true'">
                            <span><i class="fa" t-att-class="state.shut[s.key] ? 'fa-caret-right' : 'fa-caret-down'" role="img" aria-hidden="true"/> <t t-esc="s.name"/></span>
                            <span class="sa_side_n" t-esc="s.count"/>
                        </button>
                        <t t-if="!state.shut[s.key]">
                            <article t-foreach="s.waiting" t-as="w" t-key="w.id" class="sa_side_note amber">
                                <span class="sa_side_icon"><i class="fa" t-att-class="icon(w)" role="img" aria-hidden="true"/></span>
                                <div class="sa_side_text">
                                    <div class="sa_side_top"><b t-esc="words(w)"/><small t-esc="when(w.at)"/></div>
                                    <div class="sa_side_body">Ref <t t-esc="w.ref"/> &#183; <t t-esc="w.product"/> &#215; <t t-esc="w.qty"/><t t-if="w.customer"> &#183; <t t-esc="w.customer"/></t></div>
                                    <div class="sa_side_do"><button type="button" class="btn btn-sm btn-primary" t-on-click="() => this.notice.openEnquiry(w.id)">Open</button></div>
                                </div>
                            </article>
                            <article t-foreach="s.rows" t-as="row" t-key="row.id" class="sa_side_note" t-att-class="row.level">
                                <span class="sa_side_icon"><i class="fa" t-att-class="icon(row)" role="img" aria-hidden="true"/></span>
                                <div class="sa_side_text">
                                    <div class="sa_side_top"><b t-esc="row.title"/><small t-esc="when(row.at)"/></div>
                                    <div class="sa_side_body" t-esc="row.body"/>
                                    <div class="sa_side_do">
                                        <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.notice.open(row.id)">Open</button>
                                        <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.notice.seen([row.id])">Mark as read</button>
                                    </div>
                                </div>
                            </article>
                            <button t-if="s.rows.length > 1" type="button" class="btn btn-link btn-sm sa_side_all" t-on-click="() => this.readAll(s)">Mark these as read</button>
                        </t>
                    </section>
                    <div t-if="!count" class="sa_side_none"><i class="fa fa-check-circle" role="img" aria-hidden="true"/><br/>Nothing new. You are up to date.</div>
                </div>
            </aside>

            <t t-else="">
                <div class="sa_pop" role="status" t-ref="pop" t-if="cards.length or aside" t-attf-style="top: {{state.top}}px">
                    <article t-foreach="cards" t-as="c" t-key="c.key" class="sa_pop_card" t-att-class="c.key">
                        <span class="sa_pop_ico"><span class="sa_shake"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2a2 2 0 0 0-2 2v.4A6 6 0 0 0 6 10v5l-2 3h16l-2-3v-5a6 6 0 0 0-4-5.6V4a2 2 0 0 0-2-2z"/><path d="M9.5 19.5a2.5 2.5 0 0 0 5 0z"/></svg></span></span>
                        <div><b t-esc="c.title"/><div t-esc="c.text"/>
                            <button t-if="c.list" type="button" class="btn btn-link btn-sm p-0" t-on-click="() => this.notice.unfold()">See the list</button></div>
                        <button type="button" class="sa_pop_x" t-on-click="() => this.notice.tuck(c.key)" aria-label="Move to the side" title="Move to the side">&#10005;</button>
                        <button type="button" class="sa_pop_go" t-on-click="() => this.notice.openSection(c)"><t t-esc="c.go"/> &#8594;</button>
                    </article>
                    <button t-if="aside" type="button" class="sa_pop_tab" t-on-click="() => this.notice.untuck()"
                            t-att-aria-label="'Show notifications, ' + aside" title="Notifications">
                        <span aria-hidden="true">&#8249;</span><span class="sa_shake"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2a2 2 0 0 0-2 2v.4A6 6 0 0 0 6 10v5l-2 3h16l-2-3v-5a6 6 0 0 0-4-5.6V4a2 2 0 0 0-2-2z"/><path d="M9.5 19.5a2.5 2.5 0 0 0 5 0z"/></svg></span><span class="sa_pop_n" t-esc="aside"/>
                    </button>
                </div>
                <button t-else="" type="button" class="sa_side_tab" t-on-click="() => this.notice.unfold()" aria-label="Open notifications" title="Notifications">
                    <span aria-hidden="true">&lt;</span>
                </button>
            </t>
        </t>
    </t>
</templates>
