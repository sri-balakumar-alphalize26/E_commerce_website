<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Hourly, but it only acts in the hour named in Delivery Settings -
            so the shop can move the reminder without anybody editing a cron.
            An order waiting on a supplier is otherwise invisible the next
            morning: the counter screen shows today's work, and nobody
            re-reads yesterday's.
        -->
        <record id="cron_sa_supply_remind" model="ir.cron">
            <field name="name">Store: Remind the Shop About Waiting Stock</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model._cron_sa_supply_remind()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="priority">40</field>
        </record>

    </data>
</odoo>
