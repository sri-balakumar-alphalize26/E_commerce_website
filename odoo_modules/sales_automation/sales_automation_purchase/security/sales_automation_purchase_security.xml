<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- As for the enquiries: a user sees the ones of their own employee session. -->
        <record id="rule_sa_buy_line_own" model="ir.rule">
            <field name="name">Items to buy: own employee session only</field>
            <field name="model_id" ref="model_sa_buy_line"/>
            <field name="groups" eval="[(4, ref('sales_automation.group_sa_user'))]"/>
            <field name="domain_force">[('request_id.group_id.employee_session_id.employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_sa_buy_line_manager" model="ir.rule">
            <field name="name">Items to buy: all</field>
            <field name="model_id" ref="model_sa_buy_line"/>
            <field name="groups" eval="[(4, ref('sales_automation.group_sa_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_sa_buy_line_company" model="ir.rule">
            <field name="name">Items to buy: company</field>
            <field name="model_id" ref="model_sa_buy_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
