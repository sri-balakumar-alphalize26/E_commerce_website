<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sa_delivery_partner_list" model="ir.ui.view">
        <field name="name">sa.delivery.partner.list</field>
        <field name="model">sa.delivery.partner</field>
        <field name="arch" type="xml">
            <list string="Riders and Couriers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="phone"/>
                        <field name="vehicle"/>
                <field name="on_duty" widget="boolean_toggle"/>
                <field name="fleet_state"/>
                <field name="address_short"/>
                <field name="last_fix_on"/>
                <field name="shop_ids" widget="many2many_tags"/>
                <field name="open_count" string="In Hand"/>
                <field name="delivery_count" string="Total"/>
            </list>
        </field>
    </record>

    <record id="view_sa_delivery_partner_form" model="ir.ui.view">
        <field name="name">sa.delivery.partner.form</field>
        <field name="model">sa.delivery.partner</field>
        <field name="arch" type="xml">
            <form string="Rider or Courier">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_duty" type="object"
                                class="oe_stat_button" icon="fa-power-off">
                            <field name="on_duty" widget="boolean_toggle"
                                   string="On Duty"/>
                        </button>
                        <button name="action_open_deliveries" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="delivery_count" widget="statinfo"
                                   string="Deliveries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Rider name or courier company"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind" widget="radio"/>
                            <field name="phone" widget="wa_phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="shop_ids" widget="many2many_tags"/>
                            <field name="tz"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The job is sent to this WhatsApp number, and replies are
                        accepted <b>only</b> from it. Leave <b>Shops Served</b>
                        empty to serve every shop.
                        <br/>
                        Only riders <b>on duty</b> are offered new work. When
                        nobody is on duty a job waits in <b>To Dispatch</b>, and
                        is handed to the next rider who clocks on. Going off
                        duty never takes back a job already accepted.
                    </div>
                    <group string="Duty">
                        <field name="fleet_state"/>
                        <field name="duty_since" readonly="1" invisible="not on_duty"/>
                        <field name="address_short"/>
                        <field name="address_full"/>
                        <field name="last_lat"/>
                        <field name="last_lng"/>
                        <field name="last_fix_on"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Vehicle, working hours, areas refused..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sa_delivery_partner_kanban" model="ir.ui.view">
        <field name="name">sa.delivery.partner.kanban</field>
        <field name="model">sa.delivery.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="fleet_state" quick_create="false"
                    group_create="false" records_draggable="false">
                <field name="fleet_state"/>
                <field name="on_duty"/>
                <field name="is_busy"/>
                <field name="phone"/>
                <field name="address_short"/>
                <field name="last_fix_on"/>
                <field name="open_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-1">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <span class="badge rounded-pill text-bg-success ms-auto"
                                  t-if="record.fleet_state.raw_value == 'idle'">Free</span>
                            <span class="badge rounded-pill text-bg-warning ms-auto"
                                  t-elif="record.fleet_state.raw_value == 'busy'">Busy</span>
                            <span class="badge rounded-pill text-bg-secondary ms-auto"
                                  t-else="">Off duty</span>
                        </div>
                        <div class="text-muted"><field name="phone"/></div>
                        <div t-if="record.address_short.raw_value">
                            <i class="fa fa-map-marker" title="Last position"/> <field name="address_short"/>
                        </div>
                        <div class="small text-muted" t-if="record.last_fix_on.raw_value">
                            position at <field name="last_fix_on"/>
                        </div>
                        <div class="small" t-if="record.open_count.raw_value">
                            in hand: <field name="open_count"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sa_delivery_partner_search" model="ir.ui.view">
        <field name="name">sa.delivery.partner.search</field>
        <field name="model">sa.delivery.partner</field>
        <field name="arch" type="xml">
            <search string="Riders and Couriers">
                <field name="name"/>
                <field name="phone"/>
                <filter name="p_on_duty" string="On Duty"
                        domain="[('on_duty','=',True)]"/>
                <separator/>
                <filter name="p_own" string="Own Riders"
                        domain="[('kind','=','own')]"/>
                <filter name="p_third" string="Delivery Partners"
                        domain="[('kind','=','third_party')]"/>
                <group>
                    <filter name="p_g_kind" string="Kind"
                            context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sa_delivery_partner" model="ir.actions.act_window">
        <field name="name">Riders &amp; Couriers</field>
        <field name="res_model">sa.delivery.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sa_delivery_partner_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first rider</p>
            <p>Own riders are offered a job before outside couriers. All that
               is needed is a name and a WhatsApp number.</p>
        </field>
    </record>

</odoo>
