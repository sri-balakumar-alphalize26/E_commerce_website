<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Delivery > Fleet > Live Map: every rider on one map. A client
         action: it redraws itself every 15 s and draws on a map, which no
         list view does. -->
    <record id="action_sa_fleet_map" model="ir.actions.client">
        <field name="name">Live Map</field>
        <field name="tag">sales_automation_delivery.fleet_map</field>
    </record>

    <menuitem id="menu_sa_delivery_fleet"
              name="Fleet"
              parent="menu_sa_delivery_root"
              sequence="3"/>

    <menuitem id="menu_sa_delivery_fleet_map"
              name="Live Map"
              parent="menu_sa_delivery_fleet"
              action="action_sa_fleet_map"
              sequence="1"/>

    <menuitem id="menu_sa_delivery_fleet_riders"
              name="Riders &amp; Couriers"
              parent="menu_sa_delivery_fleet"
              action="action_sa_delivery_partner"
              sequence="2"/>

</odoo>
