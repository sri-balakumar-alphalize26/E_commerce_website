<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The Sync Groups button, on the session form the groups belong to.

        Appended inside the header that is already there, rather than aimed at
        a particular field or button: whatsapp_gateway's form is shared with
        whatsapp_broadcast and whatsapp_email, and an xpath onto a node one of
        them moves takes the whole form down with an "owl lifecycle" error that
        names nothing. `position="inside"` on the container survives whatever
        those two do to its contents.
    -->
    <record id="view_whatsapp_session_form_sa_groups" model="ir.ui.view">
        <field name="name">whatsapp.session.form.sa.groups</field>
        <field name="model">whatsapp.session</field>
        <field name="inherit_id" ref="whatsapp_gateway.view_whatsapp_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sa_sync_groups" type="object"
                        string="Sync Groups" class="btn-secondary"
                        groups="sales_automation.group_sa_manager"
                        help="Fetch every group this number has joined, then tick the ones that should answer product enquiries."/>
            </xpath>
            <xpath expr="//div[@name='setup_buttons']" position="inside">
                <button name="action_sa_sync_groups" type="object" string="Sync Groups"
                        class="btn-primary" invisible="setup_next != 'groups'"
                        groups="sales_automation.group_sa_manager"/>
            </xpath>
            <!-- the groups of this number, those that are on first -->
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Groups" name="sa_groups" groups="sales_automation.group_sa_user">
                    <div class="text-muted mb-2" invisible="sa_group_ids">
                        No group is known for this number yet. Press <b>Sync Groups</b> above.
                    </div>
                    <field name="sa_group_ids" readonly="1" nolabel="1">
                        <list decoration-muted="not enabled" create="0" delete="0" default_order="enabled desc, name">
                            <field name="name"/>
                            <field name="group_type"/>
                            <field name="enabled" string="On" widget="boolean"/>
                            <field name="employee_session_id" string="Employee"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="member_count" string="Members"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_whatsapp_session_list_sa_groups" model="ir.ui.view">
        <field name="name">whatsapp.session.list.sa.groups</field>
        <field name="model">whatsapp.session</field>
        <field name="inherit_id" ref="whatsapp_gateway.view_whatsapp_session_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="before">
                <field name="sa_group_count"/>
            </xpath>
        </field>
    </record>

</odoo>
