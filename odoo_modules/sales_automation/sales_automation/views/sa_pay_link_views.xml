<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sa_pay_link" model="ir.ui.view">
        <field name="name">sale.order.form.sa.pay.link</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="sa_can_send_pay_link" invisible="1"/>
                <button name="action_sa_send_pay_link" type="object" string="Send payment link"
                        invisible="not sa_can_send_pay_link"
                        confirm="The payment link goes to the customer's WhatsApp group now. Go on?"/>
            </xpath>
        </field>
    </record>
</odoo>
