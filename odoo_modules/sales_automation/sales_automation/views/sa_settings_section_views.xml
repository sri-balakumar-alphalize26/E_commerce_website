<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One page per heading. All of them edit the same sa.ai.settings
         record; only the form differs. The opener actions resolve the
         singleton and pin the section's form view. -->

    <!-- ============ The Shop Counter ============ -->
    <record id="view_sa_settings_counter_form" model="ir.ui.view">
        <field name="name">sa.settings.counter.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <form string="The Shop Counter">
                <sheet>
                    <group>
                        <group>
                            <field name="shop_picks_vendors"/>
                            <field name="shop_pick_window_minutes"
                                   invisible="not shop_picks_vendors"/>
                            <field name="shop_pick_customer_text"
                                   invisible="not shop_picks_vendors"
                                   placeholder="Our shopkeeper is checking {product} and will come back"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                On, an out-of-stock enquiry waits on the
                                <b>Store &gt; Enquiries</b> screen with an
                                alarm, so somebody who knows the trade picks
                                which suppliers to ask. Nobody is messaged
                                until they do.
                                <br/><br/>
                                With nobody at the counter for the number of
                                minutes above, every vendor of that product's
                                category is asked automatically - an
                                unattended shop still answers the customer.
                                <br/><br/>
                                The message uses
                                <code>{product}</code>, <code>{ref}</code>,
                                <code>{customer}</code> and
                                <code>{shop}</code>. Keep one of them in it:
                                WhatsApp drops a message identical to one sent
                                to the same chat minutes earlier, so text with
                                nothing varying in it arrives as silence.
                                <br/><br/>
                                How long the alarm sounds is set under
                                <b>Delivery Settings &gt; The Enquiry Desk</b>.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Vendors ============ -->
    <record id="view_sa_settings_vendor_form" model="ir.ui.view">
        <field name="name">sa.settings.vendor.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">41</field>
        <field name="arch" type="xml">
            <form string="Vendors &amp; Customer Replies">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <b>What happens with the settings below</b>
                        <field name="easy_example" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="1. Asking the vendors">
                            <label for="sourcing_window_minutes" string="Wait for vendor prices"/>
                            <div><field name="sourcing_window_minutes" class="oe_inline"/> minutes
                                <div class="text-muted small">Then the lowest price is taken. All have answered: no more waiting. Usually 5 to 15.</div></div>
                            <label for="vendor_money" string="Vendors type the price in"/>
                            <div><field name="vendor_money" widget="radio"/>
                                <div class="text-muted small">Another currency than yours needs a rate in Odoo, at most a week old.</div></div>
                            <label for="price_escalation_phone" string="Nobody answers: tell this number"/>
                            <div><field name="price_escalation_phone" widget="wa_phone"/>
                                <div class="text-muted small">Gets a WhatsApp with a link to type the price. Empty: it only waits on Store &gt; Enquiries.</div></div>
                            <label for="easy_vendors" string="Who is asked"/>
                            <div><field name="easy_vendors" readonly="1" class="d-inline"/>
                                <button name="action_sa_open_categories" type="object" string="Set the vendors" class="btn-link p-0 ms-2"/>
                                <div class="text-muted small">On each product category, under WhatsApp Sourcing.</div></div>
                        </group>
                        <group string="2. The price for the customer">
                            <label for="margin_percent" string="Your margin"/>
                            <div><field name="margin_percent" class="oe_inline"/> %
                                <div class="text-muted small">Added to the lowest vendor price. 20 makes 100 into 120.</div></div>
                            <label for="price_approval_enabled" string="Ask me first when the prices differ"/>
                            <div><field name="price_approval_enabled" widget="boolean_toggle"/>
                                <div class="text-muted small">On: when the product page has another price, you choose on Store &gt; Enquiries.
                                    Off: the customer gets the vendor price plus your margin at once.</div></div>
                            <label for="price_approval_tolerance_percent" string="Ignore small differences"
                                   invisible="not price_approval_enabled"/>
                            <div invisible="not price_approval_enabled"><field name="price_approval_tolerance_percent" class="oe_inline"/> %
                                <div class="text-muted small">0 asks you always. 5 does not ask while the two are within 5%.</div></div>
                        </group>
                    </group>
                    <group>
                        <group string="3. Waiting for the customer">
                            <label for="customer_reply_minutes" string="Customer must answer within"/>
                            <div><field name="customer_reply_minutes" class="oe_inline"/> minutes
                                <div class="text-muted small">Then the enquiry is closed and the customer is told. 0: a whole day. Starts again with every message we send.</div></div>
                        </group>
                        <group string="4. Orders not paid yet">
                            <label for="pay_remind_minutes" string="Remind after"/>
                            <div><field name="pay_remind_minutes" class="oe_inline"/> minutes
                                <div class="text-muted small">In the group, and again after the same time. 0: never.</div></div>
                            <label for="pay_remind_max" string="How many reminders"/>
                            <div><field name="pay_remind_max" class="oe_inline"/> at most</div>
                        </group>
                    </group>
                    <group string="Rarely needed">
                        <div class="text-muted small mb-2" colspan="2">Only products of your own catalogue are offered to customers, so an enquiry normally
                            needs neither of these.</div>
                        <field name="unlisted_vendor_ids" string="Extra vendors (not by category)" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="Leave empty"/>
                        <field name="new_product_category_id" string="Category of a product made from an enquiry"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Delivery Address ============ -->
    <record id="view_sa_settings_address_form" model="ir.ui.view">
        <field name="name">sa.settings.address.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">42</field>
        <field name="arch" type="xml">
            <form string="Delivery Address">
                <sheet>
                    <group>
                        <group>
                            <field name="pincode_country_id"
                                   options="{'no_create': True}"/>
                            <field name="pincode_prefixes"
                                   placeholder="e.g. 691,690,682"/>
                            <field name="stale_after_minutes"/>
                            <field name="max_order_quantity"/>
                            <field name="address_link_enabled"/>
                            <field name="address_link_minutes"
                                   invisible="not address_link_enabled"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                The postcode is checked against the customer's
                                own country - six digits for India, three for
                                Oman, letters and digits for the UK - falling
                                back to the country above. Countries that issue
                                no postcode are not asked for one. Repeated
                                digits and straight runs like <b>111111</b> or
                                <b>123456</b> are always refused. To check a
                                postcode really exists, list the areas you
                                deliver to.
                            </div>
                            <div class="text-muted mt-3" invisible="not address_link_enabled">
                                <b>Address form link:</b> when a new address is
                                needed, the customer also gets a private link to
                                a form like the shop's Delivery Address page. It
                                works once; when they save it, the group moves on
                                to the read-back. Typing the answers in the group
                                still works.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Messages That Are Not Enquiries ============ -->
    <record id="view_sa_settings_chatter_form" model="ir.ui.view">
        <field name="name">sa.settings.chatter.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">43</field>
        <field name="arch" type="xml">
            <form string="Messages That Are Not Enquiries">
                <sheet>
                    <group>
                        <group>
                            <field name="chatter_action"/>
                            <field name="chatter_reply_text"
                                   invisible="chatter_action != 'reply'"/>
                            <field name="media_action"/>
                            <field name="media_reply_text"
                                   invisible="media_action != 'reply'"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                A sales group is mostly members talking to each
                                other, so both of these say nothing by default.
                                Turn them on for a quiet group, where silence
                                reads as the assistant being broken.
                                <br/><br/>
                                Either reply is sent at most
                                <b>once per person per minute</b>, so a burst
                                of chat or a shared photo album cannot become a
                                burst of replies.
                                <br/><br/>
                                <b>Keep no record of it</b> stops photos and
                                video being stored in 369ai. Abusive messages are
                                handled by the <b>Conduct Filter</b> page.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Bargaining ============ -->
    <record id="view_sa_settings_bargain_form" model="ir.ui.view">
        <field name="name">sa.settings.bargain.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">44</field>
        <field name="arch" type="xml">
            <form string="Bargaining">
                <sheet>
                    <group>
                        <group>
                            <field name="margin_percent"/>
                            <field name="bargain_enabled"/>
                            <field name="bargain_step_percent"
                                   invisible="not bargain_enabled"/>
                            <field name="bargain_max_steps"
                                   invisible="not bargain_enabled"/>
                            <field name="min_margin_percent"
                                   invisible="not bargain_enabled"/>
                        </group>
                        <group>
                            <field name="bargain_hint" nolabel="1"
                                   readonly="1" class="text-muted"/>
                            <div class="text-muted">
                                The customer is quoted cost plus the
                                <b>Margin</b> above. Each time they push back
                                the price drops by one step, and it stops at
                                <b>Lowest Margin</b> - so bargaining only ever
                                spends the difference between the two.
                                <br/><br/>
                                Products bargaining by <b>quantity range</b>
                                (below, or on the product form) ignore this
                                flat step: BETTER PRICE appears only when the
                                customer's quantity is inside a range, and gives
                                that range's discount once.
                            </div>
                        </group>
                    </group>
                    <group string="Quantity Ranges" invisible="not bargain_enabled">
                        <group>
                            <field name="qty_bargain_all"/>
                            <field name="qty_bargain_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="qty_min"/>
                                    <field name="qty_max"/>
                                    <field name="percent"/>
                                </list>
                            </field>
                        </group>
                        <group>
                            <div class="text-muted">
                                Shop-wide ranges: <b>From</b> and <b>To</b>
                                pieces, and the discount for that quantity.
                                Leave <b>To</b> at 0 for no upper limit. Ranges
                                must not overlap.
                                <br/><br/>
                                They apply to every product ticked
                                <b>Quantity bargaining on WhatsApp</b> on its
                                form that has no ranges of its own - or to
                                <b>every</b> product when the switch above is
                                on. A product's own table always wins.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Guided Finder ============ -->
    <record id="view_sa_settings_finder_form" model="ir.ui.view">
        <field name="name">sa.settings.finder.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <form string="Guided Finder">
                <sheet>
                    <group>
                        <group>
                            <field name="finder_enabled"/>
                            <field name="finder_max_options"
                                   invisible="not finder_enabled"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                A generic word opens a tap-only finder in the group:
                                the brands and products of this database, one poll
                                after the other. Nothing comes from the internet.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Customer Links (21 Nov 2026) ============ -->
    <record id="view_sa_settings_links_form" model="ir.ui.view">
        <field name="name">sa.settings.links.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">47</field>
        <field name="arch" type="xml">
            <form string="Customer Links">
                <sheet>
                    <div class="text-muted mb-3">
                        Where each link goes. <b>Private chat</b>: the customer's own
                        chat, with a short note in the group. <b>Group</b>: posted in
                        the group, marked "only for" the customer. When the private
                        chat is not possible (WhatsApp hides the number, or refuses
                        the message) it goes to the group the same way. Polls always
                        stay in the group. Also on the 369 Mart console, WhatsApp tab.
                    </div>
                    <group>
                        <group string="Send to">
                            <field name="link_confirm" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_address" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_sign" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_pay" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_track" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_map" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_review" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_web" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_docs" widget="radio" options="{'horizontal': true}"/>
                            <field name="link_shop" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Around it">
                            <field name="link_group_note"/>
                        </group>
                    </group>
                    <group>
                        <group string="A product we don't sell">
                            <div colspan="2" class="text-muted">Only products of this database are offered. For anything else the
                                customer is told we don't have it, with this number. A product without stock goes to the vendors.</div>
                            <field name="shop_contact_phone" widget="wa_phone" options="{'plus': True, 'landline': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sa_settings_links" model="ir.actions.server">
        <field name="name">Customer Links</field>
        <field name="model_id" ref="model_sa_ai_settings"/>
        <field name="state">code</field>
        <field name="code">
action = {'type': 'ir.actions.act_window', 'name': 'Customer Links', 'res_model': 'sa.ai.settings',
          'res_id': model.get_settings().id, 'view_mode': 'form', 'target': 'current',
          'views': [[env.ref('sales_automation.view_sa_settings_links_form').id, 'form']]}
        </field>
    </record>
    <record id="view_sa_settings_payments_form" model="ir.ui.view">
        <field name="name">sa.settings.payments.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">48</field>
        <field name="arch" type="xml">
            <form string="Payments">
                <sheet>
                    <group string="When the payment link is sent">
                        <field name="pay_link_in_stock" widget="radio" options="{'horizontal': true}"/>
                        <field name="pay_link_no_stock" widget="radio" options="{'horizontal': true}"/>
                        <field name="pay_link_words" nolabel="1" colspan="2" class="alert alert-info"/>
                    </group>
                    <div class="text-muted">Send payment link on the counter and on the sales order works in every case.
                        Not used when the flow ends at the order or at the invoice (Delivery Settings).</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sa_settings_payments" model="ir.actions.server">
        <field name="name">Payments</field>
        <field name="model_id" ref="model_sa_ai_settings"/>
        <field name="state">code</field>
        <field name="code">
action = {'type': 'ir.actions.act_window', 'name': 'Payments', 'res_model': 'sa.ai.settings',
          'res_id': model.get_settings().id, 'view_mode': 'form', 'target': 'current',
          'views': [[env.ref('sales_automation.view_sa_settings_payments_form').id, 'form']]}
        </field>
    </record>

    <menuitem id="menu_sa_settings_payments" name="Payments"
              parent="menu_sa_config" action="action_sa_settings_payments" sequence="32"/>
    <menuitem id="menu_sa_settings_links" name="Customer Links"
              parent="menu_sa_config" action="action_sa_settings_links" sequence="33"/>

