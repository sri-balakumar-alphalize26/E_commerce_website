    <!-- ============ Human Takeover ============ -->
    <record id="view_sa_settings_takeover_form" model="ir.ui.view">
        <field name="name">sa.settings.takeover.form</field>
        <field name="model">sa.ai.settings</field>
        <field name="priority">47</field>
        <field name="arch" type="xml">
            <form string="Human Takeover">
                <sheet>
                    <group>
                        <group>
                            <field name="takeover_enabled"/>
                            <field name="takeover_minutes" invisible="not takeover_enabled"/>
                            <field name="takeover_numbers" invisible="not takeover_enabled"
                                   widget="text" placeholder="919876543210&#10;96877123456"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                When a shopkeeper writes in a chat, the assistant
                                stops answering there. Every shopkeeper message
                                restarts the clock; once they have been quiet for
                                the minutes set here, the next customer message is
                                answered by the assistant again.
                                <br/><br/>
                                The shop phone itself counts too: anything typed on
                                it that the assistant did not send is treated as the
                                shopkeeper. Other staff numbers go in the list.
                                <br/><br/>
                                In a group the whole group pauses. In a private chat
                                only the assistant's conversation pauses - a
                                supplier's price and a customer's coded reply still
                                get through.
                            </div>
                        </group>
                    </group>
                    <separator string="Right now"/>
                    <field name="takeover_status" nolabel="1" readonly="1" widget="text"
                           class="font-monospace"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sa_settings_takeover" model="ir.actions.server">
        <field name="name">Human Takeover</field>
        <field name="model_id" ref="model_sa_ai_settings"/>
        <field name="state">code</field>
        <field name="code">
action = {'type': 'ir.actions.act_window', 'name': 'Human Takeover', 'res_model': 'sa.ai.settings',
          'res_id': model.get_settings().id, 'view_mode': 'form', 'target': 'current',
          'views': [[env.ref('sales_automation.view_sa_settings_takeover_form').id, 'form']]}
        </field>
    </record>

    <menuitem id="menu_sa_settings_takeover" name="Human Takeover"
              parent="menu_sa_config" action="action_sa_settings_takeover" sequence="38"/>

</odoo>
