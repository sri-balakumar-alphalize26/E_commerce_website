<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sa_sales_group_list" model="ir.ui.view">
        <field name="name">sa.sales.group.list</field>
        <field name="model">sa.sales.group</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Groups" editable="bottom" create="false" open_form_view="True"
                  decoration-info="group_type == 'vendor'">
                <field name="enabled" widget="boolean_toggle" string="On"/>
                <field name="name" readonly="1"/>
                <field name="group_type"/>
                <field name="company_id" optional="show"
                       groups="base.group_multi_company"/>
                <field name="session_id" readonly="1"/>
                <field name="employee_session_id" optional="show"/>
                <field name="invite_url" string="Invite Link" optional="show"
                       placeholder="https://chat.whatsapp.com/..."/>
                <field name="member_count" readonly="1" optional="hide"/>
                <field name="markup_percent" string="Margin %" optional="show"/>
                <field name="auto_confirm_order" optional="hide"/>
                <field name="ai_enabled" optional="hide"/>
                <field name="require_confirmation" optional="hide"/>
                <field name="handoff_dm" optional="hide"/>
                <field name="request_count" string="Enquiries" optional="show"/>
                <field name="order_count" string="Orders" optional="hide"/>
                <field name="group_jid" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_sa_sales_group_form" model="ir.ui.view">
        <field name="name">sa.sales.group.form</field>
        <field name="model">sa.sales.group</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Group">
                <header>
                    <button name="action_sync_groups" type="object"
                            string="Sync Groups" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-comments-o">
                            <field name="request_count" widget="statinfo" string="Enquiries"/>
                        </button>
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="group_type != 'customer'">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_quotes" type="object"
                                class="oe_stat_button" icon="fa-tags"
                                invisible="group_type != 'vendor'">
                            <field name="quote_count" widget="statinfo" string="Quotes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Disabled" bg_color="text-bg-secondary"
                            invisible="enabled"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Group name"/></h1>
                    </div>
                    <group>
                        <group string="Link">
                            <field name="enabled" widget="boolean_toggle"/>
                            <field name="group_type"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   groups="base.group_multi_company"/>
                            <field name="session_id" options="{'no_create': True}"/>
                            <field name="employee_session_id"
                                   options="{'no_create': True}"
                                   invisible="group_type != 'customer'"
                                   required="group_type == 'customer' and enabled"/>
                            <field name="group_jid" readonly="1"/>
                            <label for="invite_url" invisible="group_type != 'customer'"/>
                            <div class="o_row" invisible="group_type != 'customer'">
                                <field name="invite_url" widget="url"
                                       placeholder="https://chat.whatsapp.com/..."/>
                                <button name="action_sa_get_invite_link" type="object"
                                        string="Get invite link" icon="fa-link" class="btn-link"
                                        help="Ask WhatsApp for this group's invite link (the shop's number must be a group admin)."/>
                            </div>
                            <div colspan="2" class="text-muted small" invisible="group_type != 'customer'">
                                <field name="invite_hint" nolabel="1"/>
                            </div>
                            <div colspan="2" class="text-danger small"
                                 invisible="group_type != 'customer' or not invite_error">
                                <field name="invite_error" nolabel="1"/>
                            </div>
                            <field name="member_count" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>

                        <group string="Categories Priced Here"
                               invisible="group_type != 'vendor'">
                            <field name="product_category_ids" nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   colspan="2"
                                   placeholder="Which categories can this group quote?"/>
                            <field name="is_fallback_vendor_group"/>
                            <field name="sourcing_window_minutes"/>
                        </group>

                        <group string="Behaviour"
                               invisible="group_type != 'customer'">
                            <field name="ai_enabled"/>
                            <field name="min_confidence"/>
                            <field name="max_products"/>
                            <field name="require_confirmation"/>
                            <field name="handoff_dm"/>
                            <field name="use_virtual_stock"/>
                        </group>
                        <group string="Pricing"
                               invisible="group_type != 'customer'">
                            <field name="markup_percent"/>
                            <field name="group_use_buttons"/>
                            <field name="dm_use_buttons"/>
                            <field name="auto_confirm_order"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="group_type != 'vendor'">
                        Messages in a vendor group are read only as prices
                        against an open request. Nothing is classified as an
                        enquiry here, and the bot never replies.
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="group_type != 'customer' or handoff_dm">
                        Prices are posted <b>in this group</b>, so every member
                        sees them. Turn on <b>Continue in Private Chat</b> to
                        keep them between you and the person who asked.
                    </div>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Anything worth knowing about this group..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sa_sales_group_search" model="ir.ui.view">
        <field name="name">sa.sales.group.search</field>
        <field name="model">sa.sales.group</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Groups">
                <field name="name"/>
                <field name="group_jid"/>
                <field name="session_id"/>
                <field name="product_category_ids"/>
                <filter name="filter_customer" string="Customer Groups"
                        domain="[('group_type', '=', 'customer')]"/>
                <filter name="filter_vendor" string="Vendor Groups"
                        domain="[('group_type', '=', 'vendor')]"/>
                <separator/>
                <filter name="filter_enabled" string="Sales Automation On"
                        domain="[('enabled', '=', True)]"/>
                <filter name="filter_disabled" string="Off"
                        domain="[('enabled', '=', False)]"/>
                <group>
                    <filter name="group_by_type" string="Group Type"
                            context="{'group_by': 'group_type'}"/>
                    <filter name="group_by_session" string="WhatsApp Session"
                            context="{'group_by': 'session_id'}"/>
                    <filter name="group_by_employee" string="Employee Session"
                            context="{'group_by': 'employee_session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sa_sales_group" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">sa.sales.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sa_sales_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No groups linked yet</p>
            <p>
                Open a WhatsApp session and press <b>Sync Groups</b> to pull in
                every group the number has joined, then tick the ones that
                should answer product enquiries.
            </p>
        </field>
    </record>

    <!-- Get invite links for the selected groups (21 Nov 2026) -->
    <record id="action_sa_group_get_invite_links" model="ir.actions.server">
        <field name="name">Get invite links</field>
        <field name="model_id" ref="model_sa_sales_group"/>
        <field name="binding_model_id" ref="model_sa_sales_group"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_sa_get_invite_link()</field>
    </record>

</odoo>
