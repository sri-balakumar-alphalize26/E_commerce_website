<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_sales_automation" model="ir.module.category">
            <field name="name">WhatsApp Sales Automation</field>
            <field name="description">Answer product enquiries posted in WhatsApp groups.</field>
            <field name="sequence">45</field>
        </record>

        <!--
            369ai 19 moved the category off res.groups: a group now points at a
            res.groups.privilege, and the privilege carries the category. There
            is no `category_id` on res.groups any more - setting one raises
            "Invalid field 'category_id' in 'res.groups'" during install.
        -->
        <record id="res_groups_privilege_sales_automation" model="res.groups.privilege">
            <field name="name">WhatsApp Sales Automation</field>
            <field name="sequence">45</field>
            <field name="category_id" ref="module_category_sales_automation"/>
        </record>

        <!--
            Two real groups, and every ACL below is bound to one of them.
            whatsapp_employee_tracker left group_id empty on all twelve of its
            access lines, which hands every user in the database full CRUD on
            every employee's private conversations. That is not repeated here.
        -->
        <record id="group_sa_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sales_automation"/>
            <field name="comment">See and work the group enquiries routed to your own WhatsApp session.</field>
        </record>

        <record id="group_sa_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sales_automation"/>
            <field name="implied_ids" eval="[(4, ref('group_sa_user'))]"/>
            <field name="comment">Link groups, set pricing and AI settings, and see every enquiry.</field>
        </record>

        <!--
            A user sees the enquiries from groups routed to the employee
            session that is their own. Managers see everything.
        -->
        <record id="rule_sa_group_request_own" model="ir.rule">
            <field name="name">Group enquiries: own employee session only</field>
            <field name="model_id" ref="model_sa_group_request"/>
            <field name="groups" eval="[(4, ref('group_sa_user'))]"/>
            <field name="domain_force">[('group_id.employee_session_id.employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_sa_group_request_manager" model="ir.rule">
            <field name="name">Group enquiries: all</field>
            <field name="model_id" ref="model_sa_group_request"/>
            <field name="groups" eval="[(4, ref('group_sa_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_sa_sales_group_own" model="ir.rule">
            <field name="name">Sales groups: own employee session only</field>
            <field name="model_id" ref="model_sa_sales_group"/>
            <field name="groups" eval="[(4, ref('group_sa_user'))]"/>
            <field name="domain_force">[('employee_session_id.employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_sa_sales_group_manager" model="ir.rule">
            <field name="name">Sales groups: all</field>
            <field name="model_id" ref="model_sa_sales_group"/>
            <field name="groups" eval="[(4, ref('group_sa_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    
    <!-- Administration > Settings gets these menus without a hand-tick on
         every new database: the admin group implies the module's manager group. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sa_manager'))]"/>
    </record>
</data>
</odoo>
