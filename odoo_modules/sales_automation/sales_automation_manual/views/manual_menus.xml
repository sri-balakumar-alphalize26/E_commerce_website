<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 27 Nov 2026 (1.4.0): ONE "Help" at the end of each app's top menu (Sales
         Automation, Store, Delivery, Insights). It opens the WhatsApp Help pop-up on
         static/help/help.html?app=..: "User Manual" (the app's manual or the Full
         manual) and "How It Works" (the app's step guide + video). The old
         "📖 User Manual" entries are gone: removing them here deletes them on upgrade.
         ?v=4 in every url: browsers keep static pages 7 days - bump it with changes. -->
    <record id="action_sa_help_sa" model="ir.actions.client">
        <field name="name">Sales Automation Help</field>
        <field name="tag">sales_automation_manual.help</field>
        <field name="params" eval="{'url': '/sales_automation_manual/static/help/help.html?app=sa&amp;v=4'}"/>
    </record>
    <record id="action_sa_help_store" model="ir.actions.client">
        <field name="name">Store Help</field>
        <field name="tag">sales_automation_manual.help</field>
        <field name="params" eval="{'url': '/sales_automation_manual/static/help/help.html?app=store&amp;v=4'}"/>
    </record>
    <record id="action_sa_help_delivery" model="ir.actions.client">
        <field name="name">Delivery Help</field>
        <field name="tag">sales_automation_manual.help</field>
        <field name="params" eval="{'url': '/sales_automation_manual/static/help/help.html?app=delivery&amp;v=4'}"/>
    </record>
    <record id="action_sa_help_insights" model="ir.actions.client">
        <field name="name">Insights Help</field>
        <field name="tag">sales_automation_manual.help</field>
        <field name="params" eval="{'url': '/sales_automation_manual/static/help/help.html?app=insights&amp;v=4'}"/>
    </record>

    <menuitem id="menu_sa_help_sa" name="Help"
              parent="sales_automation.menu_sa_root" action="action_sa_help_sa" sequence="9999"/>
    <menuitem id="menu_sa_help_store" name="Help"
              parent="sales_automation_store.menu_sa_store_root" action="action_sa_help_store" sequence="9999"/>
    <menuitem id="menu_sa_help_delivery" name="Help"
              parent="sales_automation_delivery.menu_sa_delivery_root" action="action_sa_help_delivery" sequence="9999"/>
    <menuitem id="menu_sa_help_insights" name="Help"
              parent="sales_automation_insights.menu_sa_insights_root" action="action_sa_help_insights" sequence="9999"/>
</odoo>
