<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sa_wechat_message_list" model="ir.ui.view">
        <field name="name">sa.wechat.message.list</field>
        <field name="model">sa.wechat.message</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="create_date" string="When"/>
                <field name="direction"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('sent', 'received', 'relayed')"
                       decoration-warning="state in ('queued', 'claimed')"
                       decoration-danger="state == 'failed'"/>
                <field name="wechat_name"/>
                <field name="wx_step" optional="show"/>
                <field name="partner_id"/>
                <field name="request_id"/>
                <field name="quote_id" optional="show"/>
                <field name="error" optional="show"/>
                <field name="text" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sa_wechat_message_form" model="ir.ui.view">
        <field name="name">sa.wechat.message.form</field>
        <field name="model">sa.wechat.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_link_vendor" type="object" string="Link this remark to the vendor"
                            class="btn-primary" invisible="direction != 'in' or not partner_id or not error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="direction"/>
                            <field name="state"/>
                            <field name="wechat_name"/>
                            <field name="wx_step"/>
                            <field name="partner_id"/>
                            <field name="request_id"/>
                            <field name="quote_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Created"/>
                            <field name="claimed_on"/>
                            <field name="sent_on"/>
                            <field name="received_at"/>
                            <field name="bridge_id"/>
                            <field name="wx_id"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <group string="Text">
                        <field name="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sa_wechat_message_search" model="ir.ui.view">
        <field name="name">sa.wechat.message.search</field>
        <field name="model">sa.wechat.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="wechat_name"/>
                <field name="partner_id"/>
                <field name="request_id"/>
                <field name="text"/>
                <filter name="out" string="To vendors" domain="[('direction', '=', 'out')]"/>
                <filter name="in" string="From vendors" domain="[('direction', '=', 'in')]"/>
                <filter name="failed" string="Failed / unknown" domain="['|', ('state', '=', 'failed'), ('error', '!=', False)]"/>
                <separator/>
                <filter name="by_state" string="Group by state" context="{'group_by': 'state'}"/>
                <filter name="by_vendor" string="Group by vendor" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_sa_wechat_message" model="ir.actions.act_window">
        <field name="name">WeChat Messages</field>
        <field name="res_model">sa.wechat.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WeChat messages yet</p>
            <p>Price checks to WeChat vendors and their replies appear here once the bridge runs.</p>
        </field>
    </record>

    <menuitem id="menu_sa_wechat_messages" name="WeChat Messages"
              parent="sales_automation.menu_sa_root" action="action_sa_wechat_message" sequence="45"/>
</odoo>
