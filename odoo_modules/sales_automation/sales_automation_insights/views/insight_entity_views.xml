<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sa_insight_entity_list" model="ir.ui.view">
        <field name="name">sa.insight.entity.list</field>
        <field name="model">sa.insight.entity</field>
        <field name="arch" type="xml">
            <list create="false" default_order="stars desc, enquiry_count desc">
                <field name="kind" widget="badge"/>
                <field name="name"/>
                <field name="phone" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="stars"/>
                <field name="tier" widget="badge"
                       decoration-success="tier == 'best'" decoration-info="tier == 'better'"
                       decoration-danger="tier == 'poor'" decoration-muted="tier == 'new'"/>
                <field name="enough_data" widget="boolean_toggle" readonly="1"/>
                <field name="sample_size"/>
                <field name="enquiry_count"/>
                <field name="order_count"/>
                <field name="delivered_count"/>
                <field name="cancelled_count"/>
                <field name="revenue_total" sum="Total"/>
                <field name="last_seen_on" optional="show"/>
                <field name="merged_into_id" optional="hide"/>
                <field name="key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sa_insight_entity_form" model="ir.ui.view">
        <field name="name">sa.insight.entity.form</field>
        <field name="model">sa.insight.entity</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_recompute" type="object"
                            string="Recompute All" class="btn-primary"
                            groups="sales_automation.group_sa_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="kind" readonly="1"/>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="key" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="phone_tail" readonly="1"/>
                            <field name="lid" readonly="1"/>
                            <!-- The one thing a manager edits here. -->
                            <field name="merged_into_id"
                                   domain="[('kind', '=', kind), ('id', '!=', id)]"
                                   options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Rating">
                            <field name="stars" readonly="1"/>
                            <field name="score_total" readonly="1"/>
                            <field name="enough_data" readonly="1"/>
                            <field name="sample_size" readonly="1"/>
                            <field name="scored_on" readonly="1"/>
                        </group>
                        <group string="Counts">
                            <field name="enquiry_count" readonly="1"/>
                            <field name="order_count" readonly="1"/>
                            <field name="delivered_count" readonly="1"/>
                            <field name="cancelled_count" readonly="1"/>
                            <field name="open_threads" readonly="1"/>
                            <field name="revenue_total" readonly="1"/>
                        </group>
                        <group string="Seen">
                            <field name="first_seen_on" readonly="1"/>
                            <field name="last_seen_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Other Spellings">
                            <field name="alias_ids" readonly="1">
                                <list>
                                    <field name="tail"/>
                                    <field name="lid"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                        <page string="Records Scored">
                            <field name="request_ids" readonly="1"/>
                            <field name="quote_ids" readonly="1"/>
                            <field name="picking_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sa_insight_entity_search" model="ir.ui.view">
        <field name="name">sa.insight.entity.search</field>
        <field name="model">sa.insight.entity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <filter name="f_customers" string="Customers" domain="[('kind','=','customer')]"/>
                <filter name="f_vendors" string="Suppliers" domain="[('kind','=','vendor')]"/>
                <filter name="f_scored" string="Rated" domain="[('enough_data','=',True)]"/>
                <separator/>
                <filter name="f_best" string="Best" domain="[('tier','=','best')]"/>
                <filter name="f_better" string="Better" domain="[('tier','=','better')]"/>
                <filter name="f_normal" string="Normal" domain="[('tier','=','normal')]"/>
                <filter name="f_poor" string="Poor" domain="[('tier','=','poor')]"/>
                <filter name="f_new" string="New (not enough data)" domain="[('tier','=','new')]"/>
                <filter name="f_flagged" string="Flagged" domain="[('remarks_count','>',0)]"/>
                <filter name="f_merged" string="Merged" domain="[('merged_into_id','!=',False)]"/>
                <group>
                    <filter name="g_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sa_insight_entities" model="ir.actions.act_window">
        <field name="name">Rated Rows</field>
        <field name="res_model">sa.insight.entity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sa_insight_entity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing rated yet</p>
            <p>Open a dashboard and press Recompute, or wait for tonight's run.</p>
        </field>
    </record>

</odoo>
