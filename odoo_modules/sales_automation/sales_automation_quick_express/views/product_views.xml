<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_qe" model="ir.ui.view">
        <field name="name">product.template.form.qe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery" name="qe_delivery">
                    <group>
                        <field name="qe_delivery_text"
                               placeholder="Delivered in 5-7 days"/>
                    </group>
                    <div class="text-muted">
                        Leave empty for a product that can go Quick. A product
                        with a delivery text is always Express.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
