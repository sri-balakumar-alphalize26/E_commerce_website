<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mart369_cart.DeliveryDesk">
    <Layout display="{ controlPanel: {} }" className="'o_mart369_delivery h-100'">
        <div class="mart-builder pe dv">

            <header class="pe-head">
                <div>
                    <h1>Delivery</h1>
                    <p>
                        What a delivery costs, when it can arrive, and where we go.
                        The app reads these the moment they are saved.
                    </p>
                </div>
                <div class="dv-head-act">
                    <button t-if="state.tab === 'slots'" class="mart-btn mart-btn-primary"
                            t-att-disabled="state.busy" t-on-click="() => this.openSlot(null)">
                        <Icon n="'plus'" size="14"/> New slot
                    </button>
                    <button t-if="state.tab === 'areas'" class="mart-btn mart-btn-primary"
                            t-att-disabled="state.busy" t-on-click="() => this.openArea(null)">
                        <Icon n="'plus'" size="14"/> New area
                    </button>
                    <button class="mart-btn" t-on-click="() => this.allViews()">
                        <Icon n="'menu'" size="14"/> All views
                    </button>
                </div>
            </header>

            <p t-if="state.error" class="pe-error" role="alert">
                We could not reach the shop. <t t-esc="state.error"/>
                <button class="mart-link" t-on-click="() => this.load()">Try again</button>
            </p>

            <!-- The two things that are wrong in a way nobody would
                 otherwise see. Said once, above the tabs, because neither of
                 them shows on the tab you would be looking at. -->
            <p t-if="dark.length" class="dv-warn" role="status">
                <Icon n="'warn'" size="14"/>
                <span>
                    <t t-foreach="dark" t-as="rule" t-key="rule.id">
                        <b t-esc="rule.modeLabel"/><t t-if="!rule_last">, </t>
                    </t>
                    is switched off - nothing from it can be bought.
                </span>
            </p>
            <p t-if="shut.length" class="dv-warn" role="status">
                <Icon n="'warn'" size="14"/>
                <span>
                    No slot is open for
                    <t t-foreach="shut" t-as="mode" t-key="mode.key">
                        <b t-esc="mode.label"/><t t-if="!mode_last"> or </t>
                    </t>, so it has nothing to offer at checkout.
                </span>
            </p>
            <p t-if="!state.loading and !state.areas.length" class="dv-warn" role="status">
                <Icon n="'warn'" size="14"/>
                <span>No service area is on, so every pincode is told we do not
                    deliver there yet.</span>
            </p>
            <p t-if="unready.length" class="dv-warn" role="status">
                <Icon n="'warn'" size="14"/>
                <span>
                    Quick is on at
                    <t t-foreach="unready" t-as="branch" t-key="branch.id">
                        <b t-esc="branch.name"/><t t-if="!branch_last">, </t>
                    </t>
                    but it has no map pin or no reach, so it delivers Quick to nobody.
                    <t t-foreach="unready" t-as="branch" t-key="'fix-' + branch.id">
                        <button type="button" class="dv-fix" t-att-disabled="state.busy"
                                t-on-click="() => this.openBranch(branch)">
                            Add pin and reach at <t t-esc="branch.name"/>
                        </button>
                    </t>
                </span>
            </p>

            <div class="pe-toolbar dv-toolbar">
                <div class="mart-tabs" role="tablist">
                    <button t-foreach="TABS" t-as="tab" t-key="tab.key" role="tab"
                            t-att-aria-selected="state.tab === tab.key ? 'true' : 'false'"
                            t-attf-class="{{ state.tab === tab.key ? 'mart-on' : '' }}"
                            t-on-click="() => this.pick(tab.key)">
                        <Icon n="tab.icon" size="15"/>
                        <t t-esc="tab.label"/>
                        <em t-esc="tabCount(tab)"/>
                    </button>
                </div>
            </div>

            <!-- =============================== fees =============================== -->
            <div t-if="state.tab === 'fees'" class="dv-rules">
                <section t-foreach="state.rules" t-as="rule" t-key="rule.id" class="dv-rule">
                    <header>
                        <h2 t-esc="rule.modeLabel"/>
                        <span class="mart-pill mart-t-grey" t-esc="rule.mode"/>
                        <Switch on="draft(rule).active"
                                label="rule.modeLabel + ' delivery on'"
                                disabled="state.busy"
                                onChange="(on) => this.setFee(rule, 'active', on)"/>
                    </header>

                    <div class="dv-form">
                        <label class="dv-field"><span>Shown as</span>
                            <input type="text" placeholder="Quick"
                                   t-att-value="draft(rule).label"
                                   t-on-input="(ev) => this.setFee(rule, 'label', ev.target.value)"/></label>
                        <label class="dv-field"><span>Delivery promise</span>
                            <input type="text" placeholder="Delivery in 13 mins"
                                   t-att-value="draft(rule).eta"
                                   t-on-input="(ev) => this.setFee(rule, 'eta', ev.target.value)"/></label>
                        <label class="dv-field"><span>Minimum order</span>
                            <input type="text" inputmode="decimal" placeholder="0"
                                   t-att-value="draft(rule).min_order"
                                   t-on-input="(ev) => this.setFee(rule, 'min_order', ev.target.value)"/></label>
                        <label class="dv-field"><span>Free delivery above</span>
                            <input type="text" inputmode="decimal" placeholder="0"
                                   t-att-value="draft(rule).free_above"
                                   t-on-input="(ev) => this.setFee(rule, 'free_above', ev.target.value)"/></label>
                        <label class="dv-field"><span>Delivery fee</span>
                            <input type="text" inputmode="decimal" placeholder="0"
                                   t-att-value="draft(rule).fee"
                                   t-on-input="(ev) => this.setFee(rule, 'fee', ev.target.value)"/></label>
                    </div>

                    <p class="mart-hint dv-says">
                        <t t-esc="sentence(rule)"/>
                        <t t-if="minimum(rule)"> <t t-esc="minimum(rule)"/></t>
                    </p>

                    <footer>
                        <span t-if="dirty(rule)" class="dv-unsaved">Unsaved changes</span>
                        <button class="mart-btn mart-btn-primary"
                                t-att-disabled="state.busy or !dirty(rule)"
                                t-on-click="() => this.saveRule(rule)">
                            Save <t t-esc="rule.modeLabel"/>
                        </button>
                    </footer>
                </section>

                <p t-if="!state.loading and !state.rules.length" class="mart-empty">
                    <b>No delivery rules</b>
                    Neither storefront has a rule, so the basket has no fee to show.
                </p>
            </div>

            <!-- ============================== slots =============================== -->
            <div t-if="state.tab === 'slots'" class="dv-table-wrap">
                <table t-if="state.slots.length" class="dv-table">
                    <thead>
                        <tr>
                            <th>Chip</th><th>Storefront</th><th>Kind</th><th>When</th>
                            <th class="dv-num">Fee</th><th class="dv-num">Cap</th>
                            <th>State</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.slots" t-as="slot" t-key="slot.id"
                            t-attf-class="{{ slot.active ? '' : 'dv-row-off' }}">
                            <td>
                                <b t-esc="slot.top"/>
                                <small><t t-esc="slot.sub or '—'"/> · <t t-esc="slot.key"/></small>
                            </td>
                            <td t-esc="slot.modeLabel"/>
                            <td t-esc="slot.kindLabel"/>
                            <td>
                                <t t-esc="when(slot) or '—'"/>
                                <small t-esc="which(slot)"/>
                            </td>
                            <td class="dv-num">
                                <t t-if="slot.fee" t-esc="money(slot.fee)"/>
                                <t t-else="">Free</t>
                            </td>
                            <td class="dv-num">
                                <t t-if="slot.capacity" t-esc="slot.capacity"/>
                                <t t-else="">∞</t>
                            </td>
                            <td>
                                <span t-if="slot.active" class="mart-pill mart-t-green">On</span>
                                <span t-else="" class="mart-pill mart-t-grey">Off</span>
                            </td>
                            <td class="dv-act">
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.openSlot(slot)">Edit</button>
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.toggleSlot(slot)">
                                    <t t-if="slot.active">Switch off</t>
                                    <t t-else="">Put back</t>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p t-if="!state.loading and !state.slots.length" class="mart-empty">
                    <b>No slots</b>
                    The checkout has no window to offer. Add one and it appears on
                    the slot step.
                </p>
            </div>

            <!-- ============================== areas =============================== -->
            <div t-if="state.tab === 'areas'" class="dv-table-wrap">
                <table t-if="state.areas.length" class="dv-table">
                    <thead>
                        <tr>
                            <th>Pincode</th><th>Area</th><th>We deliver</th>
                            <th>Promise</th><th>State</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.areas" t-as="area" t-key="area.id"
                            t-attf-class="{{ area.active ? '' : 'dv-row-off' }}">
                            <td>
                                <b t-esc="area.pincode"/>
                                <small t-if="area.pincode.length &lt; 6">and everything under it</small>
                            </td>
                            <td><t t-esc="area.name or '—'"/></td>
                            <td>
                                <span t-if="area.quick or area.express" class="mart-pill mart-t-green">Yes</span>
                                <span t-else="" class="mart-pill mart-t-grey">No</span>
                            </td>
                            <td t-esc="area.eta or '—'"/>
                            <td>
                                <span t-if="area.active" class="mart-pill mart-t-green">On</span>
                                <span t-else="" class="mart-pill mart-t-grey">Off</span>
                            </td>
                            <td class="dv-act">
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.openArea(area)">Edit</button>
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.toggleArea(area)">
                                    <t t-if="area.active">Switch off</t>
                                    <t t-else="">Put back</t>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p t-if="!state.loading and !state.areas.length" class="mart-empty">
                    <b>Nowhere is covered</b>
                    With no area on the list every pincode is told we do not deliver
                    there. Add the ones you reach.
                </p>
            </div>

            <!-- ============================= branches ============================= -->
            <div t-if="state.tab === 'branches'" class="dv-table-wrap">
                <p class="mart-hint dv-branch-hint">
                    An item is <b>Quick</b> when a branch with Quick on is within its
                    reach of the customer's map pin <b>and</b> has the item in stock.
                    Otherwise it ships Express. An address with no map pin follows its
                    pincode in Service areas.
                </p>
                <table t-if="state.branches.length" class="dv-table">
                    <thead>
                        <tr>
                            <th>Branch</th><th>Company</th><th>Map pin</th>
                            <th>Quick</th><th>Reach</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.branches" t-as="branch" t-key="branch.id"
                            t-attf-class="{{ branch.quick ? '' : 'dv-row-off' }}">
                            <td>
                                <b t-esc="branch.name"/>
                                <small t-esc="branch.code"/>
                            </td>
                            <td t-esc="branch.company or '—'"/>
                            <td>
                                <t t-if="branch.lat !== null">
                                    <t t-esc="branch.lat.toFixed(4)"/>, <t t-esc="branch.lng.toFixed(4)"/>
                                </t>
                                <span t-else="" class="mart-pill mart-t-grey">No pin</span>
                            </td>
                            <td>
                                <span t-if="branch.unready" class="mart-pill mart-t-amber">Not ready</span>
                                <span t-elif="branch.quick" class="mart-pill mart-t-green">On</span>
                                <span t-else="" class="mart-pill mart-t-grey">Off</span>
                            </td>
                            <td>
                                <t t-if="branch.quickKm"><t t-esc="branch.quickKm"/> km</t>
                                <t t-else="">—</t>
                            </td>
                            <td class="dv-act">
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.openBranch(branch)">Edit</button>
                                <button class="mart-btn mart-btn-sm" t-att-disabled="state.busy"
                                        t-on-click="() => this.toggleBranch(branch)">
                                    <t t-if="branch.quick">Quick off</t>
                                    <t t-else="">Quick on</t>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p t-if="!state.loading and !state.branches.length" class="mart-empty">
                    <b>No branches yet</b>
                    A branch is a warehouse. Add one in Inventory, then set its
                    Quick reach here.
                </p>
            </div>

        </div>
    </Layout>
</t>

<!-- ============================== slot dialog ============================== -->
<t t-name="mart369_cart.SlotDialog">
    <Dialog size="'lg'" contentClass="'dv-dialog'"
            title="state.draft.id ? 'Edit slot' : 'New slot'">
        <div class="dv-dialog-body">
            <p class="dv-sub">A chip on the checkout's slot step. Pick the kind, the
                day and the time - the heading, detail, key and order fill
                themselves in, and anything you type over stays.</p>
            <p t-if="state.error" class="dv-error" role="alert" t-esc="state.error"/>

            <h3>What the chip says</h3>
            <div class="dv-form">
                <label class="dv-field"><span>Heading</span>
                    <input type="text" placeholder="Today" t-att-value="state.draft.top"
                           t-on-input="(ev) => this.set('top', ev.target.value)"/></label>
                <label class="dv-field"><span>Detail</span>
                    <input type="text" placeholder="6 - 8 PM" t-att-value="state.draft.sub"
                           t-on-input="(ev) => this.set('sub', ev.target.value)"/></label>
                <label class="dv-field dv-span2"><span>Confirmation line</span>
                    <input type="text" t-att-value="state.draft.label"
                           t-att-placeholder="labelPreview"
                           t-on-input="(ev) => this.set('label', ev.target.value)"/></label>
            </div>

            <h3>Which storefront, and what kind</h3>
            <div class="dv-form">
                <div class="dv-field"><span>Storefront</span>
                    <div class="dv-choice" role="radiogroup">
                        <button t-foreach="props.modes" t-as="mode" t-key="mode.key" type="button"
                                role="radio" t-att-aria-checked="state.draft.mode === mode.key ? 'true' : 'false'"
                                t-attf-class="{{ state.draft.mode === mode.key ? 'dv-on' : '' }}"
                                t-on-click="() => this.set('mode', mode.key)" t-esc="mode.label"/>
                    </div>
                </div>
                <div class="dv-field"><span>Kind</span>
                    <div class="dv-choice" role="radiogroup">
                        <button t-foreach="props.kinds" t-as="kind" t-key="kind.key" type="button"
                                role="radio" t-att-aria-checked="state.draft.kind === kind.key ? 'true' : 'false'"
                                t-attf-class="{{ state.draft.kind === kind.key ? 'dv-on' : '' }}"
                                t-on-click="() => this.set('kind', kind.key)" t-esc="kind.label"/>
                    </div>
                </div>
                <label t-if="!state.draft.id" class="dv-field"><span>Key</span>
                    <input type="text" placeholder="eve" t-att-value="state.draft.key"
                           t-on-input="(ev) => this.set('key', ev.target.value)"/></label>
                <label class="dv-field"><span>Order in the list</span>
                    <input type="text" inputmode="numeric" placeholder="10"
                           t-att-value="state.draft.sequence"
                           t-on-input="(ev) => this.set('sequence', ev.target.value)"/></label>
            </div>
            <p t-if="!state.draft.id" class="mart-hint">
                The key is how the app and every order refer to this slot. It is
                filled in for you - change it if you like, but it cannot be
                changed after saving. If it is already used, a number is added.
            </p>

            <h3>When it runs</h3>
            <div class="dv-form">
                <label t-if="isWindow" class="dv-field">
                    <span>From <em t-esc="clock(state.draft.from_hour)"/></span>
                    <input type="text" inputmode="decimal" placeholder="18"
                           t-att-value="state.draft.from_hour"
                           t-on-input="(ev) => this.set('from_hour', ev.target.value)"/></label>
                <label t-if="isWindow" class="dv-field">
                    <span>To <em t-esc="clock(state.draft.to_hour)"/></span>
                    <input type="text" inputmode="decimal" placeholder="20"
                           t-att-value="state.draft.to_hour"
                           t-on-input="(ev) => this.set('to_hour', ev.target.value)"/></label>
                <label class="dv-field"><span>Days ahead</span>
                    <input type="text" inputmode="numeric" placeholder="0"
                           t-att-value="state.draft.day_offset"
                           t-on-input="(ev) => this.set('day_offset', ev.target.value)"/></label>
                <label class="dv-field">
                    <span>Stop offering after <em t-esc="clock(state.draft.order_before)"/></span>
                    <input type="text" inputmode="decimal" placeholder="24"
                           t-att-value="state.draft.order_before"
                           t-on-input="(ev) => this.set('order_before', ev.target.value)"/></label>
            </div>
            <p class="mart-hint">
                Hours are numbers: 18.5 is 6:30 PM. 0 is today and 1 is tomorrow.
                Leave the cut-off at 24 and the slot is always offered.
            </p>

            <h3>What it costs, and how many it takes</h3>
            <div class="dv-form">
                <label class="dv-field"><span>Extra fee</span>
                    <input type="text" inputmode="decimal" placeholder="0"
                           t-att-value="state.draft.fee"
                           t-on-input="(ev) => this.set('fee', ev.target.value)"/></label>
                <label class="dv-field"><span>Orders per slot</span>
                    <input type="text" inputmode="numeric" placeholder="0"
                           t-att-value="state.draft.capacity"
                           t-on-input="(ev) => this.set('capacity', ev.target.value)"/></label>
            </div>
            <p class="mart-hint">
                0 orders means no limit. Once a window is full the app stops
                offering it for that day on its own.
            </p>
        </div>

        <t t-set-slot="footer">
            <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy"
                    t-on-click="() => this.save()">
                <t t-if="state.draft.id">Save changes</t>
                <t t-else="">Add slot</t>
            </button>
            <button class="mart-btn" t-on-click="() => this.props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

<!-- ============================= branch dialog ============================= -->
<t t-name="mart369_cart.BranchDialog">
    <Dialog contentClass="'dv-dialog'" title="'Quick delivery from ' + props.branch.name">
        <div class="dv-dialog-body">
            <p t-if="state.error" class="dv-error" role="alert" t-esc="state.error"/>

            <div class="dv-rows">
                <div class="dv-row">
                    <span><b>Quick delivery</b><small>Riders from this branch deliver to customers nearby</small></span>
                    <Switch on="state.draft.quick"
                            label="'Quick delivery'"
                            onChange="() => this.toggleQuick()"/>
                </div>
            </div>

            <h3>How far riders go</h3>
            <div class="dv-form">
                <label class="dv-field"><span>Quick, up to (km)</span>
                    <input type="text" inputmode="decimal" placeholder="5"
                           t-att-value="state.draft.quickKm"
                           t-on-input="(ev) => this.set('quickKm', ev.target.value)"/></label>
                <label class="dv-field"><span>Quick when a rider is free, up to (km)</span>
                    <input type="text" inputmode="decimal" placeholder="15"
                           t-att-value="state.draft.maybeKm"
                           t-on-input="(ev) => this.set('maybeKm', ev.target.value)"/></label>
            </div>
            <p t-if="quickTimes" class="dv-quick-time">
                Customers are told <b t-esc="quickTimes"/>, depending on how far
                they are. Nobody types it: 10 minutes to pack, then 5 minutes
                for every km.
            </p>
            <p class="mart-hint">
                Customers closer than the first number get Quick. Between the two
                numbers they are told Express, and it comes Quick if a rider is
                free. Farther away is Express. The km are a straight line on the
                map, so keep them a little short of the real road.
            </p>

            <h3>Delivery fees</h3>
            <div class="dv-rows">
                <div class="dv-row">
                    <span><b>Own delivery fees</b><small>Off: this branch charges the shop's usual fees</small></span>
                    <Switch on="state.draft.ownFees"
                            label="'Own delivery fees'"
                            onChange="() => this.set('ownFees', !state.draft.ownFees)"/>
                </div>
            </div>
            <div t-if="state.draft.ownFees" class="dv-form">
                <label class="dv-field"><span>Quick fee</span>
                    <input type="text" inputmode="decimal" placeholder="0.500"
                           t-att-value="state.draft.quickFee"
                           t-on-input="(ev) => this.set('quickFee', ev.target.value)"/></label>
                <label class="dv-field"><span>Express fee</span>
                    <input type="text" inputmode="decimal" placeholder="1.000"
                           t-att-value="state.draft.expressFee"
                           t-on-input="(ev) => this.set('expressFee', ev.target.value)"/></label>
                <label class="dv-field"><span>Free delivery above</span>
                    <input type="text" inputmode="decimal" placeholder="10.000"
                           t-att-value="state.draft.freeAbove"
                           t-on-input="(ev) => this.set('freeAbove', ev.target.value)"/></label>
            </div>
            <p class="mart-hint">
                Amounts are in the shop's money. "Free delivery above 10" means a
                customer buying more than 10 from this branch pays no delivery.
                If a basket comes from two branches, each branch charges its own
                fee for its own items.
            </p>

            <h3>Where the branch is</h3>
            <div class="dv-form">
                <label class="dv-field"><span>Latitude</span>
                    <input type="text" placeholder="10.3673"
                           t-att-value="state.draft.lat"
                           t-on-input="(ev) => this.setCoord('lat', ev.target.value, ev.target)"/></label>
                <label class="dv-field"><span>Longitude</span>
                    <input type="text" placeholder="77.9803"
                           t-att-value="state.draft.lng"
                           t-on-input="(ev) => this.setCoord('lng', ev.target.value, ev.target)"/></label>
            </div>
            <div class="dv-locate">
                <button type="button" class="mart-btn"
                        t-att-disabled="state.locate and state.locate.state === 'running'"
                        t-on-click="() => this.locate()">
                    <Icon n="'search'" size="14"/> Find from the address
                </button>
                <button type="button" class="mart-btn" t-if="!state.picking"
                        t-on-click="() => { state.picking = true; }">
                    <Icon n="'pin'" size="14"/> Pick on map
                </button>
            </div>
            <p t-if="state.locate and state.locate.message" role="status"
               t-attf-class="dv-find-msg dv-find-{{ state.locate.state }}">
                <span t-if="state.locate.state === 'running'" class="dv-spin"/>
                <t t-esc="state.locate.message"/>
            </p>
            <div t-if="state.address" class="dv-address">
                <div class="dv-form">
                    <label class="dv-field dv-span2"><span>Street</span>
                        <input type="text" placeholder="12 Fort Road"
                               t-att-value="state.address.street"
                               t-on-input="(ev) => { state.address.street = ev.target.value; }"/></label>
                    <label class="dv-field"><span>Town</span>
                        <input type="text" placeholder="Dubai"
                               t-att-value="state.address.city"
                               t-on-input="(ev) => { state.address.city = ev.target.value; }"/></label>
                    <label class="dv-field"><span>Pincode</span>
                        <input type="text" placeholder="Optional"
                               t-att-value="state.address.zip"
                               t-on-input="(ev) => { state.address.zip = ev.target.value; }"/></label>
                </div>
                <div class="dv-locate">
                    <button type="button" class="mart-btn mart-btn-primary"
                            t-att-disabled="state.locate and state.locate.state === 'running'"
                            t-on-click="() => this.locate(state.address)">
                        Save address and find
                    </button>
                    <button type="button" class="mart-btn"
                            t-on-click="() => { state.address = null; state.locate = null; }">Cancel</button>
                </div>
                <p class="mart-hint">
                    Saved on <t t-esc="state.locate and state.locate.name"/> in
                    Contacts<t t-if="state.locate and state.locate.country">
                    (<t t-esc="state.locate.country"/>)</t>, so invoices and the
                    next look have it too.
                </p>
            </div>
            <BranchPinMap t-if="state.picking"
                          lat="state.draft.lat" lng="state.draft.lng"
                          onPick="(lat, lng) => this.picked(lat, lng)"
                          onCancel="() => { state.picking = false; }"/>
            <p class="mart-hint">
                Find from the address looks up the branch's address in Odoo. Pick
                on map lets you drag the map until the pin is on the branch. Or
                paste the two numbers Google Maps copies (right-click the branch)
                into either box and both fill in.
            </p>

            <h3>Pincodes around this branch</h3>
            <div class="dv-find">
                <button type="button" class="mart-btn"
                        t-att-disabled="state.find and (state.find.state === 'starting' or state.find.state === 'running')"
                        t-on-click="() => this.findPincodes()">
                    <t t-if="state.find and state.find.state === 'failed'">Try again</t>
                    <t t-else="">Find pincodes around this branch</t>
                </button>
                <p t-if="state.find and state.find.message" role="status"
                   t-attf-class="dv-find-msg dv-find-{{ state.find.state }}">
                    <span t-if="state.find.state === 'starting' or state.find.state === 'running'" class="dv-spin"/>
                    <t t-esc="state.find.message"/>
                </p>
                <div t-if="state.find and state.find.state === 'running' and state.find.total"
                     class="dv-find-bar" aria-hidden="true">
                    <i t-attf-style="width: {{ findPercent }}%"/>
                </div>
            </div>
            <p class="mart-hint">
                Saves what you typed above first, then looks around the location
                as far as the farthest km. You can still type pincodes yourself in
                Service areas. Postcodes from GeoNames and © OpenStreetMap
                contributors.
            </p>
        </div>

        <t t-set-slot="footer">
            <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy"
                    t-on-click="() => this.save()">Save</button>
            <button class="mart-btn" t-on-click="() => this.props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

<!-- ============================ branch pin map ============================= -->
<t t-name="mart369_cart.BranchPinMap">
    <div class="dv-pick">
        <p class="dv-pick-help">
            <b>Put the pin on the branch.</b> Drag the map; the pin stays in the middle.
            <t t-if="state.note"> <t t-esc="state.note"/></t>
        </p>
        <div class="dv-pick-map">
            <div t-ref="canvas" class="dv-pick-canvas"/>
            <span t-if="state.status === 'ready'" class="dv-pick-pin" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </span>
            <span t-if="state.status === 'loading'" class="dv-pick-msg">Loading the map…</span>
            <span t-if="state.status === 'failed'" class="dv-pick-msg">
                The map couldn't load here. Use Find from the address, or paste the
                location from Google Maps.
            </span>
        </div>
        <div class="dv-pick-actions">
            <button type="button" class="mart-btn mart-btn-sm"
                    t-att-disabled="state.status !== 'ready' or state.locating"
                    t-on-click="() => this.here()">
                <t t-if="state.locating">Finding you…</t>
                <t t-else="">Where I am now</t>
            </button>
            <span class="dv-pick-gap"/>
            <button type="button" class="mart-btn mart-btn-sm"
                    t-on-click="() => this.props.onCancel()">Cancel</button>
            <button type="button" class="mart-btn mart-btn-sm mart-btn-primary"
                    t-att-disabled="state.status !== 'ready'"
                    t-on-click="() => this.confirm()">Use this spot</button>
        </div>
    </div>
</t>

<!-- ============================== area dialog ============================== -->
<t t-name="mart369_cart.AreaDialog">
    <Dialog contentClass="'dv-dialog'" size="state.draft.id ? 'md' : 'lg'"
            title="state.draft.id ? 'Edit service area' : 'Add service areas'">
        <div class="dv-dialog-body">
            <p t-if="state.error" class="dv-error" role="alert" t-esc="state.error"/>

            <t t-if="!state.draft.id">
                <h3>Pick pincodes</h3>
                <p t-if="!state.known" class="mart-hint">Finding the pincodes your customers use…</p>
                <t t-else="">
                    <t t-foreach="state.known.groups" t-as="group" t-key="group.branch">
                    <div t-if="group.pincodes.length" class="dv-known">
                        <div class="dv-known-head">
                            <b>Near <t t-esc="group.branch"/></b>
                            <small><t t-esc="group.pincodes.length"/> pincodes within <t t-esc="group.reach"/> km · <t t-esc="tickedIn(group.pincodes)"/> ticked</small>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.tickAll(group.pincodes)">
                                <t t-if="allTicked(group.pincodes)">Untick all</t><t t-else="">Tick all</t>
                            </button>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.toggleOpen('b:' + group.branch)">
                                <t t-if="state.open['b:' + group.branch]">Hide list</t><t t-else="">Show list</t>
                            </button>
                        </div>
                        <t t-if="state.open['b:' + group.branch]">
                            <label t-foreach="group.pincodes" t-as="row" t-key="row.pincode" class="dv-known-row">
                                <input type="checkbox" t-att-checked="state.ticked[row.pincode]"
                                       t-on-change="() => this.tick(row.pincode)"/>
                                <b t-esc="row.pincode"/>
                                <span t-esc="row.place or '—'"/>
                                <span t-esc="kmText(row.km)"/>
                                <span t-if="row.addresses"><t t-esc="row.addresses"/> <t t-if="row.addresses === 1">address</t><t t-else="">addresses</t></span>
                                <span t-else="">from the map</span>
                            </label>
                        </t>
                    </div>
                    </t>
                    <div t-if="state.known.far and state.known.far.length" class="dv-known">
                        <div class="dv-known-head">
                            <b>Far from every branch</b>
                            <small><t t-esc="state.known.far.length"/> pincodes past every branch's reach · <t t-esc="tickedIn(state.known.far)"/> ticked</small>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.tickAll(state.known.far)">
                                <t t-if="allTicked(state.known.far)">Untick all</t><t t-else="">Tick all</t>
                            </button>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.toggleOpen('far')">
                                <t t-if="state.open['far']">Hide list</t><t t-else="">Show list</t>
                            </button>
                        </div>
                        <t t-if="state.open['far']">
                            <label t-foreach="state.known.far" t-as="row" t-key="row.pincode" class="dv-known-row">
                                <input type="checkbox" t-att-checked="state.ticked[row.pincode]"
                                       t-on-change="() => this.tick(row.pincode)"/>
                                <b t-esc="row.pincode"/>
                                <span t-esc="row.place or '—'"/>
                                <span t-esc="kmText(row.km)"/>
                                <span t-if="row.addresses"><t t-esc="row.addresses"/> <t t-if="row.addresses === 1">address</t><t t-else="">addresses</t></span>
                                <span t-else="">from the map</span>
                                <em>nearest branch: <t t-esc="row.branch"/></em>
                            </label>
                        </t>
                    </div>
                    <div t-if="state.known.noPin.length" class="dv-known">
                        <div class="dv-known-head">
                            <b>No map pin yet</b>
                            <small><t t-esc="state.known.noPin.length"/> pincodes we can't place on the map · <t t-esc="tickedIn(state.known.noPin)"/> ticked</small>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.tickAll(state.known.noPin)">
                                <t t-if="allTicked(state.known.noPin)">Untick all</t><t t-else="">Tick all</t>
                            </button>
                            <button type="button" class="mart-btn mart-btn-sm" t-on-click="() => this.toggleOpen('nopin')">
                                <t t-if="state.open['nopin']">Hide list</t><t t-else="">Show list</t>
                            </button>
                        </div>
                        <t t-if="state.open['nopin']">
                            <label t-foreach="state.known.noPin" t-as="row" t-key="row.pincode" class="dv-known-row">
                                <input type="checkbox" t-att-checked="state.ticked[row.pincode]"
                                       t-on-change="() => this.tick(row.pincode)"/>
                                <b t-esc="row.pincode"/>
                                <span t-esc="row.place or '—'"/>
                                <span t-esc="kmText(row.km)"/>
                                <span t-if="row.addresses"><t t-esc="row.addresses"/> <t t-if="row.addresses === 1">address</t><t t-else="">addresses</t></span>
                                <span t-else="">from the map</span>
                            </label>
                        </t>
                    </div>
                    <p t-if="!state.known.groups.length and !state.known.noPin.length" class="mart-hint">
                        No new pincodes from your customers yet. Type them below.
                    </p>
                    <p t-if="state.known.credit" class="mart-hint" t-esc="state.known.credit"/>
                    <p t-if="state.known.covered.length" class="mart-hint">
                        Already added: <t t-esc="state.known.covered.join(', ')"/>
                    </p>
                </t>
            </t>

            <h3><t t-if="state.draft.id">Where</t><t t-else="">Or type pincodes</t></h3>
            <div class="dv-form">
                <label t-if="state.draft.id" class="dv-field"><span>Pincode</span>
                    <input type="text" placeholder="624001" t-att-value="state.draft.pincode"
                           t-on-input="(ev) => this.set('pincode', ev.target.value)"/></label>
                <label t-else="" class="dv-field dv-span2"><span>Pincodes not in the list</span>
                    <textarea rows="2" placeholder="624001, 624002, 624003"
                              t-att-value="state.draft.pincode"
                              t-on-input="(ev) => this.set('pincode', ev.target.value)"/></label>
                <label class="dv-field"><span>Area name (optional, only you see it)</span>
                    <input type="text" t-att-placeholder="state.draft.id ? 'Dindigul' : 'Empty: each pincode uses its own place name'" t-att-value="state.draft.name"
                           t-on-input="(ev) => this.set('name', ev.target.value)"/></label>
            </div>
            <p class="mart-hint">
                <t t-if="!state.draft.id">Commas between them, or one per line. </t>
                A short number covers every pincode that starts with it: 624
                covers 624001, 624002 and the rest.
            </p>

            <h3>Delivery</h3>
            <div class="dv-rows">
                <div class="dv-row">
                    <span><b>We deliver here</b><small>Quick or Express is worked out from how far the customer is from the branch</small></span>
                    <Switch on="state.draft.deliver"
                            label="'We deliver here'"
                            onChange="() => this.set('deliver', !state.draft.deliver)"/>
                </div>
            </div>

            <div class="dv-form">
                <label class="dv-field"><span>Customers are told it comes in</span>
                    <select t-on-change="(ev) => this.set('eta', ev.target.value)">
                        <option t-foreach="promises" t-as="p" t-key="p" t-att-value="p"
                                t-att-selected="p === state.draft.eta" t-esc="p"/>
                    </select></label>
            </div>
            <p class="mart-hint">
                Switched off, customers there are told we don't deliver yet.
            </p>
        </div>

        <t t-set-slot="footer">
            <button class="mart-btn mart-btn-primary" t-att-disabled="state.busy"
                    t-on-click="() => this.save()">
                <t t-if="state.draft.id">Save changes</t>
                <t t-elif="tickedCount">Add <t t-esc="tickedCount"/> ticked<t t-if="tickedSplit"> (<t t-esc="tickedSplit"/>)</t></t>
                <t t-else="">Add</t>
            </button>
            <button class="mart-btn" t-on-click="() => this.props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

</templates>
